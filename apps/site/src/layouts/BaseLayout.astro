---
import '../styles/tokens.css';
import SiteNav from '../components/SiteNav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CourseExplorer from '../components/CourseExplorer.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import type { ShellContext, ShellMode, ShellPageLink } from '../lib/curriculum-shell';
import { getAutoShellState } from '../lib/auto-shell';

type NavSection = 'ai-prompt' | 'ks3' | 'year7' | 'year8' | 'year9' | 'igcse' | 'ib';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  activeSection?: NavSection;
  breadcrumbs?: BreadcrumbItem[];
  bodyClass?: string;
  mainClass?: string;
  extraStyles?: string[];
  shellPath?: string;
  courseShell?: ShellContext;
  layoutMode?: ShellMode;
  prevLink?: ShellPageLink;
  nextLink?: ShellPageLink;
}

const {
  title = 'SGS Education',
  description = 'SGS Education Hub for KS3, IGCSE, and IB students.',
  activeSection,
  breadcrumbs = [],
  bodyClass = '',
  mainClass = '',
  extraStyles = [],
  shellPath,
  courseShell,
  layoutMode,
  prevLink,
  nextLink
} = Astro.props;

const inferredActiveSection: NavSection | undefined = Astro.url.pathname.startsWith('/ib')
  ? 'ib'
  : Astro.url.pathname.startsWith('/ai-prompt-generator')
  ? 'ai-prompt'
  : Astro.url.pathname.startsWith('/ks3/year7')
  ? 'year7'
  : Astro.url.pathname.startsWith('/ks3/year8')
  ? 'year8'
  : Astro.url.pathname.startsWith('/ks3/year9')
  ? 'year9'
  : Astro.url.pathname.startsWith('/igcse')
  ? 'igcse'
  : Astro.url.pathname.startsWith('/ks3')
  ? 'ks3'
  : undefined;

const resolvedActiveSection = activeSection || inferredActiveSection;
const resolvedShellPath = shellPath || Astro.url.pathname;
const autoShellState = await getAutoShellState(resolvedShellPath);
const resolvedCourseShell = courseShell ?? autoShellState.courseShell;
const resolvedLayoutMode = layoutMode ?? autoShellState.layoutMode ?? 'worksheet';
const resolvedPrevLink = prevLink ?? autoShellState.prevLink;
const resolvedNextLink = nextLink ?? autoShellState.nextLink;
const resolvedBreadcrumbs = breadcrumbs.length > 0 ? breadcrumbs : autoShellState.breadcrumbs ?? [];
const sidebarIsCollapsible = resolvedCourseShell?.collapsible !== false;
const currentYear = new Date().getFullYear();
const bodyClasses = ['site-body', bodyClass].filter(Boolean);
const mainClasses = [
  'page-shell',
  `page-shell--${resolvedLayoutMode}`,
  resolvedCourseShell ? 'page-shell--with-sidebar' : '',
  mainClass
].filter(Boolean);
const sidebarToggleId = resolvedCourseShell ? 'course-explorer-toggle' : undefined;

const normalizeStyleHref = (stylePath: string): string => {
  if (stylePath.startsWith('http://') || stylePath.startsWith('https://') || stylePath.startsWith('//')) {
    return stylePath;
  }

  return stylePath.startsWith('/') ? stylePath : `/${stylePath}`;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#003165" />
    <link rel="icon" type="image/png" href="/images/Logo.png" />
    <link rel="apple-touch-icon" href="/images/Logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    {extraStyles.map((stylePath) => (
      <link rel="stylesheet" href={normalizeStyleHref(stylePath)} />
    ))}
    <title>{title}</title>
  </head>
  <body class:list={bodyClasses}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteNav activeSection={resolvedActiveSection} />
    <main id="main-content" class:list={mainClasses}>
      {resolvedCourseShell && sidebarToggleId && (
        <input id={sidebarToggleId} class="course-shell__toggle" type="checkbox" hidden />
      )}

      {resolvedCourseShell && (
        <aside class="course-shell__sidebar" id="course-shell-sidebar">
          <CourseExplorer context={resolvedCourseShell} currentPath={resolvedShellPath} />
          {sidebarIsCollapsible && (
            <button type="button" class="sidebar-collapse-btn" aria-label="Collapse sidebar" id="sidebar-collapse-btn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              <span>Collapse</span>
            </button>
          )}
        </aside>
      )}

      <div class="page-shell__content">
        {resolvedCourseShell && sidebarIsCollapsible && (
          <button type="button" class="sidebar-expand-btn" aria-label="Expand sidebar" id="sidebar-expand-btn">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        )}
        {resolvedCourseShell && sidebarToggleId && (
          <div class="page-shell__mobilebar">
            <label for={sidebarToggleId} class="page-shell__mobiletoggle">
              Browse Course
            </label>
          </div>
        )}

        <Breadcrumbs items={resolvedBreadcrumbs} />
        <slot />
        <PrevNextNav prevLink={resolvedPrevLink} nextLink={resolvedNextLink} />
      </div>
    </main>
    <footer class="site-footer">
      <p>&copy; {currentYear} SGS Education &middot; SG Stewart. All rights reserved.</p>
    </footer>
    <script is:inline>
      (() => {
        const collapseBtn = document.getElementById('sidebar-collapse-btn');
        const expandBtn = document.getElementById('sidebar-expand-btn');
        const shell = document.querySelector('.page-shell--with-sidebar');
        if (!collapseBtn || !expandBtn || !shell) return;

        const STORAGE_KEY = 'sgs-sidebar-collapsed';
        const isCollapsed = localStorage.getItem(STORAGE_KEY) === '1';
        if (isCollapsed) shell.classList.add('page-shell--sidebar-collapsed');

        collapseBtn.addEventListener('click', () => {
          shell.classList.add('page-shell--sidebar-collapsed');
          localStorage.setItem(STORAGE_KEY, '1');
        });
        expandBtn.addEventListener('click', () => {
          shell.classList.remove('page-shell--sidebar-collapsed');
          localStorage.setItem(STORAGE_KEY, '0');
        });
      })();
    </script>
  </body>
</html>
