---
import BaseLayout from './BaseLayout.astro';
import type { ShellContext, ShellPageLink } from '../lib/curriculum-shell';

type NavSection = 'ai-prompt' | 'ks3' | 'year7' | 'year8' | 'year9' | 'igcse' | 'ib';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  activeSection?: NavSection;
  breadcrumbs?: BreadcrumbItem[];
  extraStyles?: string[];
  kicker: string;
  heading: string;
  subtitle?: string;
  variant?: string;
  shellPath?: string;
  courseShell?: ShellContext;
  prevLink?: ShellPageLink;
  nextLink?: ShellPageLink;
}

const {
  title,
  description = title,
  activeSection,
  breadcrumbs = [],
  extraStyles = [],
  kicker,
  heading,
  subtitle,
  variant = 'textbook',
  shellPath,
  courseShell,
  prevLink,
  nextLink
} = Astro.props as Props;

const mergedStyles = Array.from(new Set(['css/reader.css', ...extraStyles]));
---

<BaseLayout
  title={title}
  description={description}
  activeSection={activeSection}
  breadcrumbs={breadcrumbs}
  bodyClass="reader-body"
  mainClass="reader-main"
  layoutMode="reading"
  extraStyles={mergedStyles}
  shellPath={shellPath}
  courseShell={courseShell}
  prevLink={prevLink}
  nextLink={nextLink}
>
  <div class:list={['reader-shell', `reader-shell--${variant}`]} data-sgs-reader>
    <div class="sr-only" aria-live="polite" data-reader-announcer></div>

    <section class="reader-stage">
      <article class="reader-article">
        <div class="reader-dochead">
          <p class="reader-kicker">{kicker}</p>
          <h1 class="reader-title">{heading}</h1>
          {subtitle && <p class="reader-subtitle">{subtitle}</p>}
        </div>
        <div class="reader-content">
          <div class="reader-prose" data-reader-content>
            <slot />
          </div>
        </div>
      </article>
    </section>
  </div>

  <div class="reader-modal-overlay" data-reader-modal-overlay aria-hidden="true"></div>

  <div
    class="reader-modal reader-modal--definition"
    id="reader-def-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="reader-def-modal-title"
    aria-hidden="true"
  >
    <div class="reader-modal__header">
      <h2 class="reader-modal__title" id="reader-def-modal-title" data-reader-def-title>Definition</h2>
      <button class="reader-modal__close" type="button" data-reader-close-modal aria-label="Close">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <div class="reader-modal__body">
      <p class="reader-empty" data-reader-def-body></p>
    </div>
  </div>

  <script is:inline src="/js/reader.js"></script>
  <slot name="scripts" />
</BaseLayout>
