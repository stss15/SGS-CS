---
import HeroPanel from '../components/HeroPanel.astro';
import BaseLayout from './BaseLayout.astro';

type NavSection = 'ai-prompt' | 'ks3' | 'year7' | 'year8' | 'year9' | 'igcse' | 'ib';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  activeSection?: NavSection;
  breadcrumbs?: BreadcrumbItem[];
  extraStyles?: string[];
  mainClass?: string;
  eyebrow?: string;
  heroTitle: string;
  heroSubtitle?: string;
  pills?: string[];
  heroVariant?: 'feature' | 'compact';
}

const {
  title,
  description = title,
  activeSection,
  breadcrumbs = [],
  extraStyles = [],
  mainClass = '',
  eyebrow,
  heroTitle,
  heroSubtitle,
  pills = [],
  heroVariant = 'compact'
} = Astro.props as Props;

const shellMainClass = ['curriculum-shell', mainClass].filter(Boolean).join(' ');
---

<BaseLayout
  title={title}
  description={description}
  activeSection={activeSection}
  breadcrumbs={breadcrumbs}
  mainClass={shellMainClass}
  extraStyles={extraStyles}
>
  <HeroPanel eyebrow={eyebrow} title={heroTitle} subtitle={heroSubtitle} pills={pills} variant={heroVariant}>
    <slot />
  </HeroPanel>
</BaseLayout>
