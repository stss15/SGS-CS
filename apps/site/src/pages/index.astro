---
import CurriculumShell from '../layouts/CurriculumShell.astro';
import FeatureLinkGrid from '../components/FeatureLinkGrid.astro';
import { getHomeFeatureCards } from '@sgs/content-schema';

const featureCards = await getHomeFeatureCards();
---

<CurriculumShell
  title="SGS Education"
  description="SGS Education Hub for KS3, IGCSE, and IB students."
  heroTitle="Welcome to SGS Education"
  heroSubtitle="Explore, learn, and master Computer Science through KS3, IGCSE, and IB pathways."
  heroVariant="feature"
>
  <FeatureLinkGrid cards={featureCards} />
</CurriculumShell>
