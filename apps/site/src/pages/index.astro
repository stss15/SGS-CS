---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureLinkGrid from '../components/FeatureLinkGrid.astro';
import HeroPanel from '../components/HeroPanel.astro';
import { getHomePageData } from '@sgs/content-schema';

const homePage = await getHomePageData();
---

<BaseLayout title="SGS Education" description="SGS Education Hub for KS3, IGCSE, and IB students.">
  <HeroPanel
    title="Welcome to SGS Education"
    subtitle="Explore, learn, and master Computer Science through KS3, IGCSE, and IB pathways."
  >
    <FeatureLinkGrid cards={homePage.cards} />
    {
      homePage.footerLink && (
        <div class="home-footer-link">
          <a href={homePage.footerLink.href} class="home-footer-pill">
            {homePage.footerLink.label}
          </a>
        </div>
      )
    }
  </HeroPanel>
</BaseLayout>
