---
import CurriculumShell from '../layouts/CurriculumShell.astro';

const priorityCards = [
  {
    href: '/igcse/index.html',
    title: 'IGCSE Computer Science',
    desc: 'Master the principles of computational thinking and programming with the Cambridge curriculum.',
    icon: 'fa-solid fa-code',
    tone: 'igcse'
  },
  {
    href: '/ib-2027/index.html',
    title: 'IB Computer Science',
    desc: 'Advance into systems architecture, algorithms, and data structures at Higher or Standard Level for the IB Diploma.',
    icon: 'fa-solid fa-microchip',
    tone: 'ib'
  }
];

const ks3Cards = [
  {
    href: '/ks3/year7/index.html',
    title: 'Year 7',
    meta: 'Lower Secondary Transition',
    icon: 'fa-solid fa-cube',
    number: '07'
  },
  {
    href: '/ks3/year8/index.html',
    title: 'Year 8',
    meta: 'Core Competency Development',
    icon: 'fa-solid fa-diagram-project',
    number: '08'
  },
  {
    href: '/ks3/year9/index.html',
    title: 'Year 9',
    meta: 'IGCSE Preparation Path',
    icon: 'fa-solid fa-flag',
    number: '09'
  }
];
---

<CurriculumShell
  title="SGS Education"
  description="SGS Education Hub for KS3, IGCSE, and IB students."
  mainClass="home-shell"
  heroTitle="Welcome to SGS Education"
  heroSubtitle="Explore, learn, and master Computer Science through KS3, IGCSE, and IB pathways."
  heroVariant="feature"
>
  <section class="home-curriculum">
    <section class="home-panel home-panel--years" aria-labelledby="home-ks3-title">
      <div class="home-panel__heading">
        <p class="home-panel__kicker">Foundation Years</p>
        <h2 id="home-ks3-title">Key Stage 3</h2>
      </div>

      <div class="home-panel__stack">
        {ks3Cards.map((card) => (
          <a href={card.href} class="home-track home-track--year">
            <span class="home-track__number" aria-hidden="true">{card.number}</span>
            <div class="home-track__copy home-track__copy--year">
              <h3>{card.title}</h3>
              <p class="home-track__meta">
                <i class={card.icon} aria-hidden="true"></i>
                <span>{card.meta}</span>
              </p>
            </div>
            <span class="home-track__cta home-track__cta--solid">
              Explore curriculum
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-panel home-panel--courses" aria-labelledby="home-cs-title">
      <div class="home-panel__heading">
        <p class="home-panel__kicker">Advanced Studies</p>
        <h2 id="home-cs-title">Computer Science</h2>
      </div>

      <div class="home-panel__stack home-panel__stack--courses">
      {priorityCards.map((card) => (
        <a href={card.href} class={`home-track home-track--course home-track--${card.tone}`}>
          <div class="home-track__course-top">
            <div class="home-track__icon home-track__icon--course" aria-hidden="true">
              <i class={card.icon} aria-hidden="true"></i>
            </div>
            <h3>{card.title}</h3>
          </div>
          <p class="home-track__desc">{card.desc}</p>
          <span class="home-track__cta home-track__cta--link">
            Explore curriculum
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </span>
        </a>
      ))}
      </div>
    </section>
  </section>
</CurriculumShell>
