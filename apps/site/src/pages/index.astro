---
import CurriculumShell from '../layouts/CurriculumShell.astro';

const priorityCards = [
  {
    href: '/igcse/index.html',
    title: 'IGCSE Computer Science',
    desc: 'Dive deeper into algorithms, data representation, and hardware. Prepare for your exams with comprehensive resources.',
    icon: 'fa-solid fa-microchip'
  },
  {
    href: '/ib-2027/index.html',
    title: 'IB Computer Science',
    desc: 'New unit-based learning for Standard Level and Higher Level students. First assessment 2027.',
    icon: 'fa-solid fa-graduation-cap'
  }
];

const ks3Cards = [
  {
    href: '/ks3/year7/index.html',
    title: 'Year 7',
    desc: 'Foundations of computing, logic, and digital confidence.',
    icon: 'fa-solid fa-rocket'
  },
  {
    href: '/ks3/year8/index.html',
    title: 'Year 8',
    desc: 'Developing skills through challenge routes and assessments.',
    icon: 'fa-solid fa-satellite-dish'
  },
  {
    href: '/ks3/year9/index.html',
    title: 'Year 9',
    desc: 'Advanced concepts, mission-style tasks, and deeper problem solving.',
    icon: 'fa-solid fa-compass-drafting'
  }
];
---

<CurriculumShell
  title="SGS Education"
  description="SGS Education Hub for KS3, IGCSE, and IB students."
  mainClass="home-shell"
  heroTitle="Welcome to SGS Education"
  heroSubtitle="Explore, learn, and master Computer Science through KS3, IGCSE, and IB pathways."
  heroVariant="feature"
>
  <section class="home-curriculum">
    <div class="home-curriculum__priority">
      {priorityCards.map((card) => (
        <a href={card.href} class="feature-link feature-link--priority">
          <div class="feature-link__icon" aria-hidden="true">
            <i class={card.icon} aria-hidden="true"></i>
          </div>
          <h2 class="feature-link__title">{card.title}</h2>
          <p class="feature-link__desc">{card.desc}</p>
        </a>
      ))}
    </div>

    <section class="home-curriculum__ks3" aria-labelledby="home-ks3-title">
      <div class="home-curriculum__heading">
        <p class="home-curriculum__kicker">Key Stage 3</p>
        <h2 id="home-ks3-title">Key Stage 3 Computer Science</h2>
      </div>

      <div class="home-curriculum__years">
        {ks3Cards.map((card) => (
          <a href={card.href} class="feature-link feature-link--year">
            <div class="feature-link__icon" aria-hidden="true">
              <i class={card.icon} aria-hidden="true"></i>
            </div>
            <h3 class="feature-link__title">{card.title}</h3>
            <p class="feature-link__desc">{card.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </section>
</CurriculumShell>
