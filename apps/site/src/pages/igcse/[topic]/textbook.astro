---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getIgcseListing } from '@sgs/content-schema';

interface IgcseTopicTextbookPathProps {
  topic: string;
  topicNumber: number;
  topicName: string;
}

export async function getStaticPaths() {
  const topicSegmentRe = /^topic(\d+)$/i;
  const listing = await getIgcseListing();
  const topicItems = (listing.sections || []).flatMap((section) => section.items || []);

  return topicItems
    .map((item) => {
      const href = String(item.href || '');
      const match = href.match(/\/igcse\/(topic\d+)\/index\.html$/i);
      if (!match) return null;

      const topic = match[1].toLowerCase();
      const numMatch = topic.match(topicSegmentRe);
      if (!numMatch) return null;

      return {
        params: {
          topic
        },
        props: {
          topic,
          topicNumber: Number(numMatch[1]),
          topicName: String(item.name || `Topic ${numMatch[1]}`)
        }
      };
    })
    .filter((entry): entry is NonNullable<typeof entry> => entry !== null);
}

const { topic, topicNumber, topicName } = Astro.props as IgcseTopicTextbookPathProps;
const textbookEntry = (await getCollection('igcse-textbooks', ({ data }) => data.topicNumber === topicNumber))[0];
const textbookRendered = textbookEntry ? await render(textbookEntry) : null;
const TextbookContent = textbookRendered?.Content;
---

<BaseLayout
  title={`IGCSE Topic ${topicNumber}: ${topicName} Textbook Reader`}
  description={`IGCSE Computer Science Topic ${topicNumber} (${topicName}) textbook reader.`}
  extraStyles={['css/reader.css']}
>
  <script is:inline>
    document.body.classList.add('reader-body');
    const mainElement = document.getElementById('main-content');
    if (mainElement) {
      mainElement.classList.add('reader-main');
    }
  </script>

  <button
    type="button"
    class="reader-edge-tab reader-edge-tab--left"
    data-reader-action="toc-toggle"
    aria-controls="reader-toc"
    aria-label="Open contents"
    title="Contents"
  >
    <i class="fa-solid fa-list" aria-hidden="true"></i>
    <span>Contents</span>
  </button>

  <div
    class="reader-shell reader-shell--textbook"
    data-sgs-reader
    data-reader-default-paged="true"
    data-reader-storage-key="sgs-reader-igcse-textbook-settings-v1"
  >
    <div class="sr-only" aria-live="polite" data-reader-announcer></div>
    <div class="reader-drawer-overlay" data-reader-drawer-overlay aria-hidden="true"></div>

    <aside class="reader-rail reader-rail--toc" id="reader-toc" aria-label="Table of contents">
      <div class="reader-rail__header">
        <p class="reader-rail__title">Contents</p>
        <button
          type="button"
          class="reader-icon-btn reader-icon-btn--sm reader-rail__mobile-close"
          data-reader-action="toc-toggle"
          aria-pressed="true"
          aria-expanded="true"
          aria-controls="reader-toc"
          aria-label="Close table of contents"
        >
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
      <div class="reader-rail__body">
        <div class="reader-search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input
            type="search"
            placeholder="Search contents"
            aria-label="Search table of contents"
            data-reader-toc-search
          />
        </div>
        <nav class="reader-toc" aria-label="On this page" data-reader-toc>
          <p style="margin:0;color:var(--reader-muted);">Loading contents...</p>
        </nav>
      </div>
      <div class="reader-rail__footer">
        <button
          type="button"
          class="reader-settings-launch"
          data-reader-action="settings-open"
          aria-controls="reader-settings-modal"
          aria-expanded="false"
        >
          <i class="fa-solid fa-sliders" aria-hidden="true"></i>
          <span>Settings</span>
        </button>
      </div>
    </aside>

    <section class="reader-stage">
      <div class="reader-paper">
        <div class="reader-dochead">
          <p class="reader-kicker">IGCSE 0478 · Topic {topicNumber}</p>
          <h1 class="reader-title">Topic {topicNumber}: {topicName}</h1>
          <p class="reader-subtitle">Textbook Reader</p>
        </div>

        <article class="reader-article">
          <div class="reader-content">
            <div class="reader-prose" data-reader-content>
              {
                TextbookContent ? (
                  <>
                    <TextbookContent />
                  </>
                ) : (
                  <>
                    <p class="reader-callout">
                      <strong>This textbook space is ready.</strong> Full chapter content for this topic will be published here.
                    </p>

                    <h2>Mapped Subtopics</h2>
                    <ul>
                      {topicName ? <li>{topicName}</li> : <li>Topic subtopics will be listed here.</li>}
                    </ul>
                  </>
                )
              }
            </div>
          </div>

          <nav class="reader-pagination" aria-label="Pagination">
            <button type="button" class="reader-pagination__btn" data-reader-action="page-prev">
              <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              Prev
            </button>

            <div class="reader-pagination__meta" data-reader-pagination-meta></div>

            <button type="button" class="reader-pagination__btn" data-reader-action="page-next">
              Next
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </button>
          </nav>
        </article>
      </div>
    </section>
  </div>

  <div class="reader-modal-overlay" data-reader-modal-overlay aria-hidden="true"></div>

  <div
    class="reader-modal reader-modal--settings"
    id="reader-settings-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="reader-settings-modal-title"
    aria-hidden="true"
  >
    <div class="reader-modal__header">
      <h2 class="reader-modal__title" id="reader-settings-modal-title">Reader Settings</h2>
      <button class="reader-modal__close" type="button" data-reader-close-modal aria-label="Close">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <div class="reader-modal__body">
      <form class="reader-form reader-tools" aria-label="Reading options">
        <section class="reader-support-section">
          <h3>Display</h3>

          <label class="reader-toggle-label">
            <span>Paged reading</span>
            <span class="reader-toggle">
              <input type="checkbox" data-reader-setting="paged" />
              <span class="reader-toggle__track" aria-hidden="true"></span>
            </span>
          </label>

          <label class="reader-toggle-label">
            <span>Enhanced readability</span>
            <span class="reader-toggle">
              <input type="checkbox" data-reader-setting="readability" />
              <span class="reader-toggle__track" aria-hidden="true"></span>
            </span>
          </label>

          <p class="reader-help">Paged reading shows one section at a time. Settings save automatically.</p>
        </section>

        <section class="reader-support-section">
          <h3>Text</h3>

          <div class="reader-field">
            <label for="reader-scale">Text size</label>
            <div class="reader-range-row">
              <span class="reader-range-icon reader-range-icon--sm">A</span>
              <input id="reader-scale" type="range" min="100" max="150" step="2" data-reader-setting="scale" />
              <span class="reader-range-icon reader-range-icon--lg">A</span>
              <span class="reader-range-badge" data-reader-scale-value>106%</span>
            </div>
          </div>

          <div class="reader-field">
            <label for="reader-font">Font</label>
            <select id="reader-font" data-reader-setting="font">
              <option value="source">Source Sans 3 (Default)</option>
              <option value="lexend">Lexend (Readable)</option>
              <option value="literata">Literata (Serif)</option>
            </select>
          </div>
        </section>

        <section class="reader-support-section">
          <h3>Appearance</h3>

          <div class="reader-field">
            <label for="reader-theme">Theme</label>
            <select id="reader-theme" data-reader-setting="theme">
              <option value="default">Default</option>
              <option value="paper">Paper</option>
              <option value="cb">Colour-blind friendly</option>
              <option value="contrast">High contrast</option>
            </select>
            <small>Colour-blind friendly avoids red/green signalling.</small>
          </div>
        </section>

        <div class="reader-form__actions">
          <button class="reader-btn" type="button" data-reader-setting="reset">Reset</button>
          <button class="reader-btn primary" type="button" data-reader-action="settings-apply-close">Apply & Close</button>
        </div>
      </form>
    </div>
  </div>

  <div
    class="reader-modal reader-modal--definition"
    id="reader-def-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="reader-def-modal-title"
    aria-hidden="true"
  >
    <div class="reader-modal__header">
      <h2 class="reader-modal__title" id="reader-def-modal-title" data-reader-def-title>Definition</h2>
      <button class="reader-modal__close" type="button" data-reader-close-modal aria-label="Close">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <div class="reader-modal__body">
      <p style="margin:0;" data-reader-def-body></p>
    </div>
  </div>

  <script is:inline src="/js/reader.js"></script>
  <script is:inline src="/js/igcse-pseudocode-highlighter.js"></script>
  {topicNumber === 1 && <script is:inline src="/js/igcse-topic1-interactive.js"></script>}
</BaseLayout>
