---
import { getCollection } from 'astro:content';
import ReaderShell from '../../../../layouts/ReaderShell.astro';
import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkGfm from 'remark-gfm';
import remarkRehype from 'remark-rehype';
import rehypeRaw from 'rehype-raw';
import rehypeStringify from 'rehype-stringify';

interface IgcseTopicTextbookChapterPathProps {
  topic: string;
  topicNumber: number;
  topicName: string;
  chapterCode: string;
  chapterTitle: string;
  chapterSlug: string;
}

interface MarkdownSection {
  heading: string;
  markdown: string;
}

const KEY_TERMS_HEADING = 'Key Terms and Definitions';
async function renderMarkdownToHtml(markdown: string) {
  const rendered = await unified()
    .use(remarkParse)
    .use(remarkGfm)
    .use(remarkRehype, { allowDangerousHtml: true })
    .use(rehypeRaw)
    .use(rehypeStringify, { allowDangerousHtml: true })
    .process(markdown);

  return String(rendered);
}

function splitTopLevelSections(markdown: string): MarkdownSection[] {
  const headingRegex = /^##\s+(.+)$/gm;
  const matches = Array.from(markdown.matchAll(headingRegex));
  if (!matches.length) return [];

  return matches.map((match, index) => {
    const heading = match[1].trim();
    const start = match.index ?? 0;
    const nextStart = index + 1 < matches.length ? (matches[index + 1].index ?? markdown.length) : markdown.length;
    const sectionMarkdown = markdown.slice(start, nextStart).trim();
    return {
      heading,
      markdown: sectionMarkdown
    };
  });
}

function findChapterSection(sections: MarkdownSection[], chapterCode: string) {
  const chapterCodeLc = chapterCode.toLowerCase();
  return sections.find((section) => {
    const heading = section.heading.toLowerCase();
    return heading === chapterCodeLc || heading.startsWith(`${chapterCodeLc} `);
  });
}

export async function getStaticPaths() {
  const textbookEntries = await getCollection('igcse-textbooks');

  return textbookEntries.flatMap((entry) => {
    const topicNumber = entry.data.topicNumber;
    const topic = `topic${topicNumber}`;

    return (entry.data.subtopics || [])
      .map((subtopic) => {
        const chapterCode = subtopic.code;
        const chapterSlug = chapterCode.replace('.', '-');

        return {
          params: {
            topic,
            chapter: chapterSlug
          },
          props: {
            topic,
            topicNumber,
            topicName: entry.data.topicName,
            chapterCode,
            chapterTitle: subtopic.title,
            chapterSlug
          }
        };
      });
  });
}

const { topicNumber, topicName, chapterCode, chapterTitle } =
  Astro.props as IgcseTopicTextbookChapterPathProps;
const textbookEntry = (await getCollection('igcse-textbooks', ({ data }) => data.topicNumber === topicNumber))[0];
const textbookSections = textbookEntry ? splitTopLevelSections(textbookEntry.body) : [];
const keyTermsSection = textbookSections.find(
  (section) => section.heading.toLowerCase() === KEY_TERMS_HEADING.toLowerCase()
);
const chapterSection = findChapterSection(textbookSections, chapterCode);
const chapterMarkdown = chapterSection
  ? [keyTermsSection?.markdown, chapterSection.markdown]
      .filter((section): section is string => Boolean(section))
      .join('\n\n')
  : '';
const chapterHtml = chapterMarkdown ? await renderMarkdownToHtml(chapterMarkdown) : '';
const availableChapters = textbookEntry?.data.subtopics || [];
---

<ReaderShell
  title={`IGCSE Topic ${topicNumber} ${chapterCode}: ${chapterTitle}`}
  description={`IGCSE Computer Science Topic ${topicNumber} ${chapterCode} (${chapterTitle}) reading.`}
  kicker={`IGCSE 0478 · Topic ${topicNumber} · ${chapterCode}`}
  heading={`${chapterCode} ${chapterTitle}`}
  subtitle={`${topicName} reading`}
>
  {
    chapterHtml ? (
      <>
        <div set:html={chapterHtml}></div>
      </>
    ) : (
      <>
        <p class="reader-callout">
          <strong>Chapter content not found.</strong> We could not locate content for {chapterCode} in Topic {topicNumber}.
        </p>

        <h2>Available chapter links</h2>
        <ul>
          {availableChapters.length ? (
            availableChapters.map((subtopic) => (
              <li>
                <a href={`/igcse/topic${topicNumber}/textbook/${subtopic.code.replace('.', '-')}.html`}>
                  {subtopic.code} {subtopic.title}
                </a>
              </li>
            ))
          ) : (
            <li>No mapped chapters yet.</li>
          )}
        </ul>
      </>
    )
  }

  <Fragment slot="scripts">
    <script is:inline src="/js/igcse-pseudocode-highlighter.js"></script>
    {topicNumber === 1 && <script is:inline src="/js/igcse-topic1-interactive.js"></script>}
  </Fragment>
</ReaderShell>
