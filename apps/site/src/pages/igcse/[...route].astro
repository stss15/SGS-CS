---
import LegacyHtmlDocument from '../../components/LegacyHtmlDocument.astro';
import { getIgcseLegacyRouteHtml, getIgcseLegacyRoutes } from '@sgs/content-schema';

interface IgcseLegacyPageProps {
  html: string;
}

export async function getStaticPaths() {
  const routes = await getIgcseLegacyRoutes();
  const textbookRoutePattern = /^\/igcse\/topic\d+\/textbook\.html$/i;

  return Promise.all(
    routes
      .filter((route) => route.routePath !== '/igcse/index.html')
      .filter((route) => !textbookRoutePattern.test(route.routePath))
      .map(async (route) => ({
        params: {
          route: route.routePath.replace(/^\/igcse\//, '').replace(/\.html$/, '')
        },
        props: {
          html: await getIgcseLegacyRouteHtml(route.routePath)
        }
      }))
  );
}

const { html } = Astro.props as IgcseLegacyPageProps;
---

<LegacyHtmlDocument html={html} />
