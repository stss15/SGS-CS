---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPanel from '../../components/HeroPanel.astro';
import TopicSectionGrid from '../../components/TopicSectionGrid.astro';
import { getIgcseListing } from '@sgs/content-schema';

const listing = await getIgcseListing();
---

<BaseLayout title="IGCSE Computer Science - SGS Computer Science" description="IGCSE Computer Science resources, split into Paper 1 and Paper 2 topics.">
  <HeroPanel
    title="IGCSE Computer Science"
    subtitle="Select a topic below to start your revision."
  >
    <TopicSectionGrid sections={listing.sections} />
  </HeroPanel>
</BaseLayout>
