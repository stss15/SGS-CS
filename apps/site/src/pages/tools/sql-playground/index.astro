---
import SqlPlaygroundApp from '../../../components/SqlPlaygroundApp.astro';
import ToolShell from '../../../layouts/ToolShell.astro';

const title = 'SQL Playground | SGS Education';
const description =
  'A shared SQL playground for IGCSE and IB lessons with JSON-backed sample databases, custom workspaces, and schema diagrams.';
---

<ToolShell
  title={title}
  description={description}
  extraStyles={[
    'https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism.min.css',
    'css/tool-sql-playground.css'
  ]}
>
  <SqlPlaygroundApp />
</ToolShell>
