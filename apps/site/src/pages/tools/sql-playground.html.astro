---
const title = 'SQL Playground | SGS Education';
const description =
  'A shared SQL playground for IGCSE and IB lessons with JSON-backed sample databases and schema diagrams.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/Logo.png" />
    <link rel="apple-touch-icon" href="/images/Logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism.min.css"
    />
    <link rel="stylesheet" href="/css/tool-sql-playground.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/sql-wasm.js" defer></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/sql-formatter/12.2.3/sql-formatter.min.js"
      defer
    ></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" defer></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-sql.min.js"
      defer
    ></script>
    <script type="module" src="/js/tool-sql-playground.js"></script>
  </head>
  <body class="sql-playground-shell">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <main id="main-content" class="sql-playground-page">
      <header class="playground-hero">
        <div class="playground-hero-copy">
          <p class="eyebrow">Shared classroom tool</p>
          <h1>SQL Playground</h1>
          <p class="hero-lead">
            Run real SQL against JSON-backed teaching databases or a blank workspace, inspect keys
            and relationships, and export or re-import browser-built databases as JSON when you
            want to continue later.
          </p>
        </div>

        <div class="playground-hero-links" aria-label="Related course pages">
          <a href="/igcse/topic9/index.html#independent-tasks">IGCSE Topic 9</a>
          <a href="/ib-2027/sl/unit-6/index.html#student-activities">IB SL Unit 6</a>
          <a href="/ib-2027/hl/unit-5/index.html#student-activities">IB HL Unit 5</a>
        </div>
      </header>

      <section class="playground-toolbar card">
        <div class="control-group">
          <span class="control-label">Teaching mode</span>
          <div class="mode-switch" id="mode-switch" role="tablist" aria-label="Teaching mode">
            <button type="button" data-mode="igcse" role="tab" aria-selected="false">IGCSE</button>
            <button type="button" data-mode="sl" role="tab" aria-selected="false">IB SL</button>
            <button type="button" data-mode="hl" role="tab" aria-selected="false">IB HL</button>
          </div>
        </div>

        <label class="control-group selector-group" for="dataset-select">
          <span class="control-label">Workspace</span>
          <select id="dataset-select" name="dataset"></select>
        </label>

        <div class="control-group summary-group">
          <span class="control-label">Current workspace</span>
          <div class="dataset-summary">
            <strong id="dataset-name">Loading...</strong>
            <p id="dataset-description"></p>
            <div class="pill-row" id="dataset-badges"></div>
          </div>
        </div>

        <div class="control-group utility-group">
          <span class="control-label">Workspace tools</span>
          <input
            id="import-json-input"
            type="file"
            accept=".json,application/json"
            hidden
          />
          <div class="toolbar-actions">
            <button type="button" class="secondary-button" id="new-blank-button">New blank database</button>
            <button type="button" class="secondary-button" id="import-json-button">Import JSON</button>
            <button type="button" class="secondary-button" id="export-json-button">Export JSON</button>
          </div>
          <div class="toolbar-actions toolbar-actions-secondary">
            <button type="button" class="secondary-button" id="reset-database-button">Reset workspace</button>
            <button type="button" class="secondary-button" id="clear-query-button">Clear query</button>
          </div>
        </div>
      </section>

      <div class="playground-grid">
        <aside class="card inspector-card" aria-labelledby="schema-heading">
          <div class="panel-header">
            <div>
              <p class="panel-eyebrow">Inspect the schema</p>
              <h2 id="schema-heading">Tables and relationships</h2>
            </div>
            <p class="panel-help">Click any table to load a preview query.</p>
          </div>

          <div class="inspector-tabs" role="tablist" aria-label="Schema views">
            <button type="button" data-tab="tables" role="tab" aria-selected="true">Tables</button>
            <button type="button" data-tab="erd" role="tab" aria-selected="false">ERD</button>
          </div>

          <div class="inspector-panel" id="tables-panel" role="tabpanel">
            <div class="table-list" id="table-list"></div>
          </div>

          <div class="inspector-panel" id="erd-panel" role="tabpanel" hidden>
            <div class="erd-stage" id="erd-stage"></div>
            <div class="relationship-list" id="relationship-list"></div>
          </div>
        </aside>

        <section class="workspace">
          <section class="card editor-card" aria-labelledby="editor-heading">
            <div class="panel-header editor-header">
              <div>
                <p class="panel-eyebrow">Write and run SQL</p>
                <h2 id="editor-heading">Query editor</h2>
              </div>
              <div class="editor-actions">
                <button type="button" class="ghost-button" id="format-query-button">Format</button>
                <button type="button" class="primary-button" id="run-query-button">Run query</button>
              </div>
            </div>

            <div class="editor-context">
              <div class="pill-row" id="focus-pill-row"></div>
              <p class="editor-tip" id="editor-tip">Ctrl/Cmd + Enter runs the current query.</p>
            </div>

            <div class="editor-shell" id="editor-shell">
              <pre class="editor-highlight" id="editor-highlight" aria-hidden="true"><code class="language-sql" id="editor-highlight-code"></code></pre>
              <textarea
                id="query-input"
                spellcheck="false"
                placeholder="Loading sample query..."
                aria-label="SQL query input"
              ></textarea>
              <div class="suggestions" id="query-suggestions" hidden></div>
            </div>

            <div class="editor-footer">
              <div class="status-inline" id="editor-status" aria-live="polite"></div>
            </div>
          </section>

          <section class="card results-card" aria-labelledby="results-heading">
            <div class="panel-header">
              <div>
                <p class="panel-eyebrow">See the output</p>
                <h2 id="results-heading">Query results</h2>
              </div>
              <div class="results-meta" id="results-meta" aria-live="polite"></div>
            </div>

            <div class="results-output" id="results-output">
              <div class="empty-state">
                <p>Initialising SQL engine...</p>
              </div>
            </div>
          </section>
        </section>
      </div>
    </main>
  </body>
</html>
