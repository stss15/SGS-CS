---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import IbProjectSequencePage from '../../../../components/IbProjectSequencePage.astro';
import { getProjectStaticSlugs, getProjectStep, sqlProjectSequence } from '../../../../lib/ib-project-content';

export function getStaticPaths() {
  return getProjectStaticSlugs(sqlProjectSequence).map((step) => ({
    params: { step },
    props: { currentSlug: step }
  }));
}

const { currentSlug } = Astro.props;
const currentStep = getProjectStep(sqlProjectSequence, currentSlug);
---

<BaseLayout
  title={`${currentStep.title} | ${sqlProjectSequence.projectTitle}`}
  description={currentStep.intro}
  activeSection="ib"
  extraStyles={[
    'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/atom-one-dark-reasonable.min.css',
    'css/ib-project-sequence.css'
  ]}
>
  <IbProjectSequencePage sequence={sqlProjectSequence} currentSlug={currentSlug} />
</BaseLayout>
