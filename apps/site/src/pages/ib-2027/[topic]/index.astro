---
import CurriculumShell from '../../../layouts/CurriculumShell.astro';
import { IB_UNITS, getUnitFrontmatter, getSubtopicFrontmatter, type UnitFrontmatter } from '../../../lib/ib-subtopic-data';

export async function getStaticPaths() {
  return Promise.all(Object.keys(IB_UNITS).map(async (code) => {
    const fm = await getUnitFrontmatter(code);
    const subtopics = (fm.resources || []).filter((r) => r.href && !r.href.includes('coming-soon'));
    const subtopicDetails = await Promise.all(
      subtopics.map(async (st) => {
        const subtopicCode = st.number || st.href.replace(/\/index\.html$/i, '');
        const sfm = await getSubtopicFrontmatter(code, subtopicCode);
        return { number: st.number, name: st.name, description: sfm.description || '' };
      })
    );
    return { params: { topic: code }, props: { code, fm, subtopicDetails } };
  }));
}

interface SubtopicDetail { number?: string; name?: string; description: string; }
const { code, fm, subtopicDetails } = Astro.props as { code: string; fm: UnitFrontmatter; subtopicDetails: SubtopicDetail[] };
const unit = IB_UNITS[code];
const spec = fm.specification;
---

<CurriculumShell
  title={`${code} ${unit.name} - SGS Computer Science`}
  description={spec?.unitSummary || `${code} ${unit.name} — IB Computer Science`}
  extraStyles={['css/resource-style.css']}
  activeSection="ib"
  eyebrow={code}
  heroTitle={`${code} ${unit.name}`}
  heroSubtitle={unit.meta}
  heroVariant="feature"
>
  <div class="unit-overview">
    {spec?.unitSummary && (
      <p class="unit-summary">{spec.unitSummary}</p>
    )}

    {subtopicDetails.length > 0 && (
      <div class="subtopic-grid" role="list">
        {subtopicDetails.map((st) => (
          <article class="subtopic-card" role="listitem">
            <div class="subtopic-card__topline">
              <span class="subtopic-card__code">{st.number}</span>
            </div>
            <h2 class="subtopic-card__title">{st.name}</h2>
            {st.description && <p class="subtopic-card__desc">{st.description}</p>}
          </article>
        ))}
      </div>
    )}
  </div>

  <style>
    .unit-overview {
      width: 100%;
    }

    .unit-summary {
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--text-color, #444);
      margin: 0 0 1.5rem;
    }

    .subtopic-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.8rem;
    }

    .subtopic-card {
      position: relative;
      min-height: 8rem;
      padding: 0.95rem 1rem 0.9rem;
      border-radius: 1.15rem;
      background: linear-gradient(168deg, #ffffff 60%, #faf8f4 100%);
      box-shadow:
        inset 0 0 0 1px rgba(10, 22, 40, 0.06),
        0 8px 18px rgba(17, 27, 45, 0.04);
      overflow: hidden;
    }

    .subtopic-card::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: var(--navy-900, #0a1628);
    }

    .subtopic-card__topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.35rem;
    }

    .subtopic-card__code {
      font-family: var(--font-display);
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-text-muted, #556476);
    }

    .subtopic-card__title {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--navy-900, #0a1628);
      line-height: 1.2;
      margin: 0 0 0.35rem;
    }

    .subtopic-card__desc {
      font-size: 0.88rem;
      line-height: 1.55;
      color: var(--color-text-muted, #556476);
      margin: 0;
    }

    @media (max-width: 600px) {
      .subtopic-grid { grid-template-columns: 1fr; }
      .subtopic-card { min-height: auto; }
    }
  </style>
</CurriculumShell>
