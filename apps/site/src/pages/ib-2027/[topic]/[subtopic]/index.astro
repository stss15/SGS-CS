---
import { IB_SUBTOPICS, getSubtopicSlides } from '../../../../lib/ib-subtopic-data';

export async function getStaticPaths() {
  return Promise.all(IB_SUBTOPICS.map(async ({ topic, subtopic }) => {
    const slides = await getSubtopicSlides(topic, subtopic);
    const firstSlide = slides.length > 0 ? slides[0].href : null;
    return {
      params: {
        topic: topic.toLowerCase(),
        subtopic: subtopic.toLowerCase().replace('.', '-')
      },
      props: { topic, firstSlide }
    };
  }));
}

const { topic, firstSlide } = Astro.props as { topic: string; firstSlide: string | null };
const unitHref = `/ib-2027/${topic.toLowerCase()}/index.html`;
const redirectTarget = firstSlide || unitHref;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectTarget}`} />
    <link rel="canonical" href={redirectTarget} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>Redirecting to <a href={redirectTarget}>{redirectTarget}</a>…</p>
  </body>
</html>
