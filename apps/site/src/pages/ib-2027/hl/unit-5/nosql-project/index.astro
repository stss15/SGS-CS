---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import IbProjectSequencePage from '../../../../../components/IbProjectSequencePage.astro';
import { getProjectStep, nosqlProjectSequence } from '../../../../../lib/ib-project-content';

const currentStep = getProjectStep(nosqlProjectSequence, '');
---

<BaseLayout
  title={`${currentStep.title} | ${nosqlProjectSequence.projectTitle}`}
  description={currentStep.intro}
  activeSection="ib"
  extraStyles={[
    'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/atom-one-dark-reasonable.min.css',
    'css/ib-project-sequence.css'
  ]}
>
  <IbProjectSequencePage sequence={nosqlProjectSequence} currentSlug="" />
</BaseLayout>
