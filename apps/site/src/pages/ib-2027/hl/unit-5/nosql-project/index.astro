---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import HeroPanel from '../../../../../components/HeroPanel.astro';
import IbProjectJourney from '../../../../../components/IbProjectJourney.astro';

interface JourneyPart {
  id: string;
  title: string;
  summary: string;
  contentHtml: string;
}

interface JourneyStage {
  id: string;
  label: string;
  title: string;
  overview: string;
  parts: JourneyPart[];
}

const flowLine = 'UI -> JavaScript -> HTTP -> Flask -> JSON Storage -> Response -> UI';

const listMarkup = (items: string[]) => '<ul>' + items.map((item) => '<li>' + item + '</li>').join('') + '</ul>';

const nosqlFeaturePart = (
  featureNumber: number,
  title: string,
  purpose: string,
  concept: string,
  files: string[],
  criteria: string[],
  studentTask: string[]
): JourneyPart => ({
  id: `nosql-feature-${featureNumber}`,
  title: `Feature ${featureNumber} - ${title} (JSON Track)`,
  summary: purpose,
  contentHtml: `
    <section class="journey-block">
      <h5>Feature Description</h5>
      <p>${purpose}</p>
    </section>
    <section class="journey-block">
      <h5>System Flow Context</h5>
      <pre>${flowLine}</pre>
      <p>Focus concept for this step: ${concept}</p>
    </section>
    <section class="journey-block">
      <h5>Technology Reference (Generic)</h5>
      <p>Use short, unrelated examples to understand syntax and file handling patterns. Do not copy any complete project logic from this page.</p>
    </section>
    <section class="journey-block">
      <h5>Code Files Involved (Conceptual)</h5>
      ${listMarkup(files)}
    </section>
    <section class="journey-block">
      <h5>Implementation Criteria</h5>
      ${listMarkup(criteria)}
    </section>
    <section class="journey-block">
      <h5>Student Task</h5>
      ${listMarkup(studentTask)}
    </section>
  `
});

const noSqlFeatureParts: JourneyPart[] = [
  nosqlFeaturePart(
    1,
    'Project Directory Structure',
    'Set up an equivalent project skeleton for a JSON-backed implementation.',
    'Same architecture shape, different storage strategy.',
    ['app.py', 'templates/', 'static/', 'data/'],
    ['Folder layout mirrors the SQL project flow.', 'Data storage location is explicit and isolated.', 'Frontend and backend concerns remain separated.'],
    ['Create the HL directory skeleton.', 'Annotate where JSON data files are managed.', 'Keep structure transparent for comparison with SQL.']
  ),
  nosqlFeaturePart(
    2,
    'Base HTML Page',
    'Reuse the same UI shell so backend/storage comparison stays fair.',
    'Consistent interface across storage models.',
    ['templates/index.html'],
    ['Page layout matches expected interaction zones.', 'No storage-specific UI assumptions are hardcoded.', 'UI remains compatible with both tracks.'],
    ['Build or reuse the base page shell.', 'Keep naming consistent with SL track.', 'Confirm layout is ready for dynamic rendering.']
  ),
  nosqlFeaturePart(
    3,
    'Task List Display Area',
    'Prepare dynamic list rendering area exactly as in the SQL track.',
    'Frontend portability across backends.',
    ['templates/index.html', 'static/js/app.js'],
    ['List container is stable and targetable.', 'Rendering logic can consume JSON responses.', 'Empty state remains clearly handled.'],
    ['Set list container identifiers.', 'Confirm rendering hooks are reusable.', 'Preserve behavior parity with SQL track.']
  ),
  nosqlFeaturePart(
    4,
    'Add Task Button and Modal',
    'Keep task creation interactions identical while changing only storage behavior.',
    'UI continuity and backend abstraction awareness.',
    ['templates/index.html'],
    ['Modal opens and closes correctly.', 'Input layout remains complete.', 'No storage details leak into modal structure.'],
    ['Implement modal interactions.', 'Ensure required fields are visible.', 'Keep user experience aligned with SQL project.']
  ),
  nosqlFeaturePart(
    5,
    'Form Inputs',
    'Capture all required values before JSON write operations.',
    'Input data integrity before file persistence.',
    ['templates/index.html'],
    ['Required fields are enforced clearly.', 'Input values map to document properties conceptually.', 'Validation expectations are documented.'],
    ['Add complete input set.', 'Define validation checks for each field.', 'Map each field to planned storage shape conceptually.']
  ),
  nosqlFeaturePart(
    6,
    'Fetch and Display Tasks',
    'Read document data and render it through the same UI pipeline.',
    'JSON read operations and response consistency.',
    ['static/js/app.js', 'app.py', 'data/*.json'],
    ['Read endpoint returns predictable payload structure.', 'List rendering updates without full page reload.', 'Students can trace document read to UI output.'],
    ['Implement read workflow with teacher guidance.', 'Render returned records into the list view.', 'Handle missing or empty datasets safely.']
  ),
  nosqlFeaturePart(
    7,
    'Create Task',
    'Persist new records by writing to JSON-backed storage.',
    'POST handling and controlled document updates.',
    ['static/js/app.js', 'app.py', 'data/*.json'],
    ['Create operation appends valid record data.', 'Record identifiers remain unique and traceable.', 'List refresh confirms persistence.'],
    ['Submit create requests from the modal.', 'Validate inputs server-side before write.', 'Reload task list after successful creation.']
  ),
  nosqlFeaturePart(
    8,
    'Delete Task',
    'Remove records by identifier while preserving file consistency.',
    'Identifier-based record removal in document storage.',
    ['static/js/app.js', 'app.py', 'data/*.json'],
    ['Delete targets the intended record id only.', 'Post-delete dataset remains valid JSON.', 'UI and storage remain synchronized.'],
    ['Wire delete controls to id-based requests.', 'Update stored data atomically in the teacher-led workflow.', 'Refresh list after delete action.']
  ),
  nosqlFeaturePart(
    9,
    'Update Task Status',
    'Modify completion state in document records and show feedback.',
    'Record update operations with document persistence.',
    ['static/js/app.js', 'app.py', 'data/*.json'],
    ['Status updates persist correctly.', 'Updated status appears in UI immediately after refresh.', 'Update scope is restricted to the selected record.'],
    ['Implement completion action path.', 'Persist status change with id targeting.', 'Verify feedback in rendered list output.']
  ),
  nosqlFeaturePart(
    10,
    'Filtering and Sorting',
    'Apply filter/sort logic while keeping output behavior aligned with SQL track.',
    'Conditional retrieval strategies over document records.',
    ['static/js/app.js', 'app.py'],
    ['Filters for user, priority, and due date are functional.', 'Sorting order is deterministic and explainable.', 'Behavior matches test expectations.'],
    ['Implement filter controls and handling.', 'Define order rules for sorted output.', 'Test combinations of filters and sorts.']
  ),
  nosqlFeaturePart(
    11,
    'Testing Against Evaluation Criteria',
    'Validate the JSON implementation against the same measurable goals as the SQL track.',
    'Cross-model evaluation and parity checking.',
    ['Project test table', 'UI behavior checks', 'Document storage verification'],
    ['Evaluation criteria map to concrete tests.', 'Results are recorded as expected vs actual.', 'Differences between SQL and JSON behavior are explained.'],
    ['Run the full test table.', 'Capture evidence for parity and differences.', 'Summarize model tradeoffs from real outcomes.']
  )
];

const stages: JourneyStage[] = [
  {
    id: 'hl-stage-1',
    label: 'Stage 1',
    title: 'JSON and NoSQL Theory',
    overview: 'Build the conceptual foundation before implementation so model choices are deliberate rather than trend-driven.',
    parts: [
      {
        id: 'hl-stage-1-part-1',
        title: 'JSON Fundamentals',
        summary: 'Understand JSON as a strict data interchange format used in web pipelines.',
        contentHtml: `
          <section class="journey-block">
            <h5>Core Concepts</h5>
            ${listMarkup([
              'Objects (key/value pairs).',
              'Arrays (ordered collections).',
              'Nested structures for complex data.',
              'Strict syntax rules: double quotes, no trailing commas, no comments.'
            ])}
          </section>
          <section class="journey-block">
            <h5>Generic Syntax Example</h5>
            <pre>{
  "project": "Library Tracker",
  "active": true,
  "members": ["Mina", "Tariq", "Sofia"]
}</pre>
          </section>
        `
      },
      {
        id: 'hl-stage-1-part-2',
        title: 'Document Databases and NoSQL',
        summary: 'Frame JSON storage within the broader NoSQL model landscape.',
        contentHtml: `
          <section class="journey-block">
            <h5>NoSQL Focus</h5>
            ${listMarkup([
              'Document-oriented storage emphasizes flexible record shapes.',
              'Model choice depends on access patterns and consistency needs.',
              'NoSQL is not automatically better; it is context dependent.'
            ])}
          </section>
        `
      },
      {
        id: 'hl-stage-1-part-3',
        title: 'SQL vs NoSQL Comparison',
        summary: 'Use clear tradeoff language to justify storage model decisions.',
        contentHtml: `
          <section class="journey-block">
            <h5>Comparison Lens</h5>
            <table>
              <thead><tr><th>Area</th><th>SQL</th><th>NoSQL (Document)</th></tr></thead>
              <tbody>
                <tr><td>Structure</td><td>Fixed schema</td><td>Flexible schema</td></tr>
                <tr><td>Relationships</td><td>Strong relational modeling</td><td>Often handled by embedding or references</td></tr>
                <tr><td>Consistency rules</td><td>Explicit constraints</td><td>App-managed in many cases</td></tr>
                <tr><td>Query style</td><td>Declarative relational queries</td><td>Document retrieval and filtering patterns</td></tr>
              </tbody>
            </table>
          </section>
        `
      }
    ]
  },
  {
    id: 'hl-stage-2',
    label: 'Stage 2',
    title: 'Python JSON Exploration',
    overview: 'Practice safe read/write/update operations with JSON in small generic exercises before using project data.',
    parts: [
      {
        id: 'hl-stage-2-part-1',
        title: 'Read JSON Data',
        summary: 'Understand how structured text data is loaded for application use.',
        contentHtml: `
          <section class="journey-block">
            <h5>Learning Goal</h5>
            ${listMarkup([
              'Open and parse JSON safely.',
              'Inspect collection and object structures.',
              'Validate expected keys before use.'
            ])}
          </section>
          <section class="journey-block">
            <h5>Generic Pattern</h5>
            <pre># Pseudocode pattern
open file
parse JSON text
loop through records
read needed values</pre>
          </section>
        `
      },
      {
        id: 'hl-stage-2-part-2',
        title: 'Write and Modify JSON Data',
        summary: 'Control updates carefully to preserve valid document structure.',
        contentHtml: `
          <section class="journey-block">
            <h5>Learning Goal</h5>
            ${listMarkup([
              'Create new records with required fields.',
              'Update selected records by identifier.',
              'Write changes back in valid JSON format.'
            ])}
          </section>
          <section class="journey-block">
            <h5>Safety Checks</h5>
            ${listMarkup([
              'Preserve valid JSON syntax after every write.',
              'Avoid accidental overwrite of unrelated records.',
              'Validate update targets before changing data.'
            ])}
          </section>
        `
      },
      {
        id: 'hl-stage-2-part-3',
        title: 'Linking Related Data in JSON',
        summary: 'Represent relationships using id references or embedded structures and evaluate each choice.',
        contentHtml: `
          <section class="journey-block">
            <h5>Relationship Options</h5>
            ${listMarkup([
              'Reference style: separate documents connected by ids.',
              'Embedded style: related details nested in one document.',
              'Tradeoff analysis: redundancy vs lookup complexity.'
            ])}
          </section>
        `
      }
    ]
  },
  {
    id: 'hl-stage-3',
    label: 'Stage 3',
    title: 'SQL vs NoSQL Data Modelling',
    overview: 'Compare two JSON modelling approaches and evaluate their impact on redundancy, updates, and flexibility.',
    parts: [
      {
        id: 'hl-stage-3-part-1',
        title: 'Model A: Separate Documents with IDs',
        summary: 'Use id references across multiple JSON files/documents.',
        contentHtml: `
          <section class="journey-block">
            <h5>Characteristics</h5>
            ${listMarkup([
              'Keeps repeated details centralized.',
              'Requires lookup logic across files/documents.',
              'Closer conceptual parallel to foreign-key thinking.'
            ])}
          </section>
        `
      },
      {
        id: 'hl-stage-3-part-2',
        title: 'Model B: Embedded Data',
        summary: 'Store related details directly inside each primary document.',
        contentHtml: `
          <section class="journey-block">
            <h5>Characteristics</h5>
            ${listMarkup([
              'Fast single-document reads for common views.',
              'Higher risk of redundant repeated values.',
              'Updates can require changes in multiple places.'
            ])}
          </section>
        `
      },
      {
        id: 'hl-stage-3-part-3',
        title: 'Comparison Matrix and Decision',
        summary: 'Evaluate both models with explicit criteria rather than preference.',
        contentHtml: `
          <section class="journey-block">
            <h5>Decision Matrix</h5>
            <table>
              <thead><tr><th>Criterion</th><th>Model A (Referenced)</th><th>Model B (Embedded)</th></tr></thead>
              <tbody>
                <tr><td>Redundancy</td><td>Lower</td><td>Higher</td></tr>
                <tr><td>Read simplicity</td><td>Moderate</td><td>High</td></tr>
                <tr><td>Update complexity</td><td>Lower for shared fields</td><td>Higher when data repeats</td></tr>
                <tr><td>Structural flexibility</td><td>High</td><td>High</td></tr>
              </tbody>
            </table>
          </section>
        `
      }
    ]
  },
  {
    id: 'hl-stage-4',
    label: 'Stage 4',
    title: 'Parallel JSON Implementation',
    overview: 'Rebuild the same feature sequence as the SQL project while changing only the storage model.',
    parts: noSqlFeatureParts
  }
];
---

<BaseLayout
  title="HL Unit 5 NoSQL Project Journey - SGS Education"
  description="Stage-based NoSQL project journey for IB 2027 HL Unit 5."
  extraStyles={['css/ib-project-journey.css']}
>
  <HeroPanel
    title="NoSQL Project"
    subtitle="HL Unit 5 - Stage-based build journey"
  />

  <IbProjectJourney
    backHref="/ib-2027/hl/unit-5/index.html"
    backLabel="Back to HL Unit 5"
    introTitle="Parallel JSON Project (HL Unit 5)"
    introSummary="Progress through four HL stages: theory, Python JSON exploration, modelling comparison, and a full feature-by-feature JSON implementation track."
    policyNote="This page does not expose the real project implementation. Use it to understand decisions, sequence, and evaluation criteria while writing the codebase with your teacher."
    stages={stages}
  />
</BaseLayout>
