---
import CurriculumShell from '../../layouts/CurriculumShell.astro';
---

<CurriculumShell
  title="IB Computer Science - SGS Computer Science"
  description="IB Computer Science course — organised by the official IB syllabus structure with Theme A and Theme B."
  extraStyles={['css/resource-style.css']}
  activeSection="ib"
  breadcrumbs={[{ label: 'Home', href: '/index.html' }, { label: 'IB Computer Science' }]}
  heroTitle="IB Computer Science"
  heroSubtitle="Explore the course by theme, topic, and subtopic."
  heroVariant="feature"
>
  <div class="ib-landing">
    <section class="ib-section">
      <h2 class="ib-section-title">What You Study</h2>
    </section>

    <div class="ib-themes-grid">

    <section class="ib-theme">
      <div class="ib-theme-header ib-theme-header--a">
        <h2 class="ib-theme-label">Theme A</h2>
        <p class="ib-theme-name">Concepts of Computer Science</p>
      </div>
      <div class="ib-unit-list">
        <div class="ib-unit-card">
          <span class="ib-unit-code">A1</span>
          <div class="ib-unit-body">
            <h3 class="ib-unit-name">Computer Fundamentals</h3>
            <ul class="ib-subtopic-list"><li>A1.1 Computer hardware and operation</li><li>A1.2 Data representation and computer logic</li><li>A1.3 Operating systems and control systems</li><li>A1.4 Translation <span class="ib-hl-badge">HL</span></li></ul>
          </div>
        </div>
        <div class="ib-unit-card">
          <span class="ib-unit-code">A2</span>
          <div class="ib-unit-body">
            <h3 class="ib-unit-name">Networks</h3>
            <ul class="ib-subtopic-list"><li>A2.1 Network fundamentals</li><li>A2.2 Network architecture</li><li>A2.3 Data transmissions</li><li>A2.4 Network security</li></ul>
          </div>
        </div>
        <div class="ib-unit-card">
          <span class="ib-unit-code">A3</span>
          <div class="ib-unit-body">
            <h3 class="ib-unit-name">Databases</h3>
            <ul class="ib-subtopic-list"><li>A3.1 Database fundamentals</li><li>A3.2 Database design</li><li>A3.3 Database programming</li><li>A3.4 Alternative databases <span class="ib-hl-badge">HL</span></li></ul>
          </div>
        </div>
        <div class="ib-unit-card">
          <span class="ib-unit-code">A4</span>
          <div class="ib-unit-body">
            <h3 class="ib-unit-name">Machine Learning</h3>
            <ul class="ib-subtopic-list"><li>A4.1 ML fundamentals</li><li>A4.2 Data preprocessing <span class="ib-hl-badge">HL</span></li><li>A4.3 ML approaches <span class="ib-hl-badge">HL</span></li><li>A4.4 Ethical considerations</li></ul>
          </div>
        </div>
      </div>
    </section>

    <section class="ib-theme">
      <div class="ib-theme-header ib-theme-header--b">
        <h2 class="ib-theme-label">Theme B</h2>
        <p class="ib-theme-name">Computational Thinking and Problem-Solving</p>
      </div>
      <div class="ib-unit-list">
        <div class="ib-unit-card">
          <span class="ib-unit-code">B1</span>
          <div class="ib-unit-body">
            <h3 class="ib-unit-name">Computational Thinking</h3>
            <ul class="ib-subtopic-list"><li>B1.1 Approaches to computational thinking</li></ul>
          </div>
        </div>
        <div class="ib-unit-card">
          <span class="ib-unit-code">B2</span>
          <div class="ib-unit-body">
            <h3 class="ib-unit-name">Programming</h3>
            <ul class="ib-subtopic-list"><li>B2.1 Programming fundamentals</li><li>B2.2 Data structures</li><li>B2.3 Programming constructs</li><li>B2.4 Programming algorithms</li><li>B2.5 File processing</li></ul>
          </div>
        </div>
        <div class="ib-unit-card">
          <span class="ib-unit-code">B3</span>
          <div class="ib-unit-body">
            <h3 class="ib-unit-name">Object-Oriented Programming</h3>
            <ul class="ib-subtopic-list"><li>B3.1 Fundamentals of OOP for a single class</li><li>B3.2 OOP for multiple classes <span class="ib-hl-badge">HL</span></li></ul>
          </div>
        </div>
        <div class="ib-unit-card">
          <span class="ib-unit-code">B4</span>
          <div class="ib-unit-body">
            <h3 class="ib-unit-name">Abstract Data Types</h3>
            <ul class="ib-subtopic-list"><li>B4.1 Fundamentals of ADTs <span class="ib-hl-badge">HL</span></li></ul>
          </div>
        </div>
      </div>
    </section>
    </div>

    <section class="ib-theme">
      <div class="ib-theme-header ib-theme-header--assess">
        <h2 class="ib-theme-label">Assessment</h2>
      </div>
      <div class="ib-assess-grid">
        <div class="ib-assess-card">
          <h3 class="ib-assess-title"><i class="fa-solid fa-file-lines"></i> Paper 1</h3>
          <p>Based on <strong>Theme A</strong> and the pre-seen case study.</p>
          <div class="ib-assess-levels"><div class="ib-assess-level"><span class="ib-assess-badge">SL</span><span>1h 15m — 35%</span></div><div class="ib-assess-level"><span class="ib-assess-badge ib-assess-badge--hl">HL</span><span>2h — 40%</span></div></div>
        </div>
        <div class="ib-assess-card">
          <h3 class="ib-assess-title"><i class="fa-solid fa-file-code"></i> Paper 2</h3>
          <p>Based on <strong>Theme B</strong>.</p>
          <div class="ib-assess-levels"><div class="ib-assess-level"><span class="ib-assess-badge">SL</span><span>1h 15m — 35%</span></div><div class="ib-assess-level"><span class="ib-assess-badge ib-assess-badge--hl">HL</span><span>2h — 40%</span></div></div>
        </div>
        <div class="ib-assess-card">
          <h3 class="ib-assess-title"><i class="fa-solid fa-laptop-code"></i> Internal Assessment</h3>
          <p>The <strong>computational solution</strong> — a practical project.</p>
          <div class="ib-assess-levels"><div class="ib-assess-level"><span class="ib-assess-badge">SL</span><span>30%</span></div><div class="ib-assess-level"><span class="ib-assess-badge ib-assess-badge--hl">HL</span><span>20%</span></div></div>
        </div>
        <div class="ib-assess-card">
          <h3 class="ib-assess-title"><i class="fa-solid fa-book-open"></i> Case Study</h3>
          <p>Pre-seen scenario — research in advance, answer in Paper 1.</p>
        </div>
        <div class="ib-assess-card">
          <h3 class="ib-assess-title"><i class="fa-solid fa-pen-fancy"></i> Extended Essay</h3>
          <p>Independent research. Optional.</p>
        </div>
      </div>
    </section>
  </div>

  <style>
    .ib-landing{width:100%;max-width:100%}.ib-section-title{font-family:var(--font-display);font-size:1.35rem;font-weight:700;color:var(--primary-dark,#1a2332);margin-bottom:.5rem}.ib-theme{margin-bottom:3rem}.ib-themes-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;align-items:start}.ib-theme-header{padding:1rem 1.25rem;border-radius:8px;margin-bottom:1rem}.ib-theme-header--a,.ib-theme-header--b{background:var(--primary-dark,#1a2332)}.ib-theme-header--assess{background:var(--text-muted,#666)}.ib-theme-label{font-family:var(--font-display);font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.6);margin:0}.ib-theme-name{font-family:var(--font-display);font-size:1.15rem;font-weight:600;color:#fff;margin:.15rem 0 0}.ib-unit-list{display:flex;flex-direction:column;gap:.75rem}.ib-unit-card{display:flex;align-items:flex-start;gap:1rem;padding:1rem 1.25rem;border-radius:8px;background:var(--surface,#fff);border:1px solid var(--border-light,#e5e5e5)}.ib-unit-code{font-family:var(--font-display);font-size:1.1rem;font-weight:700;color:var(--accent-color,#c9a84c);min-width:2rem;padding-top:.1rem}.ib-unit-body{flex:1}.ib-unit-name{font-family:var(--font-display);font-size:1rem;font-weight:600;color:var(--primary-dark,#1a2332);margin:0 0 .5rem}.ib-subtopic-list{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:.35rem}.ib-subtopic-list li{font-size:.78rem;color:var(--text-muted,#888);background:var(--bg-subtle,#f5f3ee);padding:.2rem .55rem;border-radius:4px}.ib-hl-badge{font-size:.65rem;font-weight:700;color:var(--accent-color,#c9a84c);background:rgba(201,168,76,.12);padding:.1rem .35rem;border-radius:3px;margin-left:.25rem}.ib-assess-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:1rem}.ib-assess-card{padding:1.25rem;border-radius:8px;background:var(--surface,#fff);border:1px solid var(--border-light,#e5e5e5)}.ib-assess-card p{font-size:.9rem;line-height:1.6;color:var(--text-color,#444);margin:0 0 .75rem}.ib-assess-title{font-family:var(--font-display);font-size:1rem;font-weight:600;color:var(--primary-dark,#1a2332);margin:0 0 .6rem;display:flex;align-items:center;gap:.5rem}.ib-assess-title i{color:var(--accent-color,#c9a84c);font-size:.9rem}.ib-assess-levels{display:flex;gap:1rem;margin-bottom:.75rem}.ib-assess-level{display:flex;align-items:center;gap:.4rem;font-size:.82rem;color:var(--text-color,#555)}.ib-assess-badge{font-size:.65rem;font-weight:700;padding:.15rem .4rem;border-radius:3px;background:var(--primary-dark,#1a2332);color:#fff}.ib-assess-badge--hl{background:var(--accent-color,#c9a84c)}@media(max-width:900px){.ib-themes-grid{grid-template-columns:1fr}}@media(max-width:600px){.ib-unit-card{flex-direction:column;gap:.5rem}.ib-assess-grid{grid-template-columns:1fr}}
  </style>
</CurriculumShell>
