---
import CompactList from '../../components/CompactList.astro';
import CurriculumShell from '../../layouts/CurriculumShell.astro';
import { getIb2027PathwayIndex, getIbSlCurriculumIndex, getIbHlCurriculumIndex } from '@sgs/content-schema';

const page = await getIb2027PathwayIndex();
const slIndex = await getIbSlCurriculumIndex();
const hlIndex = await getIbHlCurriculumIndex();

const yearSections = (slIndex.sections || []).map((slSection, i) => {
  const hlSection = (hlIndex.sections || [])[i];
  return {
    title: slSection.title,
    subtitle: slSection.subtitle,
    sl: (slSection.items || []).map((item) => ({
      label: item.name,
      href: `/ib-2027/sl/${item.href}`,
      meta: `SL Unit ${item.number}`
    })),
    hl: hlSection
      ? (hlSection.items || []).map((item) => ({
          label: item.name,
          href: `/ib-2027/hl/${item.href}`,
          meta: `HL Unit ${item.number}`
        }))
      : []
  };
});
---

<CurriculumShell
  title={page.title}
  description={page.description || 'IB Computer Science curriculum for first assessment 2027.'}
  extraStyles={['css/resource-style.css']}
  activeSection={page.activeSection}
  breadcrumbs={page.breadcrumbs}
  eyebrow="IB 2027"
  heroTitle={page.hero.title}
  heroSubtitle="Choose your year group, then pick a unit."
  heroVariant="feature"
>
  {yearSections.map((year) => (
    <CompactList
      sections={[
        {
          title: `${year.title} — Standard Level`,
          summary: year.subtitle,
          items: year.sl
        },
        ...(year.hl.length > 0
          ? [
              {
                title: `${year.title} — Higher Level`,
                items: year.hl
              }
            ]
          : [])
      ]}
    />
  ))}
</CurriculumShell>
