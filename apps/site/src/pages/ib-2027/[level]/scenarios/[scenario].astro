---
import { getIb2027ScenarioAliasRoutes } from '@sgs/content-schema';

interface ScenarioAliasPageProps {
  destination: string;
}

export async function getStaticPaths() {
  const routes = await getIb2027ScenarioAliasRoutes();

  return Promise.all(
    routes
      .map((route) => {
        const match = route.routePath.match(/^\/ib-2027\/(sl|hl)\/scenarios\/([^/]+)\.html$/);
        if (!match) {
          return null;
        }

        return {
          routePath: route.routePath,
          level: match[1],
          scenario: match[2]
        };
      })
      .filter((route): route is { routePath: string; level: string; scenario: string } => route !== null)
      .map(async (route) => ({
        params: {
          level: route.level,
          scenario: route.scenario
        },
        props: {
          destination:
            route.level === 'sl'
              ? `/ib-2027/sl/unit-5/scenarios/${route.scenario}.html`
              : `/ib-2027/hl/unit-4/scenarios/${route.scenario}.html`
        }
      }))
  );
}

const { destination } = Astro.props as ScenarioAliasPageProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
    <link rel="canonical" href={destination} />
  </head>
  <body>
    <p>Redirecting to <a href={destination}>{destination}</a>.</p>
  </body>
</html>
