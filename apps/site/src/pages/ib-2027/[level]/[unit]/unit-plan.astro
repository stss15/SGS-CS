---
import type { IbCourseLevel } from '@sgs/content-schema';
import DetailSection from '../../../../components/DetailSection.astro';
import SideCard from '../../../../components/SideCard.astro';
import UnitPlanShell from '../../../../layouts/UnitPlanShell.astro';
import {
  buildIb2027UnitBreadcrumbs,
  getIb2027LevelLabel,
  getIb2027UnitPlanData,
  getIb2027UnitStaticPaths
} from '../../../../lib/ib2027-routes';

interface UnitPlanPageProps {
  level: IbCourseLevel;
  unitNumber: number;
}

export const getStaticPaths = getIb2027UnitStaticPaths;

const { level, unitNumber } = Astro.props as UnitPlanPageProps;
const unitPlan = await getIb2027UnitPlanData(level, unitNumber);
const unitBasePath = `/ib-2027/${level}/unit-${unitPlan.unitNumber}`;
const resolveUnitPlanHref = (href: string) => (href.startsWith('/') ? href : `${unitBasePath}/${href.replace(/^\.?\//, '')}`);
---

<UnitPlanShell
  title={unitPlan.title}
  description={unitPlan.description || 'IB Computer Science unit plan.'}
  level={level}
  unitNumber={unitPlan.unitNumber}
  breadcrumbs={buildIb2027UnitBreadcrumbs(level, unitPlan.unitNumber, 'Unit Plan')}
  heroTitle={`Unit ${unitPlan.unitNumber}: ${unitPlan.unitName}`}
  heroSubtitle={`${getIb2027LevelLabel(level)} curriculum overview and structured learning plan.`}
>
  <DetailSection title="Introduction" open>
    {unitPlan.introduction?.bigQuestion && <p><strong>{unitPlan.introduction.bigQuestion}</strong></p>}
    {unitPlan.introduction?.overview && <p set:html={unitPlan.introduction.overview} />}
    {unitPlan.introduction?.journey && <p set:html={unitPlan.introduction.journey} />}
  </DetailSection>

  {(unitPlan.concepts || []).map((concept) => (
    <DetailSection title={concept.title}>
      <div set:html={concept.content} />
    </DetailSection>
  ))}

  {(unitPlan.terminology || []).length > 0 && (
    <DetailSection title="Key Terminology">
      <table class="term-table">
        <thead>
          <tr><th>Term</th><th>Definition</th></tr>
        </thead>
        <tbody>
          {(unitPlan.terminology || []).map((item) => (
            <tr>
              <td>{item.term}</td>
              <td>{item.definition}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </DetailSection>
  )}

  <Fragment slot="side">
    {(unitPlan.viewSlidesButtons || []).length > 0 && (
      <SideCard title="View Slides">
        <ul class="link-list">
          {(unitPlan.viewSlidesButtons || []).map((button) => (
            <li><a href={resolveUnitPlanHref(button.href)}>{button.label}</a></li>
          ))}
        </ul>
      </SideCard>
    )}

    {(unitPlan.syllabusPoints || []).length > 0 && (
      <SideCard title="Syllabus Coverage">
        <ul class="link-list">
          {(unitPlan.syllabusPoints || []).map((point) => (
            <li><strong>{point.code}</strong> {point.topic}</li>
          ))}
        </ul>
      </SideCard>
    )}

    {(unitPlan.applications || []).length > 0 && (
      <SideCard title="Applications">
        <ul class="link-list">
          {(unitPlan.applications || []).map((application) => (
            <li>{application}</li>
          ))}
        </ul>
      </SideCard>
    )}
  </Fragment>
</UnitPlanShell>
