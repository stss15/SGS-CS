---
import { getCollection, render } from 'astro:content';
import ReaderShell from '../../../../layouts/ReaderShell.astro';
import { buildSyllabusRows } from '../../../../lib/ib2027-unit-index';
import {
  buildIb2027UnitBreadcrumbs,
  getIb2027LevelLabel,
  getIb2027UnitPlanData,
  getIb2027UnitStaticPaths
} from '../../../../lib/ib2027-routes';

type Level = 'sl' | 'hl';

interface TextbookPathProps {
  level: Level;
  unitNumber: number;
}

export async function getStaticPaths() {
  return getIb2027UnitStaticPaths();
}

const { level, unitNumber } = Astro.props as TextbookPathProps;
const unitPlan = await getIb2027UnitPlanData(level, unitNumber);
const syllabusRows = buildSyllabusRows(unitPlan);
const levelLabel = level.toUpperCase();
const textbookEntry = (
  await getCollection('ib-textbooks', ({ data }) => data.level === level && data.unitNumber === unitNumber)
)[0];
const textbookRendered = textbookEntry ? await render(textbookEntry) : null;
const TextbookContent = textbookRendered?.Content;
---

<ReaderShell
  title={`${levelLabel} Unit ${unitPlan.unitNumber}: ${unitPlan.unitName} Textbook Reader`}
  description={`IB Computer Science ${levelLabel} Unit ${unitPlan.unitNumber} textbook reader.`}
  activeSection="ib"
  breadcrumbs={buildIb2027UnitBreadcrumbs(level, unitPlan.unitNumber, 'Textbook')}
  storageKey="sgs-reader-textbook-settings-v1"
  kicker={`IB 2027 · ${getIb2027LevelLabel(level)} · Unit ${unitPlan.unitNumber}`}
  heading={`Unit ${unitPlan.unitNumber}: ${unitPlan.unitName}`}
  subtitle="Textbook Reader"
>
  {TextbookContent ? (
    <>
      <TextbookContent />
    </>
  ) : (
    <>
      <p class="reader-callout">
        <strong>This textbook space is ready.</strong> Full chapter content for this unit will be published here.
      </p>

      <h2>What You Will Learn In This Unit</h2>
      <ul>
        {syllabusRows.map((row) => (
          <li>
            <strong>{row.code}</strong> {row.topic}
          </li>
        ))}
      </ul>

      <h2>What You Should Be Able To Do</h2>
      <ul>
        {syllabusRows.map((row) => (
          <li>{row.expectedOutcome}</li>
        ))}
      </ul>

      <h2>How To Use This Reader</h2>
      <ul>
        <li>Use the <strong>Tools</strong> panel to adjust font, size, and theme.</li>
        <li>Turn on <strong>Paged reading</strong> when you want one section at a time.</li>
        <li>Use this page before and after lessons to consolidate understanding.</li>
      </ul>
    </>
  )}
</ReaderShell>
