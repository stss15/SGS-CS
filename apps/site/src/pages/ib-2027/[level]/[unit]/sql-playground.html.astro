---
/**
 * Redirect: /ib-2027/{sl,hl}/unit-N/sql-playground.html → /tools/sql-playground.html
 */

export function getStaticPaths() {
  const SL_UNITS = ['unit-1','unit-2','unit-3','unit-4','unit-5','unit-6','unit-7','unit-8','unit-9','unit-10','unit-11','unit-12'];
  const HL_UNITS = ['unit-1','unit-2','unit-3','unit-4','unit-5','unit-6','unit-7','unit-8','unit-9','unit-10','unit-11'];
  return [
    ...SL_UNITS.map(unit => ({ params: { level: 'sl', unit } })),
    ...HL_UNITS.map(unit => ({ params: { level: 'hl', unit } }))
  ];
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="0;url=/tools/sql-playground.html">
  <title>Redirecting</title>
  <link rel="canonical" href="/tools/sql-playground.html">
</head>
<body>
  <p>This page has moved. <a href="/tools/sql-playground.html">Go to SQL Playground</a>.</p>
</body>
</html>
