---
import LegacyEmbedFrame from '../../../../../components/LegacyEmbedFrame.astro';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { getIb2027UnitSlideHtml, getIb2027UnitSlideRoutes } from '@sgs/content-schema';
import { extractHtmlTitle } from '../../../../../lib/source-content';

interface SlidePageProps {
  html: string;
}

export async function getStaticPaths() {
  const routes = await getIb2027UnitSlideRoutes();

  return Promise.all(
    routes.map(async (route) => ({
      params: {
        level: route.level,
        unit: route.unitSegment,
        slide: route.slideSlug
      },
      props: {
        html: await getIb2027UnitSlideHtml(route.level, route.unitSegment, route.slideSlug)
      }
    }))
  );
}

const { html } = Astro.props as SlidePageProps;
const title = extractHtmlTitle(html, 'IB Slide Deck');
---

<BaseLayout title={title} description={title}>
  <section class="page-panel page-panel--flush">
    <LegacyEmbedFrame
      title={title}
      html={html}
      variant="slides"
      hideSelectors={['#back-btn', '#sg-logo', '.footer-text', '.standalone-nav']}
    />
  </section>
</BaseLayout>
