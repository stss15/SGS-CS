---
import { getCollection, render } from 'astro:content';
import ReaderShell from '../../../layouts/ReaderShell.astro';
import {
  getIbPointIndex,
  getIbThemeBreadcrumbs,
  getIbThemeOrThrow,
  getIbThemePrevNext,
  getIbThemeShell,
  getIbThemeStaticPaths,
  type IbThemeId,
  type IbThemeSection
} from '../../../lib/ib2027-syllabus';

interface ThemeTextbookPageProps {
  themeId: IbThemeId;
}

export function getStaticPaths() {
  return getIbThemeStaticPaths().map((entry) => ({
    params: {
      level: entry.params.theme
    },
    props: {
      themeId: entry.props.themeId
    }
  }));
}

const { themeId } = Astro.props as ThemeTextbookPageProps;
const theme = getIbThemeOrThrow(themeId);
const courseShell = getIbThemeShell(themeId);
const { prevLink, nextLink } = getIbThemePrevNext(themeId, Astro.url.pathname);

// ── Fetch and render all matching textbook entries ──────────
const entries = (
  await getCollection('ib-textbooks', ({ data }) =>
    data.subtopics.some((subtopic) => subtopic.code.toUpperCase().startsWith(theme.code))
  )
).sort((left, right) => {
  const leftCodes = left.data.subtopics.map((subtopic) => getIbPointIndex(theme, subtopic.code)).filter((index) => index >= 0);
  const rightCodes = right.data.subtopics.map((subtopic) => getIbPointIndex(theme, subtopic.code)).filter((index) => index >= 0);
  const leftIndex = leftCodes.length > 0 ? Math.min(...leftCodes) : Number.MAX_SAFE_INTEGER;
  const rightIndex = rightCodes.length > 0 ? Math.min(...rightCodes) : Number.MAX_SAFE_INTEGER;
  return leftIndex - rightIndex;
});

const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    rendered: await render(entry)
  }))
);

// ── Group entries by syllabus section (A1.1, A1.2, …) ──────
// Each entry is assigned to its earliest matching section so content is
// never duplicated across sections.
const assignedEntryIds = new Set<string>();

interface SectionBlock {
  section: IbThemeSection;
  anchorId: string;
  entries: typeof renderedEntries;
}

const sectionBlocks: SectionBlock[] = theme.sections.map((section) => {
  const matching = renderedEntries.filter(({ entry }) => {
    if (assignedEntryIds.has(entry.id)) return false;
    return entry.data.subtopics.some((subtopic) =>
      subtopic.code.toUpperCase().startsWith(section.code)
    );
  });

  matching.forEach(({ entry }) => assignedEntryIds.add(entry.id));

  return {
    section,
    anchorId: section.code.toLowerCase().replace(/\./g, '-'),
    entries: matching
  };
});

// Catch entries that didn't match any section (safety net)
const unassigned = renderedEntries.filter(({ entry }) => !assignedEntryIds.has(entry.id));
---

<ReaderShell
  title={`IB ${theme.code} Textbook - SGS Computer Science`}
  description={`${theme.code} ${theme.title} — textbook reading for IB Computer Science 2027.`}
  activeSection="ib"
  breadcrumbs={getIbThemeBreadcrumbs(themeId, 'Textbook')}
  kicker={`${theme.themeLabel} · ${theme.code}`}
  heading={`${theme.code} ${theme.title}`}
  subtitle={theme.guidingQuestion}
>
  {sectionBlocks.map(({ section, anchorId, entries: sectionEntries }) => (
    <section class="ib-textbook-section">
      <h2 id={anchorId}>
        <span class="ib-textbook-section__code">{section.code}</span>
        {section.title}
        {section.level === 'hl' && <span class="ib-textbook-hl-badge">HL</span>}
      </h2>
      <p class="ib-textbook-section__overview">{section.overview}</p>

      {sectionEntries.length > 0 ? (
        sectionEntries.map(({ entry, rendered }) => {
          const Content = rendered.Content;
          const levelLabel = entry.data.level === 'hl' ? 'HL extension' : '';
          return (
            <div class:list={['ib-textbook-entry', entry.data.level === 'hl' && 'ib-textbook-entry--hl']}>
              {levelLabel && <p class="ib-syllabus-kicker">{levelLabel}</p>}
              <Content />
            </div>
          );
        })
      ) : (
        <p class="ib-textbook-section__empty">Content for this section is being developed.</p>
      )}
    </section>
  ))}

  {unassigned.length > 0 && (
    <section class="ib-textbook-section">
      <h2>Additional material</h2>
      {unassigned.map(({ entry, rendered }) => {
        const Content = rendered.Content;
        return (
          <div class="ib-textbook-entry">
            <Content />
          </div>
        );
      })}
    </section>
  )}
</ReaderShell>
