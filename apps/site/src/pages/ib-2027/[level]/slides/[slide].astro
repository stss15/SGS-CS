---
import { getIb2027SlideAliasRoutes, getIb2027UnitSlideRoutes } from '@sgs/content-schema';

interface SlideAliasPageProps {
  destination: string;
}

export async function getStaticPaths() {
  const [routes, canonicalSlides] = await Promise.all([getIb2027SlideAliasRoutes(), getIb2027UnitSlideRoutes()]);

  return Promise.all(
    routes
      .map((route) => {
        const match = route.routePath.match(/^\/ib-2027\/(sl|hl)\/slides\/([^/]+)\.html$/);
        if (!match) {
          return null;
        }

        return {
          routePath: route.routePath,
          level: match[1],
          slide: match[2]
        };
      })
      .filter((route): route is { routePath: string; level: string; slide: string } => route !== null)
      .map(async (route) => ({
        params: {
          level: route.level,
          slide: route.slide
        },
        props: {
          destination:
            canonicalSlides.find(
              (slideRoute) => slideRoute.level === route.level && slideRoute.slideSlug === route.slide
            )?.routePath || `/ib-2027/${route.level}/index.html`
        }
      }))
  );
}

const { destination } = Astro.props as SlideAliasPageProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
    <link rel="canonical" href={destination} />
  </head>
  <body>
    <p>Redirecting to <a href={destination}>{destination}</a>.</p>
  </body>
</html>
