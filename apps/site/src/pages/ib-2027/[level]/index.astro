---
import type { IbCourseLevel } from '@sgs/content-schema';

export const getStaticPaths = async () => [
  { params: { level: 'sl' }, props: { level: 'sl' as const } },
  { params: { level: 'hl' }, props: { level: 'hl' as const } }
];

const { level } = Astro.props as { level: IbCourseLevel };
const label = level === 'hl' ? 'Higher Level' : 'Standard Level';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="0;url=/ib-2027/">
  <title>Redirecting — IB Computer Science {label}</title>
  <link rel="canonical" href="/ib-2027/">
</head>
<body>
  <p>This page has moved. <a href="/ib-2027/">Go to IB Computer Science</a>.</p>
</body>
</html>
