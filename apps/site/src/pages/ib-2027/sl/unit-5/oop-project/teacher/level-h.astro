---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import { getIbSlUnit5OopProjectPage } from '@sgs/content-schema';

const page = await getIbSlUnit5OopProjectPage('teacher/level-h');
---

<BaseLayout
  title={page.title}
  description={page.description || 'SL Unit 5 OOP Project page'}
  activeSection={page.activeSection}
  breadcrumbs={page.breadcrumbs}
  extraStyles={page.extraStyles}
>
  <div set:html={page.bodyHtml} />
</BaseLayout>
