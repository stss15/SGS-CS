---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { getIbSlUnit5Scenario } from '@sgs/content-schema';

const page = await getIbSlUnit5Scenario('scenario-1-animals');
---

<BaseLayout
  title={page.title}
  description={page.description || 'OOP Scenario 1: Animal Kingdom'}
  activeSection={page.activeSection}
  breadcrumbs={page.breadcrumbs}
  extraStyles={page.extraStyles}
>
  <div set:html={page.bodyHtml} />
</BaseLayout>
