---
import HeroPanel from '../../../components/HeroPanel.astro';
import TopicSectionGrid from '../../../components/TopicSectionGrid.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getIbSlCurriculumIndex } from '@sgs/content-schema';

const page = await getIbSlCurriculumIndex();
---

<BaseLayout
  title={page.title}
  description={page.description || 'IB Computer Science Standard Level units for first assessment 2027.'}
  activeSection={page.activeSection}
  breadcrumbs={page.breadcrumbs}
>
  <HeroPanel
    eyebrow="IB 2027"
    title={page.hero.title}
    subtitle={page.hero.subtitle}
  >
    <TopicSectionGrid sections={page.sections} />
  </HeroPanel>
</BaseLayout>
