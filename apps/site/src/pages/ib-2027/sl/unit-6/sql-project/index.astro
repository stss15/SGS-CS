---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import IbProjectSequencePage from '../../../../../components/IbProjectSequencePage.astro';
import { getProjectStep, sqlProjectSequence } from '../../../../../lib/ib-project-content';

const currentStep = getProjectStep(sqlProjectSequence, '');
---

<BaseLayout
  title={`${currentStep.title} | ${sqlProjectSequence.projectTitle}`}
  description={currentStep.intro}
  activeSection="ib"
  extraStyles={['css/ib-project-sequence.css']}
>
  <IbProjectSequencePage sequence={sqlProjectSequence} currentSlug="" />
</BaseLayout>
