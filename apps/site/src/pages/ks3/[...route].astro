---
import LegacyEmbedFrame from '../../components/LegacyEmbedFrame.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getKs3LegacyRouteHtml, getKs3LegacyRoutes } from '@sgs/content-schema';
import { isKs3WorkspaceRoute } from '../../lib/legacy-route-classification';
import { extractHtmlTitle } from '../../lib/source-content';

interface Ks3LegacyPageProps {
  html: string;
  routePath: string;
}

export async function getStaticPaths() {
  const routes = await getKs3LegacyRoutes();

  return Promise.all(
    routes.map(async (route) => ({
      params: {
        route: route.routePath.replace(/^\/ks3\//, '')
      },
      props: {
        html: await getKs3LegacyRouteHtml(route.routePath),
        routePath: route.routePath
      }
    }))
  );
}

const { html, routePath } = Astro.props as Ks3LegacyPageProps;
const title = extractHtmlTitle(html, 'KS3 Resource');
const variant = isKs3WorkspaceRoute(routePath) ? 'workspace' : 'document';
---

<BaseLayout title={title} description={title}>
  <section class="page-panel page-panel--flush">
    <LegacyEmbedFrame
      title={title}
      html={html}
      variant={variant}
      hideSelectors={['#back-btn', '#sg-logo', '.standalone-nav', '.nav-overlay']}
    />
  </section>
</BaseLayout>
