---
import BaseLayout from '../layouts/BaseLayout.astro';

interface MockAreaItem {
  label: string;
  meta: string;
}

interface MockArea {
  id: string;
  label: string;
  intro: string;
  items: MockAreaItem[];
}

interface MockUnit {
  id: string;
  code: string;
  title: string;
  strand: string;
  summary: string;
  objectives: string[];
  areas: MockArea[];
}

interface MockCourse {
  id: string;
  stage: string;
  label: string;
  overviewTitle: string;
  overviewSummary: string;
  overviewPoints: string[];
  principles: string[];
  clickReduction: string;
  defaultUnit: string;
  units: MockUnit[];
}

const getSuggestedRoute = (unit: MockUnit) => {
  const area = unit.areas.find((entry) => entry.id !== 'overview');
  const item = area?.items[0];
  return item ? `${area.label}: ${item.label}` : 'Unit overview';
};

const buildAreas = (config: {
  unitLabel: string;
  slides: string[];
  activities: string[];
  assessments: string[];
  homework: string[];
  independent: string[];
  revision: string[];
  textbook: string[];
}): MockArea[] => [
  {
    id: 'overview',
    label: 'Overview',
    intro: `The unit page opens with a short overview, the big question, and the learning objectives for ${config.unitLabel}.`,
    items: [
      { label: 'Unit overview first', meta: 'Always the landing state' },
      { label: 'Learning objectives visible', meta: 'No extra click to find outcomes' },
      { label: 'Breadcrumb + unit context retained', meta: 'Easy exit back to course view' }
    ]
  },
  {
    id: 'textbook',
    label: 'Textbook',
    intro: `Textbook chapters sit in the main panel, not buried in another layer of unit buttons.`,
    items: config.textbook.map((item) => ({ label: item, meta: 'Chapter link' }))
  },
  {
    id: 'slides',
    label: 'Slide Decks',
    intro: `Slide decks stay grouped by subtopic, but the subtopic links are shown in-page instead of inside the sidebar.`,
    items: config.slides.map((item) => ({ label: item, meta: 'Deck link' }))
  },
  {
    id: 'activities',
    label: 'Student Activities',
    intro: `Interactive tasks and worksheets are listed as a clean sequence with short labels and one-sentence context.`,
    items: config.activities.map((item) => ({ label: item, meta: 'Activity link' }))
  },
  {
    id: 'assessment',
    label: 'Assessment',
    intro: `Assessment stays close to the unit instead of being pushed into a separate branch of the site.`,
    items: config.assessments.map((item) => ({ label: item, meta: 'Assessment link' }))
  },
  {
    id: 'homework',
    label: 'Homework',
    intro: `Homework is treated as one unit area, with direct hand-ins or retrieval tasks under it.`,
    items: config.homework.map((item) => ({ label: item, meta: 'Homework task' }))
  },
  {
    id: 'independent',
    label: 'Independent Tasks',
    intro: `Independent work is surfaced as an optional branch rather than another hidden page tree.`,
    items: config.independent.map((item) => ({ label: item, meta: 'Independent task' }))
  },
  {
    id: 'revision',
    label: 'Revision',
    intro: `Revision tools remain available from every unit without sending students back out to the course home.`,
    items: config.revision.map((item) => ({ label: item, meta: 'Revision tool' }))
  }
];

