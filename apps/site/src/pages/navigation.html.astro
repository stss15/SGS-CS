const defaultCourseId = 'igcse';
const navigationData = JSON.stringify(courses);
---

<BaseLayout
  title="Navigation Mockup | SGS Education"
  description="Mockup for a flatter SGS course navigation model with course overview pages, sticky side navigation, and unit-overview-first browsing."
  breadcrumbs={[
    { label: 'Home', href: '/index.html' },
    { label: 'Navigation Mockup' }
  ]}
  mainClass="navigation-mockup-page"
  bodyClass="navigation-mockup-body"
>
  <section class="navigation-lab">
    <header class="navigation-intro">
      <div class="navigation-intro__copy">
        <p class="navigation-kicker">Mockup</p>
        <h1>Flatter course navigation with a persistent unit rail</h1>
        <p class="navigation-summary">
          This mockup treats each key stage as one course section first. Students land on a course overview, keep the unit list
          visible on the left, and open deeper resources inside the current unit instead of stepping through multiple button pages.
        </p>
      </div>
      <div class="navigation-intro__note">
        <p class="navigation-note-label">What changes</p>
        <ul>
          <li>Course overview becomes the landing page</li>
          <li>Unit overview and learning objectives are always the first view</li>
          <li>Subtopic links live in the main panel, not in a sprawling nested menu</li>
          <li>Deep pages should always link back to the unit and the course explicitly</li>
        </ul>
      </div>
    </header>

    <div class="navigation-shell" data-navigation-shell>
      <aside class="navigation-sidebar">
        <div class="navigation-sidebar__block">
          <p class="navigation-sidebar__label">Course</p>
          <div class="course-switcher" role="tablist" aria-label="Mock course selector">
            {courses.map((course) => (
              <button
                type="button"
                class:list={['course-switcher__button', course.id === defaultCourseId && 'is-active']}
                data-course-toggle={course.id}
                role="tab"
                aria-selected={course.id === defaultCourseId ? 'true' : 'false'}
              >
                <span>{course.stage}</span>
                <strong>{course.label}</strong>
              </button>
            ))}
          </div>
        </div>

        <div class="navigation-sidebar__block">
          <div class="sidebar-heading-row">
            <div>
              <p class="navigation-sidebar__label">Navigator</p>
              <h2>One open unit at a time</h2>
            </div>
            <p class="sidebar-hint">Deeper links appear in the main panel</p>
          </div>

          {courses.map((course) => (
            <div class="unit-rail" data-course-tree={course.id} hidden={course.id !== defaultCourseId}>
              {course.units.map((unit) => (
                <details
                  class="unit-accordion"
                  data-unit-accordion
                  data-course={course.id}
                  data-unit={unit.id}
                  open={course.defaultUnit === unit.id}
                >
                  <summary>
                    <span class="unit-accordion__code">{unit.code}</span>
                    <span class="unit-accordion__copy">
                      <strong>{unit.title}</strong>
                      <small>{unit.strand}</small>
                    </span>
                    <span class="unit-accordion__count">{unit.areas.length}</span>
                  </summary>
                  <div class="unit-accordion__links">
                    {unit.areas.map((area) => (
                      <button
                        type="button"
                        class="area-link"
                        data-area-toggle={area.id}
                        data-course={course.id}
                        data-unit={unit.id}
                      >
                        {area.label}
                      </button>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          ))}
        </div>
      </aside>

      <section class="navigation-workspace">
        {courses.map((course) => (
          <section class="course-panel" data-course-panel={course.id} hidden={course.id !== defaultCourseId}>
            <div class="course-overview">
              <div class="course-overview__headline">
                <p class="navigation-kicker">{course.stage}</p>
                <h2>{course.overviewTitle}</h2>
                <p>{course.overviewSummary}</p>
              </div>
              <div class="course-overview__metrics">
                <div>
                  <span>Scale rule</span>
                  <strong>{course.clickReduction}</strong>
                </div>
                <div>
                  <span>Sidebar rule</span>
                  <strong>Only the active unit is expanded</strong>
                </div>
                <div>
                  <span>Main-panel rule</span>
                  <strong>Subtopics live here, not in nested side menus</strong>
                </div>
              </div>
              <div class="course-overview__columns">
                <div>
                  <h3>Course overview content</h3>
                  <ul>
                    {course.overviewPoints.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3>Navigation principles</h3>
                  <ul>
                    {course.principles.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            {course.units.map((unit) => (
              <article
                class="unit-panel"
                data-unit-panel
                data-course={course.id}
                data-unit={unit.id}
                hidden={course.defaultUnit !== unit.id}
              >
                <header class="unit-panel__header">
                  <div>
                    <p class="unit-panel__eyebrow">{unit.code} · {unit.strand}</p>
                    <h2>{unit.title}</h2>
                    <p>{unit.summary}</p>
                  </div>
                  <div class="path-preview">
                    <span class="path-preview__label">Current path</span>
                    <strong data-path-preview>{course.label} / {unit.code} / Overview</strong>
                  </div>
                </header>

                <div class="unit-panel__core">
                  <section>
                    <h3>Unit overview</h3>
                    <p>
                      The student lands here first. This pane stays stable while the lower section switches between textbook,
                      slide decks, activities, assessment, homework, independent tasks, and revision.
                    </p>
                  </section>
                  <section>
                    <h3>Learning objectives</h3>
                    <ul>
                      {unit.objectives.map((objective) => (
                        <li>{objective}</li>
                      ))}
                    </ul>
                  </section>
                </div>

                <div class="unit-panel__routing">
                  <section class="routing-card">
                    <span class="routing-card__label">Suggested next step</span>
                    <strong>{getSuggestedRoute(unit)}</strong>
                    <p>Students should always see one clear starting point after the overview instead of a wall of equal buttons.</p>
                  </section>
                  <section class="routing-card">
                    <span class="routing-card__label">Navigation contract</span>
                    <ul>
                      <li>Every deep page links back to {unit.code}</li>
                      <li>Every unit links back to {course.label}</li>
                      <li>No <code>history.back()</code> dependence and no forced new tabs</li>
                    </ul>
                  </section>
                </div>

                <nav class="area-tabbar" aria-label={`${unit.title} navigation`}>
                  {unit.areas.map((area) => (
                    <button
                      type="button"
                      class:list={['area-tab', area.id === 'overview' && 'is-active']}
                      data-area-toggle={area.id}
                      data-course={course.id}
                      data-unit={unit.id}
                    >
                      {area.label}
                    </button>
                  ))}
                </nav>

                {unit.areas.map((area) => (
                  <section
                    class="area-panel"
                    data-area-panel
                    data-course={course.id}
                    data-unit={unit.id}
                    data-area={area.id}
                    hidden={area.id !== 'overview'}
                  >
                    <div class="area-panel__intro">
                      <h3>{area.label}</h3>
                      <p>{area.intro}</p>
                    </div>
                    <ol class="area-panel__list">
                      {area.items.map((item) => (
                        <li>
                          <span>{item.label}</span>
                          <small>{item.meta}</small>
                        </li>
                      ))}
                    </ol>
                  </section>
                ))}
              </article>
            ))}
          </section>
        ))}
      </section>
    </div>
  </section>

  <script type="application/json" id="navigation-mockup-data" set:html={navigationData} is:inline></script>
  <script is:inline>
    const dataElement = document.getElementById('navigation-mockup-data');
    const courses = dataElement ? JSON.parse(dataElement.textContent || '[]') : [];
    const state = Object.fromEntries(
      courses.map((course) => [course.id, { unitId: course.defaultUnit, areaId: 'overview' }])
    );
    let activeCourse = 'igcse';

    const render = () => {
      const currentCourse = courses.find((course) => course.id === activeCourse);
      const currentUnit = currentCourse?.units.find((unit) => unit.id === state[activeCourse]?.unitId);
      const currentArea = currentUnit?.areas.find((area) => area.id === state[activeCourse]?.areaId);

      document.querySelectorAll('[data-course-toggle]').forEach((button) => {
        const isActive = button.dataset.courseToggle === activeCourse;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-selected', String(isActive));
      });

      document.querySelectorAll('[data-course-tree]').forEach((tree) => {
        tree.hidden = tree.dataset.courseTree !== activeCourse;
      });

      document.querySelectorAll('[data-course-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.coursePanel !== activeCourse;
      });

      document.querySelectorAll('[data-unit-accordion]').forEach((accordion) => {
        const matchesCourse = accordion.dataset.course === activeCourse;
        const matchesUnit = accordion.dataset.unit === state[activeCourse]?.unitId;
        accordion.open = matchesCourse && matchesUnit;
      });

      document.querySelectorAll('[data-unit-panel]').forEach((panel) => {
        const isVisible = panel.dataset.course === activeCourse && panel.dataset.unit === state[activeCourse]?.unitId;
        panel.hidden = !isVisible;
      });

      document.querySelectorAll('[data-area-toggle]').forEach((button) => {
        const isActive =
          button.dataset.course === activeCourse &&
          button.dataset.unit === state[activeCourse]?.unitId &&
          button.dataset.areaToggle === state[activeCourse]?.areaId;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });

      document.querySelectorAll('[data-area-panel]').forEach((panel) => {
        const isVisible =
          panel.dataset.course === activeCourse &&
          panel.dataset.unit === state[activeCourse]?.unitId &&
          panel.dataset.area === state[activeCourse]?.areaId;
        panel.hidden = !isVisible;
      });

      document.querySelectorAll('[data-path-preview]').forEach((node) => {
        if (currentCourse && currentUnit && currentArea) {
          node.textContent = `${currentCourse.label} / ${currentUnit.code} / ${currentArea.label}`;
        }
      });
    };

    document.querySelectorAll('[data-course-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const nextCourse = button.dataset.courseToggle;
        if (!nextCourse) return;
        activeCourse = nextCourse;
        render();
      });
    });

    document.querySelectorAll('[data-unit-accordion]').forEach((accordion) => {
      accordion.addEventListener('toggle', () => {
        const tree = accordion.closest('[data-course-tree]');

        if (tree?.hidden) {
          return;
        }

        if (!accordion.open) {
          requestAnimationFrame(() => {
            accordion.open = true;
          });
          return;
        }

        const courseId = accordion.dataset.course;
        const unitId = accordion.dataset.unit;

        if (!courseId || !unitId) return;

        activeCourse = courseId;
        state[courseId].unitId = unitId;
        state[courseId].areaId = 'overview';
        render();
      });
    });

    document.querySelectorAll('[data-area-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const courseId = button.dataset.course;
        const unitId = button.dataset.unit;
        const areaId = button.dataset.areaToggle;

        if (!courseId || !unitId || !areaId) return;

        activeCourse = courseId;
        state[courseId].unitId = unitId;
        state[courseId].areaId = areaId;
        render();
      });
    });

    render();
  </script>

