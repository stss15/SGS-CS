---
interface Props {
  title: string;
  html: string;
  variant?: 'document' | 'workspace' | 'slides';
  hideSelectors?: string[];
  routePath?: string;
}

const {
  title,
  html,
  variant = 'document',
  hideSelectors = ['#back-btn', '#sg-logo', '.standalone-nav', '.nav-overlay'],
  routePath
} = Astro.props as Props;

const frameId = Astro.url.pathname.replace(/[^a-z0-9]+/gi, '-').replace(/^-+|-+$/g, '') || 'legacy-frame';

const resolveBaseHref = (sourcePath: string) => {
  const normalizedPath = sourcePath.startsWith('/') ? sourcePath : `/${sourcePath}`;

  if (/\/index\.html$/i.test(normalizedPath)) {
    return normalizedPath.replace(/index\.html$/i, '');
  }

  if (/\/[^/]+\.[a-z0-9]+$/i.test(normalizedPath)) {
    return normalizedPath.replace(/[^/]+$/i, '');
  }

  return normalizedPath.endsWith('/') ? normalizedPath : `${normalizedPath}/`;
};

const fallbackSourcePath = Astro.url.pathname.endsWith('/')
  ? `${Astro.url.pathname}index.html`
  : Astro.url.pathname;
const baseHref = resolveBaseHref(routePath || fallbackSourcePath);

const resizeScript = `
  <script>
    (() => {
      const cleanupLegacyChrome = () => {
        const removeSelectors = [
          '.site-header',
          '.main-header',
          '.breadcrumb-nav',
          '.feedback-modals',
          '.site-feedback',
          '.feedback-trigger',
          '[data-feedback-open]',
          'body > footer',
          '#sgs-auth-overlay',
          '.sgs-auth-overlay',
          'link[href*="/css/auth-gate.css"]',
          'script[src*="/__/firebase/"]',
          'script[src*="/js/auth-gate.js"]'
        ];

        removeSelectors.forEach((selector) => {
          document.querySelectorAll(selector).forEach((node) => node.remove());
        });

        document.documentElement.classList.remove('auth-pending');
        document.documentElement.classList.add('auth-ready');
        document.body.classList.remove('sgs-auth-locked');
        document.body.style.visibility = 'visible';
        document.body.style.overflow = '';

        const placeholderLinks = [
          'a[href="/coming-soon.html"]',
          'a[href="coming-soon.html"]',
          'a[href="./coming-soon.html"]'
        ];

        placeholderLinks.forEach((selector) => {
          document.querySelectorAll(selector).forEach((node) => {
            const removableParent =
              node.closest('.resource-btn, .activity-card, .feature-card, .feature-link, li, article') || node;
            removableParent.remove();
          });
        });
      };

      const sendHeight = () => {
        const height = Math.max(
          document.documentElement.scrollHeight,
          document.body ? document.body.scrollHeight : 0,
          document.documentElement.offsetHeight,
          document.body ? document.body.offsetHeight : 0
        );
        parent.postMessage({ type: 'sgs-legacy-frame-height', id: '${frameId}', height }, '*');
      };

      window.addEventListener('load', () => {
        cleanupLegacyChrome();
        sendHeight();
        setTimeout(sendHeight, 250);
      });
      window.addEventListener('resize', sendHeight);

      if ('ResizeObserver' in window) {
        new ResizeObserver(sendHeight).observe(document.documentElement);
      }

      setInterval(sendHeight, 1200);
    })();
  <\/script>
`;

const injectedStyles = `
  <style>
    html.auth-pending body,
    html.auth-ready body {
      visibility: visible !important;
    }
    ${hideSelectors.join(', ')} { display: none !important; }
    .site-header,
    .main-header,
    .breadcrumb-nav,
    .feedback-modals,
    .site-feedback,
    .feedback-trigger,
    [data-feedback-open],
    body > footer,
    .sgs-auth-overlay,
    #sgs-auth-overlay {
      display: none !important;
    }
    html, body { margin: 0 !important; }
  </style>
`;

const injectBeforeLastTag = (documentHtml: string, tagName: string, injection: string) => {
  const closingTag = `</${tagName.toLowerCase()}>`;
  const lowerDocumentHtml = documentHtml.toLowerCase();
  const insertAt = lowerDocumentHtml.lastIndexOf(closingTag);

  if (insertAt === -1) {
    return `${documentHtml}${injection}`;
  }

  return `${documentHtml.slice(0, insertAt)}${injection}${documentHtml.slice(insertAt)}`;
};

const preAddImgDecoding = (documentHtml: string): string =>
  documentHtml.replace(/<img\b(?![^>]*\bdecoding\b)/gi, '<img decoding="async"');

const stripEmbeddedAuthGate = (documentHtml: string): string =>
  documentHtml
    .replace(/<!--\s*data-sgs-auth-gate\s*-->\s*/gi, '')
    .replace(/<link\b[^>]*href=["'][^"']*\/css\/auth-gate\.css[^"']*["'][^>]*>\s*/gi, '')
    .replace(
      /<script\b[^>]*>\s*document\.documentElement\.classList\.add\((['"])auth-pending\1\);\s*<\/script>\s*/gi,
      ''
    )
    .replace(/<script\b[^>]*src=["'][^"']*\/__\/firebase\/[^"']*["'][^>]*><\/script>\s*/gi, '')
    .replace(/<script\b[^>]*src=["'][^"']*\/js\/auth-gate\.js[^"']*["'][^>]*><\/script>\s*/gi, '');

const buildSrcdoc = (documentHtml: string) => {
  const safeHtml = preAddImgDecoding(stripEmbeddedAuthGate(documentHtml));

  if (/<head\b[^>]*>/i.test(safeHtml)) {
    const documentWithHead = safeHtml.replace(
      /<head\b([^>]*)>/i,
      `<head$1><base href="${baseHref}" target="_top">${injectedStyles}`
    );
    return injectBeforeLastTag(documentWithHead, 'body', resizeScript);
  }

  return `<!doctype html><html lang="en"><head><meta charset="utf-8" /><base href="${baseHref}" target="_top">${injectedStyles}</head><body>${safeHtml}${resizeScript}</body></html>`;
};

const srcdoc = buildSrcdoc(html);
const showFullscreen = variant === 'slides';
---

<section class:list={['legacy-frame', `legacy-frame--${variant}`]}>
  {showFullscreen && (
    <div class="legacy-frame__actions">
      <button type="button" class="legacy-frame__fullscreen" data-legacy-frame-fullscreen={frameId}>
        Present Fullscreen
      </button>
    </div>
  )}

  <iframe
    title={title}
    class="legacy-frame__iframe"
    data-legacy-frame-id={frameId}
    srcdoc={srcdoc}
    loading="eager"
    allowfullscreen
  ></iframe>
</section>

<script is:inline data-frame-id={frameId}>
  (() => {
    const activeScript = document.currentScript;
    const activeFrameId = activeScript?.getAttribute('data-frame-id');
    if (!activeFrameId) return;

    const selector = `iframe[data-legacy-frame-id="${activeFrameId}"]`;
    const frame = document.querySelector(selector);
    if (!frame) return;
    let lastHeight = 0;

    const fullscreenButton = document.querySelector(`[data-legacy-frame-fullscreen="${activeFrameId}"]`);
    if (fullscreenButton) {
      fullscreenButton.addEventListener('click', async () => {
        try {
          await frame.requestFullscreen();
        } catch {
          // Ignore fullscreen failures triggered by browser policy.
        }
      });
    }

    window.addEventListener('message', (event) => {
      if (!event.data || event.data.type !== 'sgs-legacy-frame-height' || event.data.id !== activeFrameId) {
        return;
      }

      const nextHeight = Number(event.data.height);
      if (!Number.isFinite(nextHeight) || nextHeight <= 0) {
        return;
      }

      if (!frame.closest('.legacy-frame--document')) {
        return;
      }

      const frameHeight = Math.max(360, Math.ceil(nextHeight));
      if (Math.abs(frameHeight - lastHeight) < 2) {
        return;
      }

      lastHeight = frameHeight;
      frame.style.height = `${frameHeight}px`;
    });
  })();
</script>
