---
import type { UnitIndexFrontmatter, UnitPlanFrontmatter } from '@sgs/content-schema';
import CompactList from './CompactList.astro';
import CurriculumShell from '../layouts/CurriculumShell.astro';
import { buildSyllabusRows, getFlashcardsHref } from '../lib/ib2027-unit-index';
import { rewriteIbCourseHref } from '../lib/course-links';
import {
  buildIb2027UnitBreadcrumbs,
  getIb2027LevelLabel,
  normalizeIb2027Level
} from '../lib/ib2027-routes';

interface Props {
  page: UnitIndexFrontmatter;
  unitPlan: UnitPlanFrontmatter;
}

const { page, unitPlan } = Astro.props;

const syllabusRows = buildSyllabusRows(unitPlan);
const flashcardsHref = getFlashcardsHref(page.cards);
const slides = page.resources || [];
const studentActivities = page.studentActivitiesResources || [];

const formatList = (items: string[]): string => {
  if (items.length === 0) {
    return '';
  }

  if (items.length === 1) {
    return items[0];
  }

  if (items.length === 2) {
    return `${items[0]} and ${items[1]}`;
  }

  return `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`;
};

const subTopicCodes = syllabusRows.map((row) => row.code);
const subTopicNames = syllabusRows.map((row) => row.topic);
const unitOverviewQuestion = unitPlan.introduction?.bigQuestion || `What will you learn in ${unitPlan.unitName}?`;
const unitOverviewLead =
  subTopicCodes.length > 0
    ? `This unit covers ${subTopicCodes.length} IB Computer Science sub-topics: ${formatList(subTopicCodes)}.`
    : 'This unit covers IB Computer Science syllabus content for this part of the course.';
const unitOverviewFocus =
  subTopicNames.length > 0
    ? `The focus areas are ${formatList(subTopicNames)}.`
    : 'You will build understanding and confidence with the key ideas in this unit.';
const level = normalizeIb2027Level(unitPlan.level);
const breadcrumbs = buildIb2027UnitBreadcrumbs(level, unitPlan.unitNumber);
const unitBasePath = `/ib-2027/${level}/unit-${unitPlan.unitNumber}`;

const resolveUnitHref = (href: string) =>
  rewriteIbCourseHref(
    level,
    unitPlan.unitNumber,
    href.startsWith('/') ? href : `${unitBasePath}/${href.replace(/^\.?\//, '')}`
  );

const toCompactItems = (resources: typeof slides, fallbackMeta: string) =>
  resources
    .filter((resource) => resource.href && !/\/coming-soon(?:\.html)?$/i.test(resource.href))
    .map((resource) => ({
      label: resource.number ? `${resource.number} ${resource.name}` : resource.name,
      href: resolveUnitHref(resource.href),
      meta: resource.type || fallbackMeta
    }));

const teacherItems = toCompactItems(page.resourcesSecondary || [], 'Additional resource');
const revisionItems = /\/coming-soon(?:\.html)?$/i.test(flashcardsHref)
  ? []
  : [{ label: 'Flashcards', href: resolveUnitHref(flashcardsHref), meta: 'Revision' }];

const resourceSections = [
  {
    title: 'Textbook',
    summary: 'Open the reading view without leaving the unit workspace.',
    items: [{ label: 'Open unit textbook', href: `${unitBasePath}/textbook.html`, meta: 'Reading mode' }]
  },
  {
    title: 'Slide Decks',
    summary: 'Subtopic decks stay inside the same unit shell.',
    items: toCompactItems(slides, 'Slide deck')
  },
  {
    title: 'Activities',
    summary: 'Worksheets, projects, and practical work for the unit.',
    items: toCompactItems(studentActivities, 'Activity')
  },
  {
    title: 'Revision',
    summary: 'Review and retrieval resources for the unit.',
    items: revisionItems
  },
  {
    title: 'Teacher & Extension',
    summary: 'Teacher-facing and supplementary material when it exists.',
    items: teacherItems
  }
].filter((section) => section.items.length > 0);
---

<CurriculumShell
  title={page.title}
  description={page.description || 'IB unit resources.'}
  activeSection="ib"
  breadcrumbs={breadcrumbs}
  eyebrow={`IB CS · ${getIb2027LevelLabel(level)}`}
  heroTitle={page.hero.title}
  heroSubtitle={page.hero.subtitle}
>
  <div class="page-stack">
    <div class="spec-grid">
      <section class="spec-card">
        <h2>Unit overview</h2>
        <p><strong>{unitOverviewQuestion}</strong></p>
        <p>{unitOverviewLead}</p>
        <p>{unitOverviewFocus}</p>
      </section>

      <section class="spec-card">
        <h2>Coverage</h2>
        <ul>
          {subTopicCodes.map((code, index) => (
            <li>
              <strong>{code}</strong> {subTopicNames[index]}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="page-panel">
      <h2>Objectives and outcomes</h2>

      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Code</th>
              <th scope="col">What You Will Learn</th>
              <th scope="col">What You Should Be Able To Do</th>
            </tr>
          </thead>
          <tbody>
            {syllabusRows.map((row) => (
              <tr>
                <td><strong>{row.code}</strong></td>
                <td>{row.topic}</td>
                <td>{row.expectedOutcome}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <CompactList sections={resourceSections} />
  </div>
</CurriculumShell>
