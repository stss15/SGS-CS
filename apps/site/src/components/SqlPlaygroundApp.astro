<section class="sql-playground-route">
  <div class="sql-playground-page" id="sql-playground-page">
    <header class="playground-topbar">
      <div class="topbar-brand">
        <h1>SQL Playground</h1>
        <p class="workspace-pill" id="workspace-pill" aria-live="polite"></p>
      </div>
      <div class="topbar-actions">
        <input
          id="import-json-input"
          type="file"
          accept=".json,application/json"
          hidden
        />
        <label class="workspace-select" for="dataset-select">
          <span class="sr-only">Select database</span>
          <select id="dataset-select" name="dataset"></select>
        </label>
        <button type="button" class="secondary-button" id="import-json-button">Open</button>
        <button type="button" class="secondary-button" id="export-json-button">Export</button>
      </div>
    </header>

    <div class="playground-shell" id="playground-shell">
      <aside class="sidebar-panel" aria-labelledby="tables-heading">
        <div class="sidebar-header">
          <div class="panel-title-group">
            <p class="section-kicker">Explorer</p>
            <h2 id="tables-heading">Tables</h2>
          </div>
          <span class="sidebar-meta" id="table-count"></span>
        </div>
        <div class="table-list" id="table-list"></div>
      </aside>

      <div
        class="pane-splitter pane-splitter-vertical"
        id="sidebar-splitter"
        role="separator"
        aria-label="Resize tables panel"
        aria-orientation="vertical"
      ></div>

      <section class="workspace-panel" id="workspace-panel">
        <section class="editor-panel" aria-labelledby="editor-heading">
          <div class="panel-chrome">
            <div class="panel-title-group">
              <h2 id="editor-heading">SQL</h2>
              <span class="shortcut-badge">Ctrl/Cmd + Enter</span>
            </div>
          </div>

          <div class="editor-stage">
            <div class="editor-shell" id="editor-shell">
              <pre class="editor-highlight" id="editor-highlight" aria-hidden="true"><code class="language-sql" id="editor-highlight-code"></code></pre>
              <textarea
                id="query-input"
                spellcheck="false"
                placeholder="Write SQL here..."
                aria-label="SQL query input"
              ></textarea>
              <div class="suggestions" id="query-suggestions" hidden></div>
            </div>
            <button type="button" class="run-fab" id="run-query-button">Run</button>
          </div>

          <div class="editor-footer">
            <div class="status-inline" id="editor-status" aria-live="polite"></div>
          </div>
        </section>

        <div
          class="pane-splitter pane-splitter-horizontal"
          id="results-splitter"
          role="separator"
          aria-label="Resize editor and output panels"
          aria-orientation="horizontal"
        ></div>

        <section class="inspector-panel" aria-labelledby="inspector-heading">
          <div class="panel-chrome inspector-chrome">
            <div class="panel-title-group">
              <h2 id="inspector-heading">Inspect</h2>
              <div class="inspector-tabs" role="tablist" aria-label="Workspace panels">
                <button
                  type="button"
                  class="inspector-tab"
                  id="inspector-tab-results"
                  data-inspector-view="results"
                  role="tab"
                  aria-controls="inspector-view-results"
                  aria-selected="true"
                >
                  Results
                </button>
                <button
                  type="button"
                  class="inspector-tab"
                  id="inspector-tab-schema"
                  data-inspector-view="schema"
                  role="tab"
                  aria-controls="inspector-view-schema"
                  aria-selected="false"
                >
                  Schema
                </button>
                <button
                  type="button"
                  class="inspector-tab"
                  id="inspector-tab-erd"
                  data-inspector-view="erd"
                  role="tab"
                  aria-controls="inspector-view-erd"
                  aria-selected="false"
                >
                  ERD
                </button>
              </div>
            </div>
            <div class="results-meta" id="results-meta" aria-live="polite"></div>
          </div>

          <div class="inspector-body">
            <div class="inspector-view" id="inspector-view-results" role="tabpanel" aria-labelledby="inspector-tab-results">
              <div class="results-output" id="results-output">
                <div class="empty-state">
                  <p>Initialising SQL engine...</p>
                </div>
              </div>
            </div>

            <div
              class="inspector-view"
              id="inspector-view-schema"
              role="tabpanel"
              aria-labelledby="inspector-tab-schema"
              hidden
            >
              <div class="schema-table-list" id="schema-table-list"></div>
            </div>

            <div
              class="inspector-view inspector-view-erd"
              id="inspector-view-erd"
              role="tabpanel"
              aria-labelledby="inspector-tab-erd"
              hidden
            >
              <div class="erd-stage" id="erd-stage"></div>
              <div class="relationship-list" id="relationship-list"></div>
            </div>
          </div>
        </section>
      </section>
    </div>
  </div>
</section>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/sql-wasm.js" defer></script>
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/sql-formatter/12.2.3/sql-formatter.min.js"
  defer
></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" defer></script>
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-sql.min.js"
  defer
></script>
<script is:inline type="module" src="/js/tool-sql-playground.js"></script>
