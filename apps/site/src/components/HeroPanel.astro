---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  pills?: string[];
  variant?: 'feature' | 'compact';
  heroImage?: string;
  heroImageAlt?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  pills = [],
  variant = 'feature',
  heroImage,
  heroImageAlt = title
} = Astro.props;
---

<section class:list={['hero', `hero--${variant}`]}>
  <div class="hero-copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {heroImage ? (
      <img src={heroImage} alt={heroImageAlt} class="hero-logo" loading="eager" fetchpriority="high" />
    ) : (
      <h1 class="hero-title">{title}</h1>
    )}
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {pills.length > 0 && (
      <div class="pill-info hero-pill-row">
        {pills.map((pill) => (
          <span class="pill">{pill}</span>
        ))}
      </div>
    )}
  </div>
  <div class="hero-content">
    <slot />
  </div>
</section>
