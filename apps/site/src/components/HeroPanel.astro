---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  pills?: string[];
}

const {
  eyebrow,
  title,
  subtitle,
  pills = []
} = Astro.props;
---

<section class="hero">
  <div class="hero-copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {pills.length > 0 && (
      <div class="pill-info hero-pill-row">
        {pills.map((pill) => (
          <span class="pill">{pill}</span>
        ))}
      </div>
    )}
  </div>
  <div class="hero-content">
    <slot />
  </div>
</section>
