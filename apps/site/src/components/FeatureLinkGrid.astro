---
import type { FeatureCard } from '@sgs/content-schema';

interface Props {
  cards: FeatureCard[];
}

const { cards } = Astro.props;
const activeCards = cards.filter((card) => !card.comingSoon);
---

<div class="feature-grid">
  {activeCards.map((card) => (
    <a href={card.href} class="feature-link">
      {card.icon && (
        <div class="feature-link__icon" aria-hidden="true">
          <i class={card.icon} aria-hidden="true"></i>
        </div>
      )}
      <h2 class="feature-link__title">{card.title}</h2>
      {card.desc && <p class="feature-link__desc">{card.desc}</p>}
    </a>
  ))}
</div>
