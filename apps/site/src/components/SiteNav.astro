---
type NavSection = 'ks3' | 'igcse' | 'ib';

interface Props {
  activeSection?: NavSection;
}

const { activeSection } = Astro.props;

const sections = [
  { key: 'ks3' as const, label: 'KS3', href: '/ks3/index.html' },
  { key: 'igcse' as const, label: 'IGCSE', href: '/igcse/index.html' },
  { key: 'ib' as const, label: 'IB', href: '/ib-2027/index.html' }
];
---

<header class="main-header">
  <div class="header-primary">
    <div class="logo-container">
      <a href="/index.html">
        <img
          src="/images/Logo.png"
          alt="St George's Logo"
          class="logo-img"
          width="40"
          height="40"
          loading="eager"
          fetchpriority="high"
        />
      </a>
      <a href="/index.html" class="site-title-link">
        <span class="site-title">SGS Science</span>
      </a>
    </div>

    <nav class="main-nav main-nav-simple" aria-label="Main navigation">
      {sections.map((section) => (
        <a
          href={section.href}
          class:list={{ 'nav-link': true, active: activeSection === section.key }}
          aria-current={activeSection === section.key ? 'page' : undefined}
        >
          {section.label}
        </a>
      ))}
    </nav>

    <div class="site-auth-slot" data-auth-slot aria-label="Account actions" />
  </div>
</header>
