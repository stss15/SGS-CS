---
type NavSection = 'ai-prompt' | 'ks3' | 'igcse' | 'ib';

interface Props {
  activeSection?: NavSection;
}

const { activeSection } = Astro.props;

const sections = [
  { key: 'ks3' as const, label: 'KS3', href: '/ks3/index.html' },
  { key: 'igcse' as const, label: 'IGCSE', href: '/igcse/index.html' },
  { key: 'ib' as const, label: 'IB', href: '/ib-2027/index.html' }
];
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/index.html" class="site-brand" aria-label="SGS Education home">
      <img
        src="/images/Logo.png"
        alt="SGS Education logo"
        class="site-brand-logo"
        width="40"
        height="40"
        loading="eager"
        fetchpriority="high"
      />
      <span>SGS Education</span>
    </a>

    <nav class="site-primary-nav" aria-label="Main navigation">
      {sections.map((section) => (
        <a
          href={section.href}
          class:list={{ active: activeSection === section.key }}
          aria-current={activeSection === section.key ? 'page' : undefined}
        >
          {section.label}
        </a>
      ))}
    </nav>

    <button
      class="site-mobile-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-mobile-drawer"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line class="hamburger-top" x1="3" y1="6" x2="21" y2="6" />
        <line class="hamburger-mid" x1="3" y1="12" x2="21" y2="12" />
        <line class="hamburger-bot" x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>
</header>

<div class="site-mobile-drawer" id="site-mobile-drawer" hidden>
  <div class="site-mobile-drawer__overlay" data-close-drawer></div>
  <nav class="site-mobile-drawer__panel" aria-label="Mobile navigation">
    <div class="site-mobile-drawer__header">
      <span class="site-mobile-drawer__brand">SGS Education</span>
      <button class="site-mobile-drawer__close" type="button" aria-label="Close menu" data-close-drawer>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
    <ul class="site-mobile-drawer__links">
      {sections.map((section) => (
        <li>
          <a
            href={section.href}
            class:list={{ active: activeSection === section.key }}
            aria-current={activeSection === section.key ? 'page' : undefined}
          >
            {section.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script is:inline>
  (() => {
    const toggle = document.querySelector('.site-mobile-toggle');
    const drawer = document.getElementById('site-mobile-drawer');
    if (!toggle || !drawer) return;

    const open = () => {
      drawer.hidden = false;
      requestAnimationFrame(() => {
        drawer.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      });
    };

    const close = () => {
      drawer.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      drawer.addEventListener('transitionend', () => {
        if (!drawer.classList.contains('open')) drawer.hidden = true;
      }, { once: true });
    };

    toggle.addEventListener('click', () => drawer.hidden ? open() : close());
    drawer.querySelectorAll('[data-close-drawer]').forEach(el => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !drawer.hidden) close(); });
  })();
</script>
