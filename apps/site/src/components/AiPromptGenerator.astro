---
import {
  DEFAULT_PROMPT_TYPE,
  GUIDE_CONTENT,
  LOCAL_ONLY_NOTE,
  PLACEHOLDERS,
  PROMPT_TYPE_ORDER,
  PROMPT_TYPES,
  getContextStage
} from '../lib/ai-prompt-generator';

const promptTypes = PROMPT_TYPE_ORDER.map((id) => ({
  id,
  ...PROMPT_TYPES[id]
}));

const principlePairs = GUIDE_CONTENT.doUseAiFor.map((safe, index) => ({
  safe,
  unsafe: GUIDE_CONTENT.doNotUseAiFor[index]
}));
---

<section class="ai-prompt-page" data-ai-prompt-app>
  <header class="ai-prompt-panel ai-prompt-hero">
    <div class="ai-prompt-hero__copy">
      <p class="ai-prompt-eyebrow">AI Prompt</p>
      <h1>Use AI without outsourcing your thinking.</h1>
      <p class="ai-prompt-lede">
        Build a safe prompt, paste it into your model, and keep full ownership of your work.
      </p>
    </div>

    <div class="ai-prompt-hero__actions">
      <button type="button" class="ai-prompt-cta" data-ai-open-modal>
        Generate prompt
      </button>
      <p class="ai-prompt-privacy">{LOCAL_ONLY_NOTE}</p>
    </div>
  </header>

  <div class="ai-prompt-grid">
    <section class="ai-prompt-panel ai-prompt-panel--principles">
      <div class="ai-prompt-panel__header">
        <h2>Non-negotiable principles</h2>
      </div>

      <div class="ai-prompt-principles">
        <div class="ai-prompt-principles__head">
          <span>Use AI for</span>
          <span>Do not use AI for</span>
        </div>

        <ul class="ai-prompt-principles__rows">
          {principlePairs.map((pair) => (
            <li>
              <span>{pair.safe}</span>
              <span>{pair.unsafe}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="ai-prompt-panel ai-prompt-panel--requests">
      <div class="ai-prompt-panel__header">
        <h2>Safe and unsafe requests</h2>
      </div>

      <div class="ai-prompt-requests">
        <div class="ai-prompt-requests__head">
          <span>Safer</span>
          <span>Unsafe</span>
        </div>

        <ul class="ai-prompt-requests__rows">
          {GUIDE_CONTENT.requestPairs.map((pair) => (
            <li>
              <span>{pair.safe}</span>
              <span>{pair.unsafe}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <section class="ai-prompt-panel ai-prompt-panel--footer">
    <div class="ai-prompt-footer__block">
      <h2>Before you start</h2>
      <ul class="ai-prompt-checklist">
        {GUIDE_CONTENT.beforeYouUsePrompt.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div class="ai-prompt-footer__block ai-prompt-footer__block--reminder">
      <h2>{GUIDE_CONTENT.finalReminderTitle}</h2>
      <p>{GUIDE_CONTENT.finalReminder[0]}</p>
      <p>{GUIDE_CONTENT.finalReminder[1]}</p>
      <p>{GUIDE_CONTENT.finalReminder[2]}</p>
    </div>
  </section>

  <div class="ai-prompt-modal-root" aria-live="polite">
    <div class="ai-prompt-modal-overlay" data-ai-overlay hidden></div>
    <section
      class="ai-prompt-modal"
      data-ai-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby="ai-prompt-modal-title"
      aria-hidden="true"
      hidden
    >
      <button type="button" class="ai-prompt-modal__close" data-ai-close-modal aria-label="Close">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>

      <h2 id="ai-prompt-modal-title" class="sr-only">AI Prompt Generator</h2>

      <div class="ai-prompt-modal__view" data-ai-view="form">
        <header class="ai-prompt-modal__header">
          <div>
            <p class="ai-prompt-modal__eyebrow">Local only</p>
            <h3>Generate a prompt</h3>
          </div>
          <p class="ai-prompt-modal__note">{LOCAL_ONLY_NOTE}</p>
        </header>

        <form class="ai-prompt-form" data-ai-form autocomplete="off">
          <div class="ai-prompt-form__grid">
            <label class="ai-prompt-field">
              <span>Subject + course</span>
              <input
                type="text"
                name="subject"
                placeholder="IB Biology HL"
                autocomplete="off"
                autocapitalize="off"
                required
              />
            </label>

            <label class="ai-prompt-field">
              <span>Task type</span>
              <input
                type="text"
                name="taskType"
                placeholder="IA, EE, essay, report"
                autocomplete="off"
                autocapitalize="off"
                required
              />
            </label>
          </div>

          <div class="ai-prompt-form__grid ai-prompt-form__grid--secondary">
            <label class="ai-prompt-field">
              <span>Prompt type</span>
              <select name="type" data-ai-type-select>
                {promptTypes.map((type) => (
                  <option value={type.id} selected={type.id === DEFAULT_PROMPT_TYPE}>
                    {type.label}
                  </option>
                ))}
              </select>
            </label>

            <div class="ai-prompt-field ai-prompt-field--meta">
              <span>Prompt context</span>
              <p data-ai-stage-note>Added automatically: {getContextStage(DEFAULT_PROMPT_TYPE)}.</p>
            </div>
          </div>

          <p class="ai-prompt-form__helper" data-ai-type-helper>
            {PROMPT_TYPES[DEFAULT_PROMPT_TYPE].helper}
          </p>

          <label class="ai-prompt-field ai-prompt-field--textarea">
            <span>Paste work or notes</span>
            <textarea
              name="work"
              rows="6"
              placeholder={PLACEHOLDERS[DEFAULT_PROMPT_TYPE]}
              data-ai-work-input
              spellcheck="false"
              autocomplete="off"
              required
            ></textarea>
          </label>

          <div class="ai-prompt-form__meta">
            <p>Nothing you paste leaves this browser tab.</p>
            <span data-ai-character-count>0 characters</span>
          </div>

          <div class="ai-prompt-soft-checks" data-ai-soft-checks hidden>
            <p>Quick checks</p>
            <ul data-ai-soft-checks-list></ul>
          </div>

          <div class="ai-prompt-form__actions">
            <button type="button" class="ai-prompt-text-button" data-ai-close-modal>
              Cancel
            </button>
            <button type="submit" class="ai-prompt-cta">
              Generate prompt
            </button>
          </div>
        </form>
      </div>

      <div class="ai-prompt-modal__view" data-ai-view="result" hidden>
        <header class="ai-prompt-modal__header ai-prompt-modal__header--result">
          <div>
            <p class="ai-prompt-modal__eyebrow">Ready to copy</p>
            <h3>Generated prompt</h3>
          </div>
          <p class="ai-prompt-modal__note" data-ai-result-summary></p>
        </header>

        <div class="ai-prompt-soft-checks" data-ai-result-checks hidden>
          <p>Quick checks</p>
          <ul data-ai-result-checks-list></ul>
        </div>

        <div class="ai-prompt-output" tabindex="-1" data-ai-output>
          <pre data-ai-output-text></pre>
        </div>

        <div class="ai-prompt-result__actions">
          <button type="button" class="ai-prompt-text-button" data-ai-edit-form>
            Edit details
          </button>
          <button type="button" class="ai-prompt-cta" data-ai-copy-prompt>
            Copy prompt
          </button>
        </div>

        <p class="ai-prompt-copy-status" data-ai-copy-status></p>
      </div>
    </section>
  </div>
</section>

<script>
  import {
    DEFAULT_PROMPT_TYPE,
    LOCAL_ONLY_NOTE,
    PLACEHOLDERS,
    PROMPT_TYPES,
    buildPrompt,
    getContextStage,
    isPromptTypeId,
    qualityChecks
  } from '../lib/ai-prompt-generator';
  import type { PromptInput, PromptTypeId } from '../lib/ai-prompt-generator';

  const root = document.querySelector<HTMLElement>('[data-ai-prompt-app]');

  if (root) {
    const openButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ai-open-modal]'));
    const overlay = root.querySelector<HTMLElement>('[data-ai-overlay]');
    const modal = root.querySelector<HTMLElement>('[data-ai-modal]');
    const closeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ai-close-modal]'));
    const formView = root.querySelector<HTMLElement>('[data-ai-view="form"]');
    const resultView = root.querySelector<HTMLElement>('[data-ai-view="result"]');
    const form = root.querySelector<HTMLFormElement>('[data-ai-form]');
    const typeSelect = root.querySelector<HTMLSelectElement>('[data-ai-type-select]');
    const typeHelper = root.querySelector<HTMLElement>('[data-ai-type-helper]');
    const stageNote = root.querySelector<HTMLElement>('[data-ai-stage-note]');
    const workInput = root.querySelector<HTMLTextAreaElement>('[data-ai-work-input]');
    const characterCount = root.querySelector<HTMLElement>('[data-ai-character-count]');
    const softChecks = root.querySelector<HTMLElement>('[data-ai-soft-checks]');
    const softChecksList = root.querySelector<HTMLUListElement>('[data-ai-soft-checks-list]');
    const resultChecks = root.querySelector<HTMLElement>('[data-ai-result-checks]');
    const resultChecksList = root.querySelector<HTMLUListElement>('[data-ai-result-checks-list]');
    const output = root.querySelector<HTMLElement>('[data-ai-output]');
    const outputText = root.querySelector<HTMLElement>('[data-ai-output-text]');
    const resultSummary = root.querySelector<HTMLElement>('[data-ai-result-summary]');
    const editButton = root.querySelector<HTMLButtonElement>('[data-ai-edit-form]');
    const copyButton = root.querySelector<HTMLButtonElement>('[data-ai-copy-prompt]');
    const copyStatus = root.querySelector<HTMLElement>('[data-ai-copy-status]');

    if (
      overlay &&
      modal &&
      formView &&
      resultView &&
      form &&
      typeSelect &&
      typeHelper &&
      stageNote &&
      workInput &&
      characterCount &&
      softChecks &&
      softChecksList &&
      resultChecks &&
      resultChecksList &&
      output &&
      outputText &&
      resultSummary &&
      editButton &&
      copyButton &&
      copyStatus
    ) {
      const subjectInput = form.elements.namedItem('subject');
      const taskTypeInput = form.elements.namedItem('taskType');

      if (subjectInput instanceof HTMLInputElement && taskTypeInput instanceof HTMLInputElement) {
        let activeTrigger: HTMLElement | null = null;
        let submittedOnce = false;

        const getFocusableElements = (container: ParentNode): HTMLElement[] =>
          Array.from(
            container.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
            )
          ).filter((element) => !element.hasAttribute('hidden'));

        const getCurrentType = (): PromptTypeId => {
          const value = typeSelect.value;
          return isPromptTypeId(value) ? value : DEFAULT_PROMPT_TYPE;
        };

        const setType = (nextType: PromptTypeId): void => {
          typeSelect.value = nextType;
          typeHelper.textContent = PROMPT_TYPES[nextType].helper;
          stageNote.textContent = `Added automatically: ${getContextStage(nextType)}.`;
          workInput.placeholder = PLACEHOLDERS[nextType];
          updateChecks();
        };

        const getFormData = (): PromptInput => ({
          type: getCurrentType(),
          subject: subjectInput.value,
          taskType: taskTypeInput.value,
          work: workInput.value
        });

        const renderChecks = (
          container: HTMLElement,
          list: HTMLUListElement,
          checks: string[],
          shouldShow: boolean
        ): void => {
          list.innerHTML = '';

          if (!shouldShow || checks.length === 0) {
            container.hidden = true;
            return;
          }

          checks.forEach((item: string) => {
            const entry = document.createElement('li');
            entry.textContent = item;
            list.appendChild(entry);
          });

          container.hidden = false;
        };

        const updateChecks = (): void => {
          characterCount.textContent = `${workInput.value.length} characters`;

          const formData = getFormData();
          const checks = qualityChecks(formData);
          const hasStarted =
            formData.subject.trim().length > 0 ||
            formData.taskType.trim().length > 0 ||
            formData.work.trim().length > 0;

          renderChecks(softChecks, softChecksList, checks, submittedOnce || hasStarted);
          renderChecks(resultChecks, resultChecksList, checks, checks.length > 0);
        };

        const showView = (view: 'form' | 'result'): void => {
          const showForm = view === 'form';
          formView.hidden = !showForm;
          resultView.hidden = showForm;

          if (showForm) {
            requestAnimationFrame(() => subjectInput.focus());
            return;
          }

          requestAnimationFrame(() => output.focus());
        };

        const openModal = (trigger: HTMLElement | null): void => {
          activeTrigger = trigger;
          overlay.hidden = false;
          modal.hidden = false;

          requestAnimationFrame(() => {
            overlay.classList.add('is-active');
            modal.classList.add('is-active');
          });

          modal.setAttribute('aria-hidden', 'false');
          document.body.classList.add('modal-open');
          showView(outputText.textContent ? 'result' : 'form');
        };

        const closeModal = (): void => {
          overlay.classList.remove('is-active');
          modal.classList.remove('is-active');
          modal.setAttribute('aria-hidden', 'true');

          window.setTimeout(() => {
            overlay.hidden = true;
            modal.hidden = true;
          }, 180);

          document.body.classList.remove('modal-open');
          copyStatus.textContent = '';

          if (activeTrigger) {
            activeTrigger.focus();
          }

          activeTrigger = null;
        };

        const copyPrompt = async (): Promise<void> => {
          const promptText = outputText.textContent || '';
          if (!promptText) {
            return;
          }

          try {
            await navigator.clipboard.writeText(promptText);
            copyStatus.textContent = 'Prompt copied.';
          } catch (_error) {
            const selection = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(outputText);
            selection?.removeAllRanges();
            selection?.addRange(range);
            copyStatus.textContent = 'Select the prompt and copy it manually.';
          }
        };

        typeSelect.addEventListener('change', () => {
          const nextType = typeSelect.value;
          if (isPromptTypeId(nextType)) {
            setType(nextType);
          }
        });

        [subjectInput, taskTypeInput, workInput].forEach((field) => {
          field.addEventListener('input', updateChecks);
          field.addEventListener('change', updateChecks);
        });

        openButtons.forEach((button) => {
          button.addEventListener('click', () => openModal(button));
        });

        closeButtons.forEach((button) => {
          button.addEventListener('click', closeModal);
        });

        overlay.addEventListener('click', closeModal);
        editButton.addEventListener('click', () => showView('form'));
        copyButton.addEventListener('click', copyPrompt);

        form.addEventListener('submit', (event: SubmitEvent) => {
          event.preventDefault();
          submittedOnce = true;

          if (!form.reportValidity()) {
            updateChecks();
            return;
          }

          const formData = getFormData();
          outputText.textContent = buildPrompt(formData);
          resultSummary.textContent = `${PROMPT_TYPES[formData.type].label} prompt ready. ${LOCAL_ONLY_NOTE}`;
          copyStatus.textContent = '';
          updateChecks();
          showView('result');
        });

        document.addEventListener('keydown', (event: KeyboardEvent) => {
          if (modal.hidden) {
            return;
          }

          if (event.key === 'Escape') {
            closeModal();
            return;
          }

          if (event.key !== 'Tab') {
            return;
          }

          const focusable = getFocusableElements(modal);
          if (focusable.length === 0) {
            return;
          }

          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          const activeElement = document.activeElement;

          if (event.shiftKey && activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        setType(DEFAULT_PROMPT_TYPE);
        updateChecks();
      }
    }
  }
</script>
