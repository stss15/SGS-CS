---
interface CompactListItem {
  label: string;
  href: string;
  meta?: string;
}

interface CompactListSection {
  title: string;
  summary?: string;
  items: CompactListItem[];
}

interface Props {
  sections: CompactListSection[];
}

const { sections } = Astro.props as Props;

const isGenericMeta = (value?: string): boolean => {
  if (!value) {
    return false;
  }

  return [
    /^reading mode$/i,
    /^slide deck$/i,
    /^activity$/i,
    /^mini-assessment$/i,
    /^revision$/i,
    /^independent study$/i,
    /^additional resource$/i,
    /^textbook chapter$/i,
    /^quick retrieval practice$/i,
    /^interactive (?:task|practice|simulator)$/i,
    /^educational game$/i
  ].some((pattern) => pattern.test(value.trim()));
};
---

<div class="compact-list">
  {sections.map((section) => (
    <section class="compact-list__section">
      <div class="compact-list__heading">
        <h2>{section.title}</h2>
      </div>
      <ul>
        {section.items.map((item) => (
          <li>
            <a href={item.href}>
              <span>{item.label}</span>
              {item.meta && !isGenericMeta(item.meta) && <small>{item.meta}</small>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
