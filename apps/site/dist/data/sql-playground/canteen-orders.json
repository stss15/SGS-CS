{
  "id": "canteen-orders",
  "name": "Canteen Orders",
  "difficulty": "sl",
  "summary": "An order-processing database that supports joins, filtering, grouping, and reporting tasks.",
  "focus": [
    "JOIN",
    "ORDER BY",
    "GROUP BY",
    "Junction table"
  ],
  "relationshipHighlights": [
    "One-to-many",
    "Many-to-many",
    "Junction table"
  ],
  "defaultQuery": "SELECT oh.OrderID, c.CustomerName, p.ProductName, oi.Quantity FROM ORDER_HEADER oh JOIN CUSTOMER c ON oh.CustomerID = c.CustomerID JOIN ORDER_ITEM oi ON oh.OrderID = oi.OrderID JOIN PRODUCT p ON oi.ProductID = p.ProductID ORDER BY oh.OrderID, p.ProductName;",
  "notes": [
    "ORDER_ITEM is the junction table that links each order to one or more products.",
    "Grouped reports can summarise payment methods, categories, or item counts once joins are working."
  ],
