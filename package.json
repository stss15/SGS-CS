{
  "name": "computer_science_app-copy",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "scripts/build.js",
  "scripts": {
    "build": "npm run framework:build",
    "build:legacy": "node scripts/build.js",
    "contracts:generate": "node scripts/contracts/generate-site-contracts.mjs",
    "contracts:validate": "node scripts/contracts/validate-site-contracts.mjs",
    "contracts:parity:public": "node scripts/contracts/check-site-parity.mjs --target=public",
    "contracts:parity:framework": "node scripts/contracts/check-site-parity.mjs --target=apps/site/dist",
    "contracts:check": "npm run check --workspace @sgs/site-contracts && npm run contracts:validate",
    "framework:dev": "npm run build:legacy && npm run dev --workspace @sgs/site",
    "framework:build": "npm run build:legacy && npm run build --workspace @sgs/site && npm run framework:postbuild-routes && npm run framework:harden-dist",
    "framework:postbuild-routes": "node scripts/migration/alias-framework-html-routes.js --target=apps/site/dist",
    "framework:harden-dist": "node scripts/migration/harden-framework-dist.js --target=apps/site/dist",
    "framework:preview": "npm run framework:build && npm run preview --workspace @sgs/site",
    "framework:check": "npm run check --workspace @sgs/site",
    "slides:audit:unit1:b1": "node scripts/slide-audit/audit-unit1-b1.mjs --append",
    "slides:audit:unit2:b2": "node scripts/slide-audit/audit-unit2-b2.mjs --append",
    "ib:textbook:source-map": "node scripts/ib-textbook/build-source-map.mjs",
    "ib:textbook:generate": "node scripts/ib-textbook/generate-unit-textbooks.mjs",
    "ib:textbook:validate": "node scripts/ib-textbook/validate-textbook-coverage.mjs",
    "igcse:textbook:source-map": "node scripts/igcse-textbook/build-source-map.mjs",
    "igcse:textbook:generate": "node scripts/igcse-textbook/generate-topic-textbooks.mjs",
    "igcse:textbook:validate": "node scripts/igcse-textbook/validate-textbook-coverage.mjs",
    "validate": "npm run framework:check && npm run framework:build",
    "serve": "npm run framework:build && firebase emulators:start --only hosting",
    "deploy": "npm run framework:build && firebase deploy --only hosting",
    "preview": "npm run framework:build && firebase hosting:channel:deploy preview",
    "test": "npm run validate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.2",
    "gray-matter": "^4.0.3",
    "node-latex-compiler": "^1.0.3",
    "nunjucks": "^3.2.4"
  }
}
