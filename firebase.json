{
    "hosting": {
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "**/src/**",
            "**/docs/**",
            "**/scripts/**",
            "**/archive/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/404.html"
            }
        ],
        "headers": [
            {
                "source": "**/*.@(css|js)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "max-age=31536000"
                    }
                ]
            },
            {
                "source": "**/*.@(png|jpg|jpeg|gif|webp|svg)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "max-age=31536000"
                    }
                ]
            },
            {
                "source": "**/*.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            }
        ],
        "cleanUrls": true,
        "trailingSlash": false
    }
}