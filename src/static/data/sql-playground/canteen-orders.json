{
  "id": "canteen-orders",
  "name": "Canteen Orders",
  "difficulty": "sl",
  "summary": "An order-processing database that supports joins, totals, GROUP BY, and SUM.",
  "focus": ["JOIN", "SUM", "GROUP BY", "ORDER BY"],
  "relationshipHighlights": ["One-to-many", "Many-to-many", "Junction table"],
  "defaultQuery": "SELECT oh.OrderID, c.CustomerName, ROUND(SUM(oi.Quantity * p.Price), 2) AS OrderTotal FROM ORDER_HEADER oh JOIN CUSTOMER c ON oh.CustomerID = c.CustomerID JOIN ORDER_ITEM oi ON oh.OrderID = oi.OrderID JOIN PRODUCT p ON oi.ProductID = p.ProductID GROUP BY oh.OrderID, c.CustomerName ORDER BY OrderTotal DESC;",
  "notes": [
    "ORDER_ITEM is the junction table that links each order to one or more products.",
    "Totals can be calculated by multiplying quantity by price and then grouping by order."
  ],
  "tables": [
    {
      "name": "CUSTOMER",
      "description": "Students and staff who place canteen orders.",
      "kind": "entity",
      "diagram": { "x": 24, "y": 44 },
      "columns": [
        { "name": "CustomerID", "type": "INTEGER", "notNull": true },
        { "name": "CustomerName", "type": "TEXT", "notNull": true },
        { "name": "House", "type": "TEXT", "notNull": true }
      ],
      "primaryKey": ["CustomerID"],
