        { "name": "CustomerID", "type": "INTEGER", "notNull": true },
        { "name": "OrderDate", "type": "TEXT", "notNull": true },
        { "name": "PaymentMethod", "type": "TEXT", "notNull": true }
      ],
      "primaryKey": ["OrderID"],
      "foreignKeys": [
        {
          "columns": ["CustomerID"],
          "references": { "table": "CUSTOMER", "columns": ["CustomerID"] }
        }
      ],
