        { "name": "CourseName", "type": "TEXT", "notNull": true },
        { "name": "Level", "type": "TEXT", "notNull": true }
      ],
      "primaryKey": ["CourseID"],
      "foreignKeys": [
        {
          "columns": ["DepartmentID"],
          "references": { "table": "DEPARTMENT", "columns": ["DepartmentID"] }
        }
      ],
