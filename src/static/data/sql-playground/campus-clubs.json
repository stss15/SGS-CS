      "kind": "extension",
      "diagram": { "x": 24, "y": 286 },
      "columns": [
        { "name": "StudentID", "type": "INTEGER", "notNull": true },
        { "name": "Username", "type": "TEXT", "notNull": true, "unique": true },
        { "name": "LastLogin", "type": "TEXT", "notNull": true }
      ],
      "primaryKey": ["StudentID"],
      "foreignKeys": [
        {
          "columns": ["StudentID"],
          "references": { "table": "STUDENT", "columns": ["StudentID"] }
        }
