  "relationships": [
    {
      "fromTable": "LOGIN_ACCOUNT",
      "toTable": "STUDENT",
      "fromCardinality": "one",
      "toCardinality": "one",
      "label": "Each student has one login account in this dataset."
    },
    {
      "fromTable": "MEMBERSHIP",
      "toTable": "STUDENT",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "One student can have many club memberships."
    },
    {
      "fromTable": "MEMBERSHIP",
      "toTable": "CLUB",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "One club can include many students."
    }
  ]
