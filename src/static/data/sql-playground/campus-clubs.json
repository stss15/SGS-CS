{
  "id": "campus-clubs",
  "name": "Campus Clubs",
  "difficulty": "sl",
  "summary": "A clubs database that combines one-to-one logins with a many-to-many membership junction table.",
  "focus": ["JOIN", "COUNT", "Composite key", "One-to-one"],
  "relationshipHighlights": ["One-to-one", "Many-to-many", "Junction table"],
  "defaultQuery": "SELECT s.FirstName, s.LastName, c.ClubName, m.Role FROM MEMBERSHIP m JOIN STUDENT s ON m.StudentID = s.StudentID JOIN CLUB c ON m.ClubID = c.ClubID ORDER BY c.ClubName, s.LastName;",
  "notes": [
    "LOGIN_ACCOUNT uses StudentID as both its primary key and foreign key, creating a one-to-one link.",
    "MEMBERSHIP is a junction table with a composite primary key made from StudentID and ClubID."
  ],
  "tables": [
    {
      "name": "STUDENT",
      "description": "Students who can hold club memberships and login accounts.",
      "kind": "entity",
      "diagram": { "x": 24, "y": 40 },
      "columns": [
        { "name": "StudentID", "type": "INTEGER", "notNull": true },
        { "name": "FirstName", "type": "TEXT", "notNull": true },
        { "name": "LastName", "type": "TEXT", "notNull": true },
        { "name": "YearGroup", "type": "INTEGER", "notNull": true }
      ],
      "primaryKey": ["StudentID"],
