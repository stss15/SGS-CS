      "kind": "entity",
      "diagram": { "x": 24, "y": 48 },
      "columns": [
        { "name": "StudentID", "type": "INTEGER", "notNull": true },
        { "name": "FirstName", "type": "TEXT", "notNull": true },
        { "name": "LastName", "type": "TEXT", "notNull": true },
        { "name": "TutorGroup", "type": "TEXT", "notNull": true }
