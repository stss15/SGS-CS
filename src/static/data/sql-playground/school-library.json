      "diagram": { "x": 632, "y": 48 },
      "columns": [
        { "name": "BookID", "type": "INTEGER", "notNull": true },
        { "name": "Title", "type": "TEXT", "notNull": true },
        { "name": "Genre", "type": "TEXT", "notNull": true },
        { "name": "PublishedYear", "type": "INTEGER", "notNull": true }
