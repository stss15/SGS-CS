      "kind": "entity",
      "diagram": { "x": 328, "y": 132 },
      "columns": [
        { "name": "LoanID", "type": "INTEGER", "notNull": true },
        { "name": "StudentID", "type": "INTEGER", "notNull": true },
        { "name": "BookID", "type": "INTEGER", "notNull": true },
        { "name": "LoanDate", "type": "TEXT", "notNull": true },
        { "name": "DueDate", "type": "TEXT", "notNull": true },
        { "name": "ReturnStatus", "type": "TEXT", "notNull": true }
      ],
      "primaryKey": ["LoanID"],
      "foreignKeys": [
        {
          "columns": ["StudentID"],
          "references": { "table": "STUDENT", "columns": ["StudentID"] }
