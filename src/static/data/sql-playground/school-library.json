{
  "id": "school-library",
  "name": "School Library",
  "difficulty": "igcse",
  "summary": "A simple borrowing system with clear one-to-many relationships between students, books, and loans.",
  "focus": ["SELECT", "WHERE", "ORDER BY", "COUNT"],
  "relationshipHighlights": ["One-to-many", "Foreign keys", "Referential integrity"],
  "defaultQuery": "SELECT Title, Genre, PublishedYear FROM BOOK ORDER BY PublishedYear DESC;",
  "notes": [
    "Each loan belongs to one student and one book.",
    "A single student can appear in many loan records over time."
  ],
  "tables": [
