  "relationships": [
    {
      "fromTable": "LOAN",
      "toTable": "STUDENT",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "One student can create many loan records."
    },
    {
      "fromTable": "LOAN",
      "toTable": "BOOK",
      "fromCardinality": "many",
      "toCardinality": "one",
      "label": "One book can appear in many loan records over time."
    }
  ]
