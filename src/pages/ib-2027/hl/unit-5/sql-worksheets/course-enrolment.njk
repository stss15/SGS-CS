            <h2><i class="fa-solid fa-unlock"></i> Model Answers — Course Enrolment Reporting</h2>

            <h3>Section 1</h3>
            <div class="sql-answer-item">
                <span class="sql-answer-num">1</span>
                <div class="sql-answer-body">
                    <strong>Example count query</strong>
                    <pre><code>SELECT d.DepartmentName, COUNT(*) AS CourseCount
FROM COURSE AS c
INNER JOIN DEPARTMENT AS d
    ON c.DepartmentID = d.DepartmentID
GROUP BY d.DepartmentName
ORDER BY d.DepartmentName;</code></pre>
                </div>
            </div>

            <h3>Section 2</h3>
            <div class="sql-answer-item">
                <span class="sql-answer-num">2</span>
                <div class="sql-answer-body">
                    <strong>Average and total examples</strong>
                    <pre><code>SELECT d.DepartmentName, ROUND(AVG(e.Score), 1) AS AverageScore
FROM ENROLLMENT AS e
INNER JOIN COURSE AS c
    ON e.CourseID = c.CourseID
INNER JOIN DEPARTMENT AS d
    ON c.DepartmentID = d.DepartmentID
GROUP BY d.DepartmentName;

SELECT Level, SUM(Credits) AS TotalCredits
FROM COURSE
GROUP BY Level;</code></pre>
                </div>
            </div>

            <h3>Section 3</h3>
            <div class="sql-answer-item">
                <span class="sql-answer-num">3</span>
                <div class="sql-answer-body">
                    <strong>HAVING example</strong>
                    <pre><code>SELECT d.DepartmentName, COUNT(*) AS EnrollmentCount
FROM ENROLLMENT AS e
INNER JOIN COURSE AS c
    ON e.CourseID = c.CourseID
INNER JOIN DEPARTMENT AS d
    ON c.DepartmentID = d.DepartmentID
GROUP BY d.DepartmentName
HAVING COUNT(*) >= 9
ORDER BY EnrollmentCount DESC;</code></pre>
                </div>
            </div>
        </div>
    </section>

