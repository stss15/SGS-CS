    <div class="sql-overview-grid">
        <section class="sql-overview-card">
            <h2>Dataset Focus</h2>
            <ul>
                <li>3 tables: <code>STUDENT</code>, <code>BOOK</code>, <code>LOAN</code></li>
                <li>Clear one-to-many relationships through foreign keys</li>
                <li>Good for first joins because each loan links one student to one book</li>
            </ul>
        </section>
        <section class="sql-overview-card">
            <h2>Syllabus Links</h2>
            <ul>
                <li>A3.1.1 relational database features, benefits, and limitations</li>
                <li>A3.2.1 schema levels</li>
                <li>A3.3.1 DDL versus DML</li>
            </ul>
        </section>
