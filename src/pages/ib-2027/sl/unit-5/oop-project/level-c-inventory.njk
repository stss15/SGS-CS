<!-- STRUCTURE GUIDE -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-code"></i>
        </div>
        <h2 class="oop-section-title">Structure Guide</h2>
    </div>
    
    <p class="section-intro">Click each section to expand. Build the Inventory class first, then integrate it with Player.</p>
    
    <!-- 1. Class Variable -->
    <details class="skeleton-block" open>
        <summary class="skeleton-summary">
            <span class="skeleton-step">1</span>
            <span class="skeleton-title">Class Definition & Class Variable</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">CLASS Inventory:</div>
            <div class="skeleton-line code" style="margin-top: 0.5rem;">    MAX_CAPACITY = 10</div>
            <div class="skeleton-desc">
                This is a <strong>class variable</strong> — shared by all Inventory instances, not unique to each one. It defines the maximum number of items any inventory can hold.
            </div>
        </div>
    </details>
    
    <!-- 2. Constructor -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">2</span>
            <span class="skeleton-title">Constructor</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">CONSTRUCTOR():</div>
            <div class="skeleton-desc">
                <strong>Must do:</strong>
                <ul>
                    <li>Create an empty list called <code>_items</code></li>
                </ul>
                The underscore prefix indicates this is a protected attribute — accessed through methods, not directly.
            </div>
        </div>
    </details>
    
    <!-- 3. add -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">3</span>
            <span class="skeleton-title">add</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD add(item_id) → boolean:</div>
            <div class="skeleton-desc">
                <strong>Returns:</strong> True if item was added, False otherwise<br><br>
                <strong>Must check:</strong>
                <ul>
                    <li>Is the inventory already full?</li>
                    <li>Is this item already in the inventory?</li>
                </ul>
                Only add the item if both checks pass.
            </div>
        </div>
    </details>
    
    <!-- 4. remove -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">4</span>
            <span class="skeleton-title">remove</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD remove(item_id) → boolean:</div>
            <div class="skeleton-desc">
                <strong>Returns:</strong> True if item was removed, False if not found
            </div>
        </div>
    </details>
    
    <!-- 5. Accessor Methods -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">5</span>
            <span class="skeleton-title">Accessor Methods</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD list_items() → list:</div>
            <div class="skeleton-desc" style="margin-bottom: 1rem;">
                Returns a <strong>copy</strong> of _items, not the list itself. This protects encapsulation.
            </div>
            <div class="skeleton-line code">METHOD has_item(item_id) → boolean:</div>
            <div class="skeleton-desc" style="margin-bottom: 1rem;">
                Returns True if item_id is in the inventory.
            </div>
            <div class="skeleton-line code">METHOD is_full() → boolean:</div>
            <div class="skeleton-desc" style="margin-bottom: 1rem;">
                Returns True if count equals MAX_CAPACITY.
            </div>
            <div class="skeleton-line code">METHOD count() → integer:</div>
            <div class="skeleton-desc">
                Returns the number of items currently held.
            </div>
        </div>
    </details>
    
    <!-- 6. Integration -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">6</span>
            <span class="skeleton-title">Integrate with Player</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-desc">
                Update your <strong>Player</strong> class constructor to create an Inventory:
                <div class="skeleton-line code" style="margin-top: 1rem;">this.inventory = NEW Inventory()</div>
                <p style="margin-top: 1rem;">This is <strong>composition</strong> — the Player now "has-a" Inventory.</p>
            </div>
        </div>
    </details>
</section>

