    .badge-d { background-color: #f6c23e; } .text-d { color: #f6c23e; }
    .badge-e { background-color: #fd7e14; } .text-e { color: #fd7e14; }
    .badge-f { background-color: #e74a3b; } .text-f { color: #e74a3b; }
    .badge-g { background-color: #858796; } .text-g { color: #858796; }
    .badge-h { background-color: #5a5c69; } .text-h { color: #5a5c69; }
