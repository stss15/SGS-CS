<style>
    /* Scoped CSS for Teacher Portal */
    .teacher-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .teacher-card {
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid #e3e6f0;
        border-radius: 0.5rem;
        padding: 1.5rem;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none !important; /* Force removal of underline */
        color: inherit;
        height: 100%;
    }

    .teacher-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 2rem 0 rgba(58, 59, 69, 0.25);
    }

    .card-badge {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 0.25rem;
        color: white;
        align-self: flex-start;
        margin-bottom: 1rem;
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #2c3e50;
        margin: 0 0 0.5rem 0;
    }

    .card-desc {
        font-size: 0.9rem;
        color: #858796;
        margin: 0 0 1.5rem 0;
        line-height: 1.5;
        flex-grow: 1; /* Pushes the button down */
    }

    .card-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 0.9rem;
        margin-top: auto; /* Push to bottom */
    }
    
    /* Level Colors */
    .badge-a { background-color: #4e73df; } .text-a { color: #4e73df; }
    .badge-b { background-color: #1cc88a; } .text-b { color: #1cc88a; }
