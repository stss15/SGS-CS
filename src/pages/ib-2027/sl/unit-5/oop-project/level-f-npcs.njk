<!-- STRUCTURE GUIDE -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-code"></i>
        </div>
        <h2 class="oop-section-title">Structure Guide</h2>
    </div>
    
    <p class="section-intro">Add this method to your Player class. The engine does the rest!</p>
    
    <!-- 1. Method Signature -->
    <details class="skeleton-block" open>
        <summary class="skeleton-summary">
            <span class="skeleton-step">1</span>
            <span class="skeleton-title">Method Signature</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD respond_to_npc(options_list) → integer:</div>
            <div class="skeleton-desc">
                <strong>Parameters:</strong> <code>options_list</code> is a list of strings (the choices).<br>
                <strong>Returns:</strong> The index (integer) of the choice selected.
            </div>
        </div>
    </details>
    
    <!-- 2. Display Options -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">2</span>
            <span class="skeleton-title">Display Options</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-desc">
                Loop through the <code>options_list</code> and print each one with a number.
                <div class="skeleton-line code" style="margin-top: 0.5rem;">FOR index, option IN ENUMERATE(options_list):</div>
                <div class="skeleton-line code">    PRINT (index + 1) ": " option</div>
                <p style="margin-top: 0.5rem; font-size: 0.9em; color: #666;">Note: Use <code>index + 1</code> so humans see 1, 2, 3... instead of 0, 1, 2...</p>
            </div>
        </div>
    </details>
    
    <!-- 3. Get Valid Input -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">3</span>
            <span class="skeleton-title">Get Valid Input</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-desc">
                Create a <code>WHILE True</code> loop to keep asking until you get a valid number.
                <ul>
                    <li>Ask user for input</li>
                    <li>Check if it is a number</li>
                    <li>Check if it is between 1 and <code>len(options_list)</code></li>
                    <li>If valid, BREAK the loop</li>
                    <li>If invalid, print an error message and loop again</li>
                </ul>
            </div>
        </div>
    </details>
    
    <!-- 4. Return Index -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">4</span>
            <span class="skeleton-title">Return Zero-based Index</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-desc">
                The user typed <code>1</code>, but the list starts at <code>0</code>.
                <div class="skeleton-line code" style="margin-top: 0.5rem;">RETURN (user_choice - 1)</div>
            </div>
        </div>
    </details>
</section>

