<!-- KEYWORDS -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-book"></i>
        </div>
        <h2 class="oop-section-title">Key Terms</h2>
    </div>
    
    <div class="keywords-table">
        <table>
            <thead>
                <tr>
                    <th style="width: 25%;">Term</th>
                    <th>Definition</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="keyword-term">Class</span></td>
                    <td>A blueprint that defines attributes and methods</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Object</span></td>
                    <td>An instance created from a class blueprint</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Attribute</span></td>
                    <td>Data stored inside an object</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Method</span></td>
                    <td>A function inside a class that operates on object data</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Encapsulation</span></td>
                    <td>Protecting internal data by using methods as the access point</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Inheritance</span></td>
                    <td>Building a new class by reusing and extending a parent class</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Polymorphism</span></td>
                    <td>Same method name, different behavior in different classes</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Abstraction</span></td>
                    <td>Defining what something can do without showing how it does it (often with abstract classes or interfaces)</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Composition</span></td>
                    <td>One class owns another class as a part of itself (has-a)</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Aggregation</span></td>
                    <td>A weaker has-a relationship where objects are shared</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

