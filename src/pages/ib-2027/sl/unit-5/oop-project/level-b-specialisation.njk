        <h2 class="oop-section-title">Key Terms</h2>
    </div>
    
    <div class="keywords-table">
        <table>
            <thead>
                <tr>
                    <th style="width: 25%;">Term</th>
                    <th>Definition</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="keyword-term">Inheritance</span></td>
                    <td>A class deriving from another class, gaining its attributes and methods</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Subclass</span></td>
                    <td>A class that inherits from another (also called child class)</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Parent Class</span></td>
                    <td>The class being inherited from (also called superclass)</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Override</span></td>
                    <td>Replacing or specialising inherited behaviour or values in the subclass</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Polymorphism</span></td>
                    <td>Same method name produces different behaviour based on object type</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

