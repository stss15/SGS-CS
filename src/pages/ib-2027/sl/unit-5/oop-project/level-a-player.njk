<!-- UML DIAGRAM -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-diagram-project"></i>
        </div>
        <h2 class="oop-section-title">Class Design (UML)</h2>
    </div>
    
    <div class="uml-container">
        <div class="uml-class">
            <div class="uml-class-name">Player</div>
            <!-- Attributes -->
            <div class="uml-class-section">
                <div class="uml-item">
                    <span class="uml-visibility private">-</span>
                    <span class="uml-name">name</span>
                    <span class="uml-type">: str</span>
                </div>
                <div class="uml-item">
                    <span class="uml-visibility private">-</span>
                    <span class="uml-name">health</span>
                    <span class="uml-type">: int</span>
                </div>
                <div class="uml-item">
                    <span class="uml-visibility private">-</span>
                    <span class="uml-name">max_health</span>
                    <span class="uml-type">: int</span>
                </div>
                <div class="uml-item">
                    <span class="uml-visibility private">-</span>
                    <span class="uml-name">armour</span>
                    <span class="uml-type">: int</span>
                </div>
                <div class="uml-item">
                    <span class="uml-visibility private">-</span>
                    <span class="uml-name">accuracy</span>
                    <span class="uml-type">: int</span>
                </div>
            </div>
            <!-- Methods -->
            <div class="uml-class-section">
                <div class="uml-item">
                    <span class="uml-visibility public">+</span>
                    <span class="uml-name">constructor(name)</span>
                    <span class="uml-type"></span>
                </div>
                <div class="uml-item">
                    <span class="uml-visibility public">+</span>
                    <span class="uml-name">get_starting_stats()</span>
                    <span class="uml-type">→ dict</span>
                </div>
                <div class="uml-item">
                    <span class="uml-visibility public">+</span>
                    <span class="uml-name">get_status()</span>
                    <span class="uml-type">→ str</span>
                </div>
                <div class="uml-item">
                    <span class="uml-visibility public">+</span>
                    <span class="uml-name">take_damage(amount)</span>
                    <span class="uml-type"></span>
                </div>
                <div class="uml-item">
                    <span class="uml-visibility public">+</span>
                    <span class="uml-name">heal(amount)</span>
                    <span class="uml-type"></span>
                </div>
            </div>
        </div>
        
        <div class="uml-legend">
            <div class="uml-legend-item">
                <span class="uml-legend-symbol" style="color: #dc3545;">-</span>
                <span>Private (internal data)</span>
            </div>
            <div class="uml-legend-item">
                <span class="uml-legend-symbol" style="color: #28a745;">+</span>
                <span>Public (accessible)</span>
            </div>
            <div class="uml-legend-item">
                <span class="uml-legend-symbol">→</span>
                <span>Returns</span>
            </div>
        </div>
    </div>
</section>

<!-- CODE SKELETON - COLLAPSIBLE SECTIONS -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-code"></i>
        </div>
        <h2 class="oop-section-title">Structure Guide</h2>
    </div>
    
    <p class="section-intro">Click each section to expand. Complete them in order — each builds on the previous.</p>
    
    <!-- 1. Class Definition -->
    <details class="skeleton-block" open>
        <summary class="skeleton-summary">
            <span class="skeleton-step">1</span>
            <span class="skeleton-title">Class Definition</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">CLASS Player:</div>
            <div class="skeleton-desc">
                Define the class. Everything inside belongs to this blueprint.
            </div>
        </div>
    </details>
    
    <!-- 2. Constructor -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">2</span>
            <span class="skeleton-title">Constructor</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">CONSTRUCTOR(name):</div>
            <div class="skeleton-desc">
                <strong>Receives:</strong> the player's name<br><br>
                <strong>Must do:</strong>
                <ul>
                    <li>Store the name in this object</li>
                    <li>Call get_starting_stats to get initial values</li>
                    <li>Store health, max_health, armour, accuracy as attributes</li>
                </ul>
            </div>
        </div>
    </details>
    
    <!-- 3. get_starting_stats -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">3</span>
            <span class="skeleton-title">get_starting_stats</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD get_starting_stats() → dictionary:</div>
            <div class="skeleton-desc">
                <strong>Returns:</strong> a dictionary with four keys<br><br>
                <strong>Include:</strong>
                <ul>
                    <li>health (e.g. 100)</li>
                    <li>max_health (same as health)</li>
                    <li>armour (e.g. 2)</li>
                    <li>accuracy (e.g. 85)</li>
                </ul>
            </div>
        </div>
    </details>
    
    <!-- 4. get_status -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">4</span>
            <span class="skeleton-title">get_status</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD get_status() → string:</div>
            <div class="skeleton-desc">
                <strong>Returns:</strong> a description of the player<br><br>
                <strong>Format:</strong> "Alice: 85/100 HP"<br>
                Include the name and current/max health.
            </div>
        </div>
    </details>
    
    <!-- 5. take_damage -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">5</span>
            <span class="skeleton-title">take_damage</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD take_damage(amount):</div>
            <div class="skeleton-desc">
                <strong>Receives:</strong> amount of damage<br><br>
                <strong>Must do:</strong>
                <ul>
                    <li>Subtract amount from health</li>
                    <li>Ensure health never goes below 0</li>
                </ul>
                <em>Hint: If the result would be negative, set it to 0 instead.</em>
            </div>
        </div>
    </details>
    
    <!-- 6. heal -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">6</span>
            <span class="skeleton-title">heal</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD heal(amount):</div>
            <div class="skeleton-desc">
                <strong>Receives:</strong> amount to heal<br><br>
                <strong>Must do:</strong>
                <ul>
                    <li>Add amount to health</li>
                    <li>Ensure health never exceeds max_health</li>
                </ul>
                <em>Hint: If the result would exceed maximum, cap it there.</em>
            </div>
        </div>
    </details>
</section>

