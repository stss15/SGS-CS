<!-- CODE SKELETON - COLLAPSIBLE SECTIONS -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-code"></i>
        </div>
        <h2 class="oop-section-title">Structure Guide</h2>
    </div>
    
    <p class="section-intro">Click each section to expand. Complete them in order — each builds on the previous.</p>
    
    <!-- 1. Class Definition -->
    <details class="skeleton-block" open>
        <summary class="skeleton-summary">
            <span class="skeleton-step">1</span>
            <span class="skeleton-title">Class Definition</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">CLASS Player:</div>
            <div class="skeleton-desc">
                Define the class. Everything inside belongs to this blueprint.
            </div>
        </div>
    </details>
    
    <!-- 2. Constructor -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">2</span>
            <span class="skeleton-title">Constructor</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">CONSTRUCTOR(name):</div>
            <div class="skeleton-desc">
                <strong>Receives:</strong> the player's name<br><br>
                <strong>Must do:</strong>
                <ul>
                    <li>Store the name as an attribute</li>
                    <li>Set health to 100</li>
                    <li>Set max_health to 100</li>
                    <li>Set armour to 2</li>
                    <li>Set accuracy to 85</li>
                </ul>
                <em>Hint: Use self.attribute_name = value for each attribute.</em>
            </div>
        </div>
    </details>
    
    <!-- 3. get_status -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">3</span>
            <span class="skeleton-title">get_status</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD get_status() → string:</div>
            <div class="skeleton-desc">
                <strong>Returns:</strong> a description of the player<br><br>
                <strong>Format:</strong> "Alice: 85/100 HP"<br>
                Include the name and current/max health.
            </div>
        </div>
    </details>
    
    <!-- 4. take_damage -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">4</span>
            <span class="skeleton-title">take_damage</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD take_damage(amount):</div>
            <div class="skeleton-desc">
                <strong>Receives:</strong> amount of damage<br><br>
                <strong>Must do:</strong>
                <ul>
                    <li>Subtract amount from health</li>
                    <li>Ensure health never goes below 0</li>
                </ul>
                <em>Hint: If the result would be negative, set it to 0 instead.</em>
            </div>
        </div>
    </details>
    
    <!-- 5. heal -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">5</span>
            <span class="skeleton-title">heal</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD heal(amount):</div>
            <div class="skeleton-desc">
                <strong>Receives:</strong> amount to heal<br><br>
                <strong>Must do:</strong>
                <ul>
                    <li>Add amount to health</li>
                    <li>Ensure health never exceeds max_health</li>
                </ul>
                <em>Hint: If the result would exceed maximum, cap it there.</em>
            </div>
        </div>
    </details>
</section>

