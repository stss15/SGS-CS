            <tbody>
                <tr>
                    <td><span class="keyword-term">Constructor</span></td>
                    <td>A special method automatically called when creating a new object</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Instance Attribute</span></td>
                    <td>A variable that belongs to a specific object instance</td>
                </tr>
                <tr>
                    <td><span class="keyword-term">Method</span></td>
                    <td>A function that belongs to a class and operates on object data</td>
