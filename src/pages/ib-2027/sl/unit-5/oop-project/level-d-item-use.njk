<!-- STRUCTURE GUIDE -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-code"></i>
        </div>
        <h2 class="oop-section-title">Structure Guide</h2>
    </div>
    
    <p class="section-intro">Click each section to expand. Add new methods to your existing classes.</p>
    
    <!-- 1. consume in Inventory -->
    <details class="skeleton-block" open>
        <summary class="skeleton-summary">
            <span class="skeleton-step">1</span>
            <span class="skeleton-title">consume (in Inventory)</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-line code">METHOD consume(item_id) → boolean:</div>
            <div class="skeleton-desc">
                <strong>Purpose:</strong> Remove a consumable item from inventory<br><br>
                Works the same as <code>remove()</code> — the engine decides what's consumable.
            </div>
        </div>
    </details>
    
    <!-- 2. use_item -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">2</span>
            <span class="skeleton-title">use_item(item_id, target) → str</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-desc">
                <strong>Called when:</strong> Player types <code>use keycard</code> or <code>use med_patch self</code><br><br>
                <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                    <thead>
                        <tr style="background: #f1f3f5; border-bottom: 2px solid #dee2e6;">
                            <th style="padding: 0.5rem; text-align: left;">Check / Item</th>
                            <th style="padding: 0.5rem; text-align: left;">Action</th>
                            <th style="padding: 0.5rem; text-align: left;">Return Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="border-bottom: 1px solid #dee2e6;">
                            <td style="padding: 0.5rem;">Item not in inventory</td>
                            <td style="padding: 0.5rem;">—</td>
                            <td style="padding: 0.5rem;"><code>"You don't have '{item_id}'."</code></td>
                        </tr>
                        <tr style="border-bottom: 1px solid #dee2e6;">
                            <td style="padding: 0.5rem;"><code>med_patch</code> + <code>self</code></td>
                            <td style="padding: 0.5rem;">heal(20), consume it</td>
                            <td style="padding: 0.5rem;"><code>"You apply the med patch. +20 HP."</code></td>
                        </tr>
                        <tr>
                            <td style="padding: 0.5rem;">Any other item</td>
                            <td style="padding: 0.5rem;">—</td>
                            <td style="padding: 0.5rem;"><code>"You use the {item_id} on the {target}."</code></td>
                        </tr>
                    </tbody>
                </table>
                <p style="margin-top: 1rem; color: #6c757d; font-size: 0.85rem;">
                    <strong>Method integration:</strong> use_item calls <code>self.heal()</code> and <code>self.inventory.consume()</code> — methods working together.
                </p>
            </div>
        </div>
    </details>
</section>

