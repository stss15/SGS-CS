<!-- STRUCTURE GUIDE -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-code"></i>
        </div>
        <h2 class="oop-section-title">Structure Guide</h2>
    </div>
    
    <p class="section-intro">Implement these functions in <code>student/log_search.py</code>.</p>
    
    <!-- search_logs -->
    <details class="skeleton-block" open>
        <summary class="skeleton-summary">
            <span class="skeleton-step">1</span>
            <span class="skeleton-title">search_logs(logs, author)</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-desc">
                Create a new list. Loop through <code>logs</code>. If <code>log['author'] == author</code>, append to the new list. Return the new list.
                <div class="skeleton-line code" style="margin-top: 0.5rem;">matches = []</div>
                <div class="skeleton-line code">FOR log IN logs:</div>
                <div class="skeleton-line code">    IF log['author'] == author: matches.append(log)</div>
                <div class="skeleton-line code">RETURN matches</div>
            </div>
        </div>
    </details>
    
    <!-- sort_logs -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">2</span>
            <span class="skeleton-title">sort_logs(logs, key, descending)</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-desc">
                Use the built-in <code>sorted()</code> function.
                <ul>
                    <li><strong>Key:</strong> Use a lambda to get the value from the dict: <code>lambda x: x[key]</code></li>
                    <li><strong>Reverse:</strong> Pass the <code>descending</code> boolean to the <code>reverse</code> parameter.</li>
                </ul>
                <div class="skeleton-line code" style="margin-top: 0.5rem;">RETURN sorted(logs, key=lambda x: x[key], reverse=descending)</div>
            </div>
        </div>
    </details>

    <!-- validate_code -->
    <details class="skeleton-block">
        <summary class="skeleton-summary">
            <span class="skeleton-step">3</span>
            <span class="skeleton-title">validate_code(code, used_codes)</span>
            <i class="fa-solid fa-chevron-down skeleton-chevron"></i>
        </summary>
        <div class="skeleton-content">
            <div class="skeleton-desc">
                Check if <code>code</code> is in the <code>used_codes</code> set.
                <ul>
                    <li>If it IS in the set: Return <code>False</code> (already used)</li>
                    <li>If it is NOT in the set: Return <code>True</code> (valid)</li>
                </ul>
            </div>
        </div>
    </details>
</section>

