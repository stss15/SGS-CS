<!-- CONCEPT PRIMER -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-lightbulb"></i>
        </div>
        <h2 class="oop-section-title">Concept: Object Relationships</h2>
    </div>
    
    <div class="class-overview">
        <p class="class-overview-desc">
            Objects relate to each other in two main ways:
        </p>
        <ul style="margin-top: 0.5rem; margin-bottom: 0;">
            <li><strong>Aggregation (Has-A):</strong> A weak relationship. The objects can exist independently. (e.g., A University has Students. If the Uni closes, Students still exist). Symbol: <strong>Empty Diamond</strong>.</li>
            <li><strong>Composition (Part-Of):</strong> A strong relationship. The part belongs to the whole. (e.g., A University is composed of Departments. If the Uni closes, the Departments cease to exist). Symbol: <strong>Filled Diamond</strong>.</li>
        </ul>
    </div>
</section>

<!-- UML DIAGRAM -->
<section class="oop-section">
    <div class="oop-section-header">
        <div class="oop-section-icon">
            <i class="fa-solid fa-diagram-project"></i>
        </div>
        <h2 class="oop-section-title">Class Structure</h2>
    </div>
    
    <div class="uml-svg-container">
        <svg viewBox="0 0 600 250" class="uml-svg" preserveAspectRatio="xMidYMid meet">
            
            <!-- CLASS: Department -->
            <rect x="10" y="50" width="140" height="60" class="uml-svg-class" rx="4"/>
            <text x="80" y="75" class="uml-svg-text title">Department</text>
            <text x="20" y="95" class="uml-svg-text attribute">- name: str</text>
            
            <!-- CLASS: University -->
            <rect x="230" y="30" width="160" height="100" class="uml-svg-class" rx="4"/>
            <text x="310" y="55" class="uml-svg-text title">University</text>
            <text x="240" y="80" class="uml-svg-text attribute">- name: str</text>
            <text x="240" y="95" class="uml-svg-text attribute">- depts: List</text>
            <text x="240" y="110" class="uml-svg-text attribute">- students: List</text>
            
            <!-- CLASS: Student -->
            <rect x="450" y="50" width="140" height="60" class="uml-svg-class" rx="4"/>
            <text x="520" y="75" class="uml-svg-text title">Student</text>
            <text x="460" y="95" class="uml-svg-text attribute">- name: str</text>

            <!-- CONNECTOR: University <>-- Department (Composition/Filled) -->
            <line x1="150" y1="80" x2="230" y2="80" stroke="#333" stroke-width="2" />
            <!-- Filled Diamond pointing to University -->
            <polygon points="230,80 215,85 200,80 215,75" fill="#333" stroke="#333" stroke-width="2" />
            <text x="180" y="70" class="uml-svg-text override" style="font-size:10px;">Composition</text>
            
            <!-- CONNECTOR: University o-- Student (Aggregation/Empty) -->
            <line x1="390" y1="80" x2="450" y2="80" stroke="#333" stroke-width="2" />
            <!-- Hollow Diamond pointing to University -->
            <polygon points="390,80 405,85 420,80 405,75" fill="white" stroke="#333" stroke-width="2" />
            <text x="410" y="70" class="uml-svg-text override" style="font-size:10px;">Aggregation</text>

        </svg>
        <div style="text-align: center; font-size: 0.85rem; color: #666; margin-top: 0.5rem;">
            Filled Diamond = Composition (Strong) &nbsp;&nbsp;|&nbsp;&nbsp; Empty Diamond = Aggregation (Weak)
        </div>
    </div>
</section>

