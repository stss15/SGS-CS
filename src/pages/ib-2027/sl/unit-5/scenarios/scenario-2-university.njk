            <line x1="150" y1="80" x2="230" y2="80" stroke="#333" stroke-width="2" />
            <text x="190" y="70" class="uml-svg-text override">1</text>
            
            <!-- CONNECTOR: Course -> Student (Aggregation) -->
            <line x1="390" y1="80" x2="450" y2="80" stroke="#333" stroke-width="2" />
            <polygon points="390,80 405,75 420,80 405,85" fill="white" stroke="#333" stroke-width="2" />
