---
layout: layouts/base.njk
title: "IB Computer Science 2027 - SGS Computer Science"
description: "IB Computer Science curriculum for first assessment 2027. Choose your year group, then pick a unit."
activeSection: "ib"
breadcrumbs:
  - { label: "Home", href: "index.html" }
  - { label: "IB 2027" }
hero:
  title: IB Computer Science 2027
  subtitle: Choose your year group, then pick a unit.
extraStyles:
  - "css/resource-style.css"
---

<div class="ib-level-tabs">
    <div class="tab-bar" role="tablist" aria-label="Year group">
        <button class="tab-btn active" role="tab" aria-selected="true" aria-controls="tab-y12" id="btn-y12">
            <i class="fa-solid fa-calendar" aria-hidden="true"></i> Year 12
        </button>
        <button class="tab-btn" role="tab" aria-selected="false" aria-controls="tab-y13" id="btn-y13">
            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i> Year 13
        </button>
    </div>

    <!-- Year 12 -->
    <div class="tab-panel" id="tab-y12" role="tabpanel" aria-labelledby="btn-y12">
        <div class="ib-year-group">
            <h2 class="ib-year-title">Standard Level <span class="ib-year-sub">Units 1–6</span></h2>
            <div class="resource-grid ib-unit-grid">
                {% for item in site.listings["ib-2027-sl"].sections[0].items %}
                <a href="sl/{{ item.href }}" class="resource-btn">
                    <span class="resource-number">{{ item.number }}</span>
                    <div class="resource-info">
                        <span class="resource-name">{{ item.name }}</span>
                        <span class="resource-type">SL Unit {{ item.number }}</span>
                    </div>
                    <i class="fa-solid fa-arrow-right resource-arrow" aria-hidden="true"></i>
                </a>
                {% endfor %}
            </div>
        </div>
        <div class="ib-year-group">
            <h2 class="ib-year-title">Higher Level <span class="ib-year-sub">Units 1–6</span></h2>
            <div class="resource-grid ib-unit-grid">
                {% for item in site.listings["ib-2027-hl"].sections[0].items %}
                <a href="hl/{{ item.href }}" class="resource-btn">
                    <span class="resource-number">{{ item.number }}</span>
                    <div class="resource-info">
                        <span class="resource-name">{{ item.name }}</span>
                        <span class="resource-type">HL Unit {{ item.number }}</span>
                    </div>
                    <i class="fa-solid fa-arrow-right resource-arrow" aria-hidden="true"></i>
                </a>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Year 13 -->
    <div class="tab-panel hidden" id="tab-y13" role="tabpanel" aria-labelledby="btn-y13">
        <div class="ib-year-group">
            <h2 class="ib-year-title">Standard Level <span class="ib-year-sub">Units 7–12</span></h2>
            <div class="resource-grid ib-unit-grid">
                {% for item in site.listings["ib-2027-sl"].sections[1].items %}
                <a href="sl/{{ item.href }}" class="resource-btn">
                    <span class="resource-number">{{ item.number }}</span>
                    <div class="resource-info">
                        <span class="resource-name">{{ item.name }}</span>
                        <span class="resource-type">SL Unit {{ item.number }}</span>
                    </div>
                    <i class="fa-solid fa-arrow-right resource-arrow" aria-hidden="true"></i>
                </a>
                {% endfor %}
            </div>
        </div>
        <div class="ib-year-group">
            <h2 class="ib-year-title">Higher Level <span class="ib-year-sub">Units 7–11</span></h2>
            <div class="resource-grid ib-unit-grid">
                {% for item in site.listings["ib-2027-hl"].sections[1].items %}
                <a href="hl/{{ item.href }}" class="resource-btn">
                    <span class="resource-number">{{ item.number }}</span>
                    <div class="resource-info">
                        <span class="resource-name">{{ item.name }}</span>
                        <span class="resource-type">HL Unit {{ item.number }}</span>
                    </div>
                    <i class="fa-solid fa-arrow-right resource-arrow" aria-hidden="true"></i>
                </a>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<style>
.ib-level-tabs { width: 100%; max-width: 900px; }
.tab-bar { display: flex; gap: 0.5rem; margin-bottom: 1.75rem; border-bottom: 2px solid var(--border-default); padding-bottom: 0; }
.tab-btn {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.65rem 1.4rem;
    border: 1px solid var(--border-default);
    border-bottom: none;
    background: var(--background-warm);
    color: var(--text-muted);
    font-family: var(--font-display); font-weight: 600; font-size: 0.95rem;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
    position: relative; bottom: -2px;
}
.tab-btn:hover { background: var(--card-bg); color: var(--primary-color); }
.tab-btn.active {
    background: var(--card-bg);
    color: var(--primary-color);
    border-color: var(--border-default);
    border-bottom-color: var(--card-bg);
    box-shadow: 0 -2px 0 var(--accent-color);
}
.tab-panel { display: block; }
.tab-panel.hidden { display: none; }
.ib-year-group { margin-bottom: 2rem; }
.ib-year-title { font-size: 1.1rem; color: var(--primary-dark); margin-bottom: 0.85rem; display: flex; align-items: baseline; gap: 0.6rem; }
.ib-year-sub { font-size: 0.82rem; font-weight: 500; color: var(--text-muted); }
.ib-unit-grid { display: flex; flex-direction: column; gap: 0.6rem; }
</style>

<script>
(function () {
    var btns = document.querySelectorAll('.tab-btn');
    var panels = document.querySelectorAll('.tab-panel');
    btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var target = btn.getAttribute('aria-controls');
            btns.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
            panels.forEach(function (p) { p.classList.add('hidden'); });
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');
            document.getElementById(target).classList.remove('hidden');
        });
    });
}());
</script>
