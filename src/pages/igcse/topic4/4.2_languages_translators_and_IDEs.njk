                    </div>
                    <!-- Q3 Answer -->
                    <div class="fragment" data-fragment-index="5">
                        <div class="question-box" style="background: var(--sg-gold);">
                            <h1>Debugger</h1>
                            <p>It allows you to watch variables and pause execution.</p>
                        </div>
                    </div>
                </div>
            </section>

