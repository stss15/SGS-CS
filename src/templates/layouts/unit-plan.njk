{#
  Unit Plan Layout Template

  Required frontmatter:
  - title: Page title
  - unitNumber: e.g., 1
  - unitName: e.g., "Computational Thinking"
  - level: "SL" or "HL"

  Optional sections (pass as frontmatter):
  - introduction: { bigQuestion, overview, journey }
  - pillars: [{ icon, name, description }]
  - concepts: [{ icon, title, content | safe }]
  - terminology: [{ term, definition }]
  - misconceptions: [{ mistake, correction }]
  - viewSlidesButtons: [{ href, label }]
  - thinkDeeper: { question, context }
  - syllabusPoints: [{ code, topic }]
  - applications: ["item1", "item2"]
#}

{% extends "layouts/base.njk" %}

{% block extra_head %}
<link rel="stylesheet" href="/css/unit-plan.css">
{% endblock %}

{% block content %}
<div class="textbook-container">

    <!-- Chapter Header -->
    <header class="chapter-header">
        <div class="chapter-number">Unit {{ unitNumber }} &bull; {{ level }}</div>
        <h1 class="chapter-title">{{ unitName }}</h1>
    </header>

    <!-- Two-column layout -->
    <div class="textbook-grid">

        <!-- Main Content -->
        <div class="unit-plan-main">

            <!-- Introduction -->
            {% if introduction %}
            <details class="section-accordion" open>
                <summary class="section-header">
                    <div class="section-icon"><i class="fa-solid fa-compass"></i></div>
                    <h2>Introduction</h2>
                    <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                </summary>
                <div class="section-body">
                    {% if introduction.bigQuestion %}
                    <p><strong>{{ introduction.bigQuestion }}</strong></p>
                    {% endif %}
                    {% if introduction.overview %}
                    <p>{{ introduction.overview | safe }}</p>
                    {% endif %}
                    {% if introduction.journey %}
                    <p>{{ introduction.journey | safe }}</p>
                    {% endif %}
                </div>
            </details>
            {% endif %}

            <!-- Core Concepts (dynamic sections) -->
            {% if concepts %}
                {% for concept in concepts %}
                <details class="section-accordion">
                    <summary class="section-header">
                        <div class="section-icon"><i class="fa-solid {{ concept.icon | default('fa-lightbulb') }}"></i></div>
                        <h2>{{ concept.title }}</h2>
                        <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                    </summary>
                    <div class="section-body">
                        {{ concept.content | safe }}
                    </div>
                </details>
                {% endfor %}
            {% endif %}

            <!-- Key Terminology -->
            {% if terminology %}
            <details class="section-accordion">
                <summary class="section-header">
                    <div class="section-icon"><i class="fa-solid fa-book"></i></div>
                    <h2>Key Terminology</h2>
                    <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                </summary>
                <div class="section-body">
                    <table class="term-table">
                        <tr><th>Term</th><th>Definition</th></tr>
                        {% for item in terminology %}
                        <tr><td class="term-name">{{ item.term }}</td><td>{{ item.definition }}</td></tr>
                        {% endfor %}
                    </table>
                </div>
            </details>
            {% endif %}

            <!-- Common Misconceptions -->
            {% if misconceptions %}
            <details class="section-accordion">
                <summary class="section-header">
                    <div class="section-icon section-icon--warning"><i class="fa-solid fa-triangle-exclamation"></i></div>
                    <h2>Common Misconceptions</h2>
                    <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                </summary>
                <div class="section-body">
                    {% for item in misconceptions %}
                    <div class="warning-box">
                        <h4><i class="fa-solid fa-times-circle"></i> {{ item.mistake }}</h4>
                        <p>{{ item.correction }}</p>
                    </div>
                    {% endfor %}
                </div>
            </details>
            {% endif %}

            <!-- Slide Decks -->
            {% if viewSlidesButtons %}
            <details class="section-accordion" open>
                <summary class="section-header">
                    <div class="section-icon section-icon--success"><i class="fa-solid fa-presentation-screen"></i></div>
                    <h2>Content Slides</h2>
                    <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                </summary>
                <div class="section-body">
                    <div class="slides-grid">
                        {% for btn in viewSlidesButtons %}
                        <a href="{{ btn.href }}" target="_blank" rel="noopener noreferrer" class="slide-btn">
                            <i class="fa-solid fa-file-powerpoint icon-ppt"></i>
                            <span>{{ btn.label }}</span>
                        </a>
                        {% endfor %}
                    </div>
                </div>
            </details>
            {% endif %}

        </div>

        <!-- Right Sidebar -->
        <aside class="unit-plan-sidebar">

            <!-- Syllabus Coverage -->
            <div class="sidebar-card">
                <h3>Syllabus Coverage</h3>
                {% if syllabusPoints %}
                <ul class="syllabus-list">
                    {% for item in syllabusPoints %}
                    <li><span class="syllabus-code">{{ item.code }}</span> {{ item.topic }}</li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="sidebar-empty-note">Syllabus points to be added.</p>
                {% endif %}
            </div>

            <!-- Applications -->
            {% if applications %}
            <div class="sidebar-card">
                <h3>Real-World Uses</h3>
                <ul class="applications-list">
                    {% for app in applications %}
                    <li>{{ app }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <!-- Think Deeper -->
            {% if thinkDeeper %}
            <div class="sidebar-card sidebar-card--think-deeper">
                <h3>Think Deeper</h3>
                <p class="think-deeper-text"><em>"{{ thinkDeeper.question }}"</em> {{ thinkDeeper.context }}</p>
            </div>
            {% endif %}

        </aside>

    </div>

    <!-- Back link -->
    <a href="index.html" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> Back to Unit {{ unitNumber }}
    </a>

</div>
{% endblock %}
