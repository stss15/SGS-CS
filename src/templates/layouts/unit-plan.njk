{#
  Unit Plan Layout Template
  
  This template provides a consistent structure for all IB unit plan pages.
  Individual unit pages pass their data through frontmatter and this template renders it.
  
  Required frontmatter:
  - title: Page title
  - unitNumber: e.g., 1
  - unitName: e.g., "Computational Thinking"  
  - level: "SL" or "HL"
  
  Optional sections (pass as frontmatter):
  - introduction: { bigQuestion, overview, journey }
  - pillars: [{ icon, name, description }]
  - concepts: [{ title, content | safe }]
  - terminology: [{ term, definition }]
  - misconceptions: [{ mistake, correction }]
  - thinkDeeper: { question, context }
  - syllabusPoints: [{ code, topic }]
  - applications: ["item1", "item2"]
#}

{% extends "layouts/base.njk" %}

{% block content %}
<style>
    /* Wider textbook layout - force full width */
    .textbook-container {
        max-width: 1100px;
        width: 100%;
        margin: 0 auto;
        padding: 2rem;
        box-sizing: border-box;
    }
    
    /* Chapter header */
    .chapter-header {
        text-align: center;
        padding: 3rem 2rem;
        background: linear-gradient(135deg, #0E214B 0%, #1a3a6b 100%);
        color: white;
        border-radius: 16px;
        margin-bottom: 2rem;
    }
    .chapter-number {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 3px;
        opacity: 0.8;
        margin-bottom: 0.5rem;
    }
    .chapter-title {
        font-size: 2.75rem;
        font-weight: 800;
        margin-bottom: 0;
    }
    
    /* Two-column layout - fixed widths */
    .textbook-grid {
        display: grid;
        grid-template-columns: calc(100% - 320px - 2rem) 320px;
        gap: 2rem;
        align-items: start;
    }
    @media (max-width: 900px) {
        .textbook-grid { grid-template-columns: 1fr; }
    }
    
    /* Main content area */
    .main-content {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        overflow: hidden;
        width: 100%;
        box-sizing: border-box;
    }
    
    /* Collapsible sections */
    .section-accordion {
        border-bottom: 1px solid #e9ecef;
        display: block;
        width: 100%;
    }
    .section-accordion:last-child {
        border-bottom: none;
    }
    .section-accordion > summary {
        list-style: none;
    }
    .section-accordion > summary::-webkit-details-marker {
        display: none;
    }
    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        cursor: pointer;
        background: #f8f9fa;
        transition: background 0.2s;
        width: 100%;
        box-sizing: border-box;
    }
    .section-header:hover {
        background: #e9ecef;
    }
    .section-header h2 {
        font-size: 1.1rem;
        font-weight: 600;
        color: #0E214B;
        margin: 0;
        flex: 1;
    }
    .section-icon {
        width: 36px;
        height: 36px;
        background: #0E214B;
        color: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .toggle-arrow {
        color: #999;
        transition: transform 0.3s;
    }
    details[open] .toggle-arrow {
        transform: rotate(180deg);
    }
    
    /* Section body content */
    .section-body {
        padding: 1.5rem;
        line-height: 1.8;
        color: #333;
        overflow-x: auto;
    }
    .section-body p {
        margin-bottom: 1rem;
    }
    .section-body ul {
        margin-left: 1.5rem;
    }
    
    /* Sidebar */
    .sidebar {
        position: sticky;
        top: 100px;
    }
    .sidebar-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .sidebar-card h3 {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #666;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #BE9A5E;
    }
    
    /* Syllabus list */
    .syllabus-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .syllabus-list li {
        padding: 0.5rem 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: 0.9rem;
    }
    .syllabus-list li:last-child {
        border-bottom: none;
    }
    .syllabus-code {
        font-weight: 700;
        color: #0E214B;
    }
    
    /* Term table */
    .term-table {
        width: 100%;
        border-collapse: collapse;
    }
    .term-table th {
        background: #0E214B;
        color: white;
        padding: 0.75rem 1rem;
        text-align: left;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .term-table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e9ecef;
        vertical-align: top;
    }
    .term-table tr:nth-child(even) {
        background: #f8f9fa;
    }
    .term-table .term-name {
        font-weight: 600;
        color: #0E214B;
        white-space: nowrap;
    }
    
    /* Pillar cards */
    .pillar-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin: 1rem 0;
    }
    @media (max-width: 600px) {
        .pillar-grid { grid-template-columns: 1fr; }
    }
    .pillar-card {
        background: linear-gradient(135deg, #f0f7ff 0%, #e8f0ff 100%);
        border-left: 4px solid #0E214B;
        border-radius: 8px;
        padding: 1.25rem;
    }
    .pillar-card h4 {
        color: #0E214B;
        margin: 0 0 0.5rem 0;
        font-size: 1rem;
    }
    .pillar-card p {
        margin: 0;
        font-size: 0.9rem;
        color: #555;
    }
    
    /* Warning box */
    .warning-box {
        background: linear-gradient(135deg, #fff3cd 0%, #ffe5a0 100%);
        border-left: 4px solid #ffc107;
        border-radius: 8px;
        padding: 1.25rem;
        margin: 1rem 0;
    }
    .warning-box h4 {
        color: #856404;
        margin: 0 0 0.5rem 0;
        font-size: 0.95rem;
    }
    .warning-box p {
        margin: 0;
        color: #664d03;
    }
    
    /* Placeholder content */
    .placeholder-content {
        background: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        padding: 2rem;
        text-align: center;
        color: #6c757d;
    }
    .placeholder-content i {
        font-size: 2rem;
        margin-bottom: 1rem;
        display: block;
    }
    
    /* Back link */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #0E214B;
        text-decoration: none;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        background: #f8f9fa;
        border-radius: 8px;
        transition: all 0.2s;
        margin-top: 2rem;
    }
    .back-link:hover {
        background: #0E214B;
        color: white;
    }
</style>

<div class="textbook-container">
    
    <!-- Chapter Header -->
    <header class="chapter-header">
        <div class="chapter-number">Unit {{ unitNumber }} • {{ level }}</div>
        <h1 class="chapter-title">{{ unitName }}</h1>
    </header>

    <!-- Two-column layout -->
    <div class="textbook-grid">
        
        <!-- Main Content -->
        <main class="main-content">
            
            <!-- Introduction -->
            <details class="section-accordion" open>
                <summary class="section-header">
                    <div class="section-icon"><i class="fa-solid fa-compass"></i></div>
                    <h2>Introduction</h2>
                    <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                </summary>
                <div class="section-body">
                    {% if introduction %}
                        {% if introduction.bigQuestion %}
                        <p><strong>{{ introduction.bigQuestion }}</strong></p>
                        {% endif %}
                        {% if introduction.overview %}
                        <p>{{ introduction.overview | safe }}</p>
                        {% endif %}
                        {% if introduction.journey %}
                        <p>{{ introduction.journey | safe }}</p>
                        {% endif %}
                    {% else %}
                        <div class="placeholder-content">
                            <i class="fa-solid fa-pen-to-square"></i>
                            <p>Introduction content coming soon.</p>
                        </div>
                    {% endif %}
                </div>
            </details>

            <!-- Core Concepts (dynamic sections) -->
            {% if concepts %}
                {% for concept in concepts %}
                <details class="section-accordion">
                    <summary class="section-header">
                        <div class="section-icon"><i class="fa-solid {{ concept.icon | default('fa-lightbulb') }}"></i></div>
                        <h2>{{ concept.title }}</h2>
                        <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                    </summary>
                    <div class="section-body">
                        {{ concept.content | safe }}
                    </div>
                </details>
                {% endfor %}
            {% else %}
                <details class="section-accordion">
                    <summary class="section-header">
                        <div class="section-icon"><i class="fa-solid fa-book-open"></i></div>
                        <h2>Core Concepts</h2>
                        <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                    </summary>
                    <div class="section-body">
                        <div class="placeholder-content">
                            <i class="fa-solid fa-pen-to-square"></i>
                            <p>Core concepts content coming soon.</p>
                        </div>
                    </div>
                </details>
            {% endif %}

            <!-- Key Terminology -->
            <details class="section-accordion">
                <summary class="section-header">
                    <div class="section-icon"><i class="fa-solid fa-book"></i></div>
                    <h2>Key Terminology</h2>
                    <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                </summary>
                <div class="section-body">
                    {% if terminology %}
                    <table class="term-table">
                        <tr><th style="width: 180px;">Term</th><th>Definition</th></tr>
                        {% for item in terminology %}
                        <tr><td class="term-name">{{ item.term }}</td><td>{{ item.definition }}</td></tr>
                        {% endfor %}
                    </table>
                    {% else %}
                        <div class="placeholder-content">
                            <i class="fa-solid fa-pen-to-square"></i>
                            <p>Terminology content coming soon.</p>
                        </div>
                    {% endif %}
                </div>
            </details>

            <!-- Common Misconceptions -->
            <details class="section-accordion">
                <summary class="section-header">
                    <div class="section-icon" style="background: #ffc107;"><i class="fa-solid fa-triangle-exclamation"></i></div>
                    <h2>Common Misconceptions</h2>
                    <i class="fa-solid fa-chevron-down toggle-arrow"></i>
                </summary>
                <div class="section-body">
                    {% if misconceptions %}
                        {% for item in misconceptions %}
                        <div class="warning-box">
                            <h4><i class="fa-solid fa-times-circle"></i> {{ item.mistake }}</h4>
                            <p>{{ item.correction }}</p>
                        </div>
                        {% endfor %}
                    {% else %}
                        <div class="placeholder-content">
                            <i class="fa-solid fa-pen-to-square"></i>
                            <p>Misconceptions content coming soon.</p>
                        </div>
                    {% endif %}
                </div>
            </details>

        </main>
        
        <!-- Sidebar -->
        <aside class="sidebar">
            
            <!-- Syllabus Coverage -->
            <div class="sidebar-card">
                <h3>Syllabus Coverage</h3>
                {% if syllabusPoints %}
                <ul class="syllabus-list">
                    {% for item in syllabusPoints %}
                    <li><span class="syllabus-code">{{ item.code }}</span> {{ item.topic }}</li>
                    {% endfor %}
                </ul>
                {% else %}
                <p style="color: #999; font-size: 0.9rem; margin: 0;">Syllabus points to be added.</p>
                {% endif %}
            </div>
            
            <!-- Applications -->
            {% if applications %}
            <div class="sidebar-card">
                <h3>Real-World Uses</h3>
                <ul style="padding-left: 1.25rem; margin: 0; font-size: 0.9rem; line-height: 1.8;">
                    {% for app in applications %}
                    <li>{{ app }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
            
            <!-- Think Deeper -->
            {% if thinkDeeper %}
            <div class="sidebar-card" style="background: linear-gradient(135deg, #f0f7ff 0%, #e8f0ff 100%);">
                <h3>Think Deeper</h3>
                <p style="font-size: 0.9rem; line-height: 1.6; margin: 0;"><em>"{{ thinkDeeper.question }}"</em> {{ thinkDeeper.context }}</p>
            </div>
            {% endif %}
            
        </aside>
        
    </div>
    
    <!-- Back link -->
    <a href="index.html" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> Back to Unit {{ unitNumber }}
    </a>

</div>
{% endblock %}
