<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}

    <!-- Reveal.js CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/reset.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/reveal.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/theme/white.min.css">

    <!-- Highlight.js -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/atom-one-dark.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/slide-deck.css">
    {% if extraStyles %}
        {% for style in extraStyles %}
            <link rel="stylesheet" href="{{ style if style.indexOf('http') == 0 or style.indexOf('//') == 0 else basePath + style }}">
        {% endfor %}
    {% endif %}
</head>

<body>
    <a href="/{{ backHref | default('index.html') }}" id="back-btn" title="Back" class="back-nav" aria-label="Go back">
        <i class="fa-solid fa-circle-arrow-left" aria-hidden="true"></i>
    </a>
    <img src="/images/Logo.png" id="sg-logo" alt="Logo"
        data-fallback-src="https://via.placeholder.com/80/003366/ffffff?text=LOGO">
    <div class="footer-text live-date" id="live-date-display"></div>
    {% if courseFooter %}<div class="footer-text course-footer">{{ courseFooter }}</div>{% endif %}

    <div class="reveal">
        <div class="slides">
            {% block content %}{{ content | safe }}{% endblock %}
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/reveal.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/plugin/highlight/highlight.min.js"></script>
    {% if deckOptions %}<script>window.__deckOptions = {{ deckOptions | json(2) }};</script>{% endif %}
    <script src="/js/slide-deck.js"></script>
    {% if deckScripts %}
        <script>
            {{ deckScripts | safe }}
        </script>
    {% endif %}
</body>

</html>
