<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Dependencies -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/reset.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/reveal.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/theme/white.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/atom-one-dark.min.css">

    <!-- UNIFIED THEME -->
    <link rel="stylesheet" href="{{ basePath }}css/ks3-deck.css">
</head>

<body>
    <!-- FIXED GLOBAL ELEMENTS -->
    <a href="{{ basePath }}{{ backHref | default('ks3/year7/unit2.html') }}" id="back-btn" aria-label="Go back"><i class="fa-solid fa-circle-arrow-left" aria-hidden="true"></i></a>
    <img src="{{ basePath }}images/Logo.png" id="sg-logo" alt="SGS Education logo"
        data-fallback-src="https://via.placeholder.com/80/003366/ffffff?text=LOGO">
    <div class="footer-text live-date" id="live-date-display"></div>
    <div class="footer-text course-footer">{{ courseFooter }}</div>

    <div class="reveal">
        <div class="slides">

            <!-- 1. TITLE SLIDE -->
            <section>
                <div class="title-container">
                    <div class="title-line-top"></div>
                    <div>
                        <h1 class="main-title">{{ lesson.title }}</h1>
                        <h3 class="sub-title">{{ lesson.subtitle }}</h3>
                    </div>
                    <div class="title-line-bottom"></div>
                </div>
            </section>

            <!-- 2. RECALL (VERTICAL STACK) -->
            {% if lesson.recall %}
            <section>
                <!-- 2.0: The Overview List -->
                <section>
                    <h3><i class="fa-solid fa-brain"></i> {{ lesson.recall.title }}</h3>
                    {% if lesson.recall.prompt %}
                    <div class="box-blue">
                        <p>{{ lesson.recall.prompt }}</p>
                    </div>
                    {% endif %}
                    <ol style="font-size: 1.2em; line-height: 1.6;">
                        {% for q in lesson.recall.questions %}
                        <li>{{ q.question }}</li>
                        {% endfor %}
                    </ol>
                    <p class="small-text" style="margin-top: 30px; color: #666;">
                        <i class="fa-solid fa-arrow-down"></i> Press Down to check answers
                    </p>
                </section>

                <!-- Deep Dives -->
                {% for q in lesson.recall.questions %}
                <section>
                    <h3>Question {{ loop.index }}</h3>
                    <div class="question-box">{{ q.question }}</div>
                    <div class="fragment box-blue">
                        <p><strong>Answer:</strong></p>
                        <p>{{ q.answer }}</p>
                    </div>
                </section>
                {% endfor %}
            </section>
            {% endif %}

            <!-- 3. CONCEPTS & SKILLS -->
            {% if lesson.concept or lesson.skill %}
            <section>
                <h2>Concepts & Skills</h2>
                <div class="cols">
                    <div class="box-blue fragment fade-right">
                        <h4><i class="{{ lesson.concept.icon | default('fa-solid fa-database') }}"></i> {{ lesson.concept.title }}</h4>
                        <p>{{ lesson.concept.detail }}</p>
                    </div>
                    <div class="box fragment fade-left">
                        <h4><i class="{{ lesson.skill.icon | default('fa-solid fa-tools') }}"></i> {{ lesson.skill.title }}</h4>
                        <p>{{ lesson.skill.detail }}</p>
                    </div>
                </div>
            </section>
            {% endif %}

            <!-- 4. OBJECTIVES -->
            {% if lesson.objectives %}
            <section>
                <h3><i class="fa-solid fa-bullseye"></i> Lesson Objectives</h3>
                <div class="box-blue">
                    <ul class="fa-ul" style="margin-left: 2.5em;">
                        {% for obj in lesson.objectives %}
                        <li class="fragment fade-up" style="margin-bottom: 20px;">
                            <span class="fa-li"><i class="fa-solid fa-check-circle gold"></i></span>
                            {{ obj }}
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </section>
            {% endif %}

            <!-- 5. THE HOOK / BIG QUESTION -->
            {% if lesson.hook %}
            <section data-background-color="#ffffff" style="position: relative;">
                <div style="text-align: left; margin-top: 40px;">
                    <h2 style="color: var(--sg-blue); margin-bottom: 20px;">{{ lesson.hook.title }}</h2>
                    <h3 style="color: var(--sg-gold); font-size: 2em; line-height: 1.3; margin-bottom: 40px;">
                        {{ lesson.hook.question }}
                    </h3>

                    <div class="box-blue" style="display: inline-block; padding: 20px 40px;">
                        <p style="margin: 0; font-size: 1.2em;">
                            <i class="fa-solid fa-comments"></i> <strong>Task:</strong> {{ lesson.hook.detail }}
                        </p>
                    </div>
                </div>
            </section>
            {% endif %}

            <!-- CONTENT INJECTED FROM PAGE -->
            {{ content | safe }}

            <!-- 8. MAIN TASK -->
            {% if lesson.mainTask %}
            <section>
                <h2><i class="fa-solid fa-pen-to-square"></i> {{ lesson.mainTask.title }}</h2>
                <div class="box-blue">
                    <p>{{ lesson.mainTask.overview }}</p>
                </div>
                {% if lesson.mainTask.link %}
                <div style="margin-top: 2rem;">
                    <a href="{{ lesson.mainTask.link }}" class="button-primary" style="display: inline-block; background: #007aff; color: white; padding: 15px 30px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 1.1em;">
                        <i class="fa-solid fa-arrow-right"></i> {{ lesson.mainTask.linkText | default("Launch Activity") }}
                    </a>
                </div>
                {% endif %}
            </section>
            {% endif %}

            <!-- 9. PLENARY -->
            {% if lesson.plenary %}
            <section>
                <!-- Overview Slide -->
                <section>
                    <h2><i class="fa-solid fa-check-double"></i> {{ lesson.plenary.title }}</h2>
                    <div class="box-blue">
                        <p>{{ lesson.plenary.prompt }}</p>
                    </div>
                    <ol style="font-size: 1.2em; line-height: 1.6; margin-top: 30px;">
                        {% for q in lesson.plenary.questions %}
                        <li>{{ q.question }}</li>
                        {% endfor %}
                    </ol>
                    <p class="small-text" style="margin-top: 30px; color: #666;">
                        <i class="fa-solid fa-arrow-down"></i> Press Down to reveal answers
                    </p>
                </section>
                
                <!-- Deep Dive Slides -->
                {% for q in lesson.plenary.questions %}
                <section>
                    <h3>Question {{ loop.index }}</h3>
                    <div class="question-box">{{ q.question }}</div>
                    <div class="fragment box-blue">
                        <p><strong>Answer: {{ q.answer }}</strong></p>
                        <hr style="border-color: rgba(255,255,255,0.3);">
                        <p>{{ q.reason }}</p>
                    </div>
                </section>
                {% endfor %}
            </section>
            {% endif %}

        </div>
    </div>

    <!-- Reveal.js Scripts -->
    <script src="{{ basePath }}js/ks3-deck-options.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/reveal.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/plugin/highlight/highlight.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/reveal.js/4.5.0/plugin/notes/notes.min.js"></script>
    <script src="{{ basePath }}js/slide-deck.js"></script>
    <script src="{{ basePath }}js/ks3-widgets.js"></script>
<!-- FLOATING TIMER WIDGET -->
    <div id="floating-timer" class="floating-timer">
        <button type="button" class="ft-toggle-btn" data-sgs-onclick="toggleTimerExpand()" aria-label="Open timer controls">
            <i class="fa-regular fa-clock" aria-hidden="true"></i>
        </button>
        <div class="ft-content">
            <div class="ft-display">
                <input type="text" id="ft-min" class="ft-input" value="00" maxlength="2">
                <span>:</span>
                <input type="text" id="ft-sec" class="ft-input" value="00" maxlength="2">
            </div>
            <div class="ft-controls">
                <button type="button" id="ft-toggle" class="ft-action-btn primary" data-sgs-onclick="toggleFloatingTimer()" aria-label="Start or pause timer">
                    <i class="fa-solid fa-play" aria-hidden="true"></i>
                </button>
                <button type="button" id="ft-reset" class="ft-action-btn secondary" data-sgs-onclick="resetFloatingTimer()" aria-label="Reset timer">
                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
</body>
</html>
