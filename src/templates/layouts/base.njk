<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/Logo.png">
    <link rel="apple-touch-icon" href="/images/Logo.png">

    <!-- Fonts - Outfit (display) + Source Sans 3 (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Source+Sans+3:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Styles -->
    <link rel="stylesheet" href="/css/style.css">
    {% if extraStyles %}
        {% for style in extraStyles %}
            {% if style.indexOf('http') == 0 or style.indexOf('//') == 0 %}
                <link rel="stylesheet" href="{{ style }}">
            {% else %}
                <link rel="stylesheet" href="/{{ style }}">
            {% endif %}
        {% endfor %}
    {% endif %}

    {% if headContent %}{{ headContent | safe }}{% endif %}
    {% block extra_head %}{% endblock %}
</head>

<body class="{{ bodyClass | default('') }}">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="main-header">
        <div class="header-primary">
            <div class="logo-container">
                <a href="/index.html">
                    <img src="/images/logo-mark.svg" alt="SGS Education logo" class="logo-img" width="40" height="40">
                </a>
                <a href="/index.html" class="site-title-link">
                    <span class="site-title">SGS Education</span>
                </a>
            </div>

            <nav class="main-nav main-nav-simple" aria-label="Main navigation">
                <a href="/ks3/year7/index.html" class="nav-link {% if activeSection == 'year7' %}active{% endif %}">Year 7</a>
                <a href="/ks3/year8/index.html" class="nav-link {% if activeSection == 'year8' %}active{% endif %}">Year 8</a>
                <a href="/ks3/year9/index.html" class="nav-link {% if activeSection == 'year9' %}active{% endif %}">Year 9</a>
                <a href="/igcse/index.html" class="nav-link {% if activeSection == 'igcse' %}active{% endif %}">IGCSE</a>
                <a href="/ib-2027/index.html" class="nav-link {% if activeSection == 'ib' %}active{% endif %}">IB</a>
            </nav>

            <button class="mobile-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>

            <div class="site-auth-slot" data-auth-slot aria-label="Account actions"></div>
        </div>
    </header>

    <div class="mobile-drawer" id="mobile-drawer" hidden>
        <div class="mobile-drawer__overlay" data-close-mobile></div>
        <nav class="mobile-drawer__panel" aria-label="Mobile navigation">
            <div class="mobile-drawer__header">
                <span class="mobile-drawer__brand">SGS Education</span>
                <button class="mobile-drawer__close" type="button" aria-label="Close menu" data-close-mobile>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <ul class="mobile-drawer__links">
                <li><a href="/ks3/year7/index.html" class="{% if activeSection == 'year7' %}active{% endif %}">Year 7</a></li>
                <li><a href="/ks3/year8/index.html" class="{% if activeSection == 'year8' %}active{% endif %}">Year 8</a></li>
                <li><a href="/ks3/year9/index.html" class="{% if activeSection == 'year9' %}active{% endif %}">Year 9</a></li>
                <li><a href="/igcse/index.html" class="{% if activeSection == 'igcse' %}active{% endif %}">IGCSE</a></li>
                <li><a href="/ib-2027/index.html" class="{% if activeSection == 'ib' %}active{% endif %}">IB</a></li>
            </ul>
        </nav>
    </div>

    <script>
    (function(){
        var btn=document.querySelector('.mobile-menu-toggle'),
            drawer=document.getElementById('mobile-drawer');
        if(!btn||!drawer) return;
        function open(){drawer.hidden=false;requestAnimationFrame(function(){drawer.classList.add('open');btn.setAttribute('aria-expanded','true');document.body.style.overflow='hidden'});}
        function close(){drawer.classList.remove('open');btn.setAttribute('aria-expanded','false');document.body.style.overflow='';drawer.addEventListener('transitionend',function(){if(!drawer.classList.contains('open'))drawer.hidden=true},{once:true});}
        btn.addEventListener('click',function(){drawer.hidden?open():close()});
        drawer.querySelectorAll('[data-close-mobile]').forEach(function(el){el.addEventListener('click',close)});
        document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!drawer.hidden)close()});
    })();
    </script>

    <div class="app-layout{% if sidebar %} has-sidebar{% endif %}">
        {% if sidebar %}
        <aside class="course-sidebar" aria-label="{{ sidebar.heading | default('Course navigation') }}">
            {% if sidebar.heading %}
            <div class="sidebar-header">
                <span class="sidebar-heading">{{ sidebar.heading }}</span>
            </div>
            {% endif %}
            {% for section in sidebar.sections %}
            <div class="sidebar-section">
                {% if section.label %}
                <h3 class="sidebar-section-label">{{ section.label }}</h3>
                {% endif %}
                <ul class="sidebar-links" role="list">
                    {% for link in section.links %}
                    <li>
                        <a href="{{ link.href }}" class="sidebar-link" data-section="{{ link.section }}">
                            {% if link.icon %}<i class="{{ link.icon }}" aria-hidden="true"></i>{% endif %}
                            {{ link.label }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endfor %}
        </aside>
        {% endif %}

        <main id="main-content" class="{{ mainClass | default('') }}">
            {% if breadcrumbs %}
            <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                <ol class="breadcrumb-list">
                    {% for crumb in breadcrumbs %}
                    <li class="breadcrumb-item {% if loop.last %}current{% endif %}">
                        {% if crumb.href and not loop.last %}
                        <a href="/{{ crumb.href }}">{{ crumb.label }}</a>
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        {% else %}
                        <span>{{ crumb.label }}</span>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ol>
            </nav>
            {% endif %}

            {% if hero %}
                <div class="hero-text">
                    <h1 class="hero-title">{{ hero.title }}</h1>
                    {% if hero.subtitle %}
                        <p class="hero-subtitle">{{ hero.subtitle }}</p>
                    {% endif %}
                </div>
            {% endif %}

            {% block content %}{{ content | safe }}{% endblock %}
        </main>
    </div>

    <footer>
        <p>&copy; {{ currentYear }} SGS Education &middot; SG Stewart. All rights reserved.</p>
    </footer>

    {% if scripts %}
        {% for script in scripts %}
            {% if script.indexOf('http') == 0 or script.indexOf('//') == 0 %}
                <script src="{{ script }}"></script>
            {% else %}
                <script src="/{{ script }}"></script>
            {% endif %}
        {% endfor %}
    {% endif %}
    {% if inlineScripts %}{{ inlineScripts | safe }}{% endif %}

    {# Feedback Modals #}
    <div class="feedback-modals" data-feedback-default-level="General">
        <div class="feedback-overlay" data-feedback-overlay></div>

        <div class="feedback-modal" id="bug-modal" role="dialog" aria-modal="true" aria-labelledby="bug-modal-title">
            <button class="modal-close" type="button" data-close-modal aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <p class="modal-kicker">Something broken?</p>
            <h2 id="bug-modal-title">Report a bug</h2>
            <p class="modal-lede">Tell us exactly where the issue appears so we can fix it quickly.</p>

            <form id="bug-form" class="feedback-form" data-form-type="bug">
                <label for="bug-level">Course area</label>
                <select id="bug-level" name="level" required>
                    <option value="">Select a course</option>
                    <option value="KS3">KS3</option>
                    <option value="IGCSE">IGCSE</option>
                    <option value="IB">IB</option>
                    <option value="General">General</option>
                </select>

                <label for="bug-category">Resource type</label>
                <select id="bug-category" name="category" required>
                    <option value="">Choose a resource type</option>
                    <option value="Slide deck">Slide deck</option>
                    <option value="Game">Game</option>
                    <option value="Image">Image</option>
                    <option value="Simulation">Simulation</option>
                    <option value="Misc">Misc</option>
                </select>

                <label for="bug-title">Title (be specific)</label>
                <input id="bug-title" name="title" type="text" placeholder="Topic 1.1 slide deck — slide 9 video freezes…" autocomplete="off" required>

                <label for="bug-details">What happened?</label>
                <textarea id="bug-details" name="details" rows="4" placeholder="Describe the issue and where it shows up…" autocomplete="off" required></textarea>
                <p class="form-note">Give the topic, resource type, and slide/page number to avoid vague reports.</p>

                <button type="submit" class="submit-btn">Submit bug report</button>
                <p class="form-feedback" data-feedback-message="bug" aria-live="polite"></p>
            </form>
        </div>

        <div class="feedback-modal" id="feature-modal" role="dialog" aria-modal="true" aria-labelledby="feature-modal-title">
            <button class="modal-close" type="button" data-close-modal aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <p class="modal-kicker">Have an idea?</p>
            <h2 id="feature-modal-title">Request a feature</h2>
            <p class="modal-lede">Tell us which course you are in and what you would like added.</p>

            <form id="feature-form" class="feedback-form" data-form-type="feature">
                <label for="feature-level">Course area</label>
                <select id="feature-level" name="level" required>
                    <option value="">Select a course</option>
                    <option value="KS3">KS3</option>
                    <option value="IGCSE">IGCSE</option>
                    <option value="IB">IB</option>
                    <option value="General">General</option>
                </select>

                <label for="feature-details">What should we add?</label>
                <textarea id="feature-details" name="details" rows="5" placeholder="e.g. Add a revision game for Topic 2.1…" autocomplete="off" required></textarea>
                <p class="form-note">Share enough detail so teachers can understand the request.</p>

                <button type="submit" class="submit-btn">Submit feature request</button>
                <p class="form-feedback" data-feedback-message="feature" aria-live="polite"></p>
            </form>
        </div>
    </div>

    <script src="/js/feedback.js"></script>
</body>

</html>
