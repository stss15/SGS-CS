{% extends "layouts/base.njk" %}

{# Reader pages should not inherit the centered main layout. #}
{% set bodyClass = (bodyClass | default('')) ~ ' reader-body' %}
{% set mainClass = (mainClass | default('')) ~ ' reader-main' %}

{# Load reader-only fonts + stylesheet. #}
{% set headContent = (headContent | default('')) ~ '\n<link href=\"https://fonts.googleapis.com/css2?family=Lexend:wght@400;600;700&family=Literata:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"/css/reader.css\">' %}

{# Reader runtime (TOC, pagination, settings modal, read-aloud). #}
{% set inlineScripts = (inlineScripts | default('')) ~ '\n<script src=\"/js/reader.js\"></script>' %}

{% block content %}
  <div class="reader-shell" data-sgs-reader>
    <div class="sr-only" aria-live="polite" data-reader-announcer></div>
    <section class="reader-stage">
      <article class="reader-article">
        {% if reader %}
          <div class="reader-dochead">
            {% if reader.kicker %}<p class="reader-kicker">{{ reader.kicker }}</p>{% endif %}
            {% if reader.title %}<h1 class="reader-title">{{ reader.title }}</h1>{% endif %}
            {% if reader.subtitle %}<p class="reader-subtitle">{{ reader.subtitle }}</p>{% endif %}
          </div>
        {% endif %}

        <section class="reader-contents-block" data-reader-contents-block hidden>
          <div class="reader-contents-block__header">
            <p class="reader-contents-block__eyebrow">On this page</p>
            <h2 class="reader-contents-block__title">Contents</h2>
            <p class="reader-contents-block__summary">Use these links to move through the main sections of this chapter.</p>
          </div>
          <nav class="reader-toc reader-toc--inline" aria-label="On this page" data-reader-toc>
            <p class="reader-empty">Loading contents...</p>
          </nav>
        </section>

        <div class="reader-content">
          <div class="reader-prose" data-reader-content>
            {{ content | safe }}
          </div>
        </div>
      </article>
    </section>
  </div>

  <div class="reader-modal-overlay" data-reader-modal-overlay aria-hidden="true"></div>

  <div
    class="reader-modal reader-modal--definition"
    id="reader-def-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="reader-def-modal-title"
    aria-hidden="true"
  >
    <div class="reader-modal__header">
      <h2 class="reader-modal__title" id="reader-def-modal-title" data-reader-def-title>Definition</h2>
      <button class="reader-modal__close" type="button" data-reader-close-modal aria-label="Close">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <div class="reader-modal__body">
      <p style="margin:0;" data-reader-def-body></p>
    </div>
  </div>
{% endblock %}
