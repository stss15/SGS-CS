{% extends "layouts/base.njk" %}
{% import "../components.njk" as ui %}

{% set resolvedSlideDeckResources = slideDeckResources or (specification and specification.sections) %}

{# Filter out placeholder items that link to coming-soon.html #}
{% set realTextbook = textbookResources | withoutPlaceholders if textbookResources else [] %}
{% set realSlideDecks = resolvedSlideDeckResources | withoutPlaceholders if resolvedSlideDeckResources else [] %}
{% set realActivities = studentActivitiesResources | withoutPlaceholders if studentActivitiesResources else [] %}
{% set realAssessments = assessmentResources | withoutPlaceholders if assessmentResources else [] %}
{% set realHomework = homeworkResources | withoutPlaceholders if homeworkResources else [] %}
{% set realRevision = revisionResources | withoutPlaceholders if revisionResources else [] %}
{% set realIndependentTasks = independentTasks | withoutPlaceholders if independentTasks else [] %}
{% set realCards = cards | withoutPlaceholders if cards else [] %}
{% set realResources = resources | withoutPlaceholders if resources else [] %}
{% set realResourcesSecondary = resourcesSecondary | withoutPlaceholders if resourcesSecondary else [] %}

{% set hasStructuredSections = specification or (realTextbook and realTextbook.length) or (realSlideDecks and realSlideDecks.length) or (realActivities and realActivities.length) or (realAssessments and realAssessments.length) or (realHomework and realHomework.length) or (realIndependentTasks and realIndependentTasks.length) or (realRevision and realRevision.length) %}

{% macro resourceSection(title, items, sectionId='') %}
    {% if items and items.length %}
        <div class="resource-section" {% if sectionId %}id="{{ sectionId }}"{% endif %}>
            <div class="resource-header">
                <h2 class="resource-title">{{ title }}</h2>
                <div class="resource-line"></div>
            </div>
            {{ ui.resourceGrid(items, basePath) }}
        </div>
    {% endif %}
{% endmacro %}

{% block content %}
    {% if hasStructuredSections %}
    <div class="app-layout has-sidebar">
        <aside class="course-sidebar" aria-label="Topic navigation">
            <div class="sidebar-header">
                <span class="sidebar-heading">{{ hero.title if hero else 'In this topic' }}</span>
            </div>
            <ul class="sidebar-links" role="list">
                {% if specification %}
                <li><a href="#specification" class="sidebar-link" data-section="specification">
                    <i class="fa-solid fa-book-open" aria-hidden="true"></i> Overview
                </a></li>
                {% endif %}
                {% if realTextbook and realTextbook.length %}
                <li><a href="#textbook" class="sidebar-link" data-section="textbook">
                    <i class="fa-solid fa-book" aria-hidden="true"></i> Textbook
                </a></li>
                {% endif %}
                {% if realSlideDecks and realSlideDecks.length %}
                <li><a href="#slide-decks" class="sidebar-link" data-section="slide-decks">
                    <i class="fa-solid fa-presentation-screen" aria-hidden="true"></i> Slide Decks
                </a></li>
                {% endif %}
                {% if realActivities and realActivities.length %}
                <li><a href="#student-activities" class="sidebar-link" data-section="student-activities">
                    <i class="fa-solid fa-laptop-code" aria-hidden="true"></i> Activities
                </a></li>
                {% endif %}
                {% if realAssessments and realAssessments.length %}
                <li><a href="#assessments" class="sidebar-link" data-section="assessments">
                    <i class="fa-solid fa-file-pen" aria-hidden="true"></i> Assessments
                </a></li>
                {% endif %}
                {% if realIndependentTasks and realIndependentTasks.length %}
                <li><a href="#independent-tasks" class="sidebar-link" data-section="independent-tasks">
                    <i class="fa-solid fa-gamepad" aria-hidden="true"></i> Independent Tasks
                </a></li>
                {% endif %}
                {% if realRevision and realRevision.length %}
                <li><a href="#revision" class="sidebar-link" data-section="revision">
                    <i class="fa-solid fa-layer-group" aria-hidden="true"></i> Revision
                </a></li>
                {% endif %}
                {% if realResources and realResources.length %}
                <li class="sidebar-separator"></li>
                {% for item in realResources %}
                <li><a href="{{ item.href }}" class="sidebar-link sidebar-link--subtopic">
                    <span class="sidebar-link-number">{{ item.number }}</span> {{ item.name }}
                </a></li>
                {% endfor %}
                {% endif %}
                {% if realResourcesSecondary and realResourcesSecondary.length %}
                <li class="sidebar-separator"></li>
                {% for item in realResourcesSecondary %}
                {% if item.disabled %}
                <li><span class="sidebar-link sidebar-link--disabled">
                    {% if item.icon %}<i class="{{ item.icon }}" aria-hidden="true"></i> {% endif %}{{ item.name }}
                    <span class="sidebar-link-soon">Soon</span>
                </span></li>
                {% else %}
                <li><a href="{{ item.href }}" class="sidebar-link">
                    {% if item.icon %}<i class="{{ item.icon }}" aria-hidden="true"></i> {% endif %}{{ item.name }}
                </a></li>
                {% endif %}
                {% endfor %}
                {% endif %}
            </ul>
        </aside>
        <div class="arcade-sections">

        {% if specification %}
            <div class="unit-details igcse-specification" id="specification">
                <div class="content-box">
                    <h2 class="content-title"><i class="fa-solid fa-book-open"></i> Specification Overview</h2>
                    {% if specification.examCode %}
                        <p class="igcse-specification-meta">{{ specification.examCode }}</p>
                    {% endif %}
                    {% if specification.unitSummary %}
                        <p class="igcse-specification-intro">{{ specification.unitSummary }}</p>
                    {% elif specification.intro %}
                        <p class="igcse-specification-intro">{{ specification.intro }}</p>
                    {% endif %}
                </div>

                {% if (specification.objectives and specification.objectives.length) or (specification.outcomes and specification.outcomes.length) %}
                    <div class="grid-2-col igcse-spec-grid">
                        {% if specification.objectives and specification.objectives.length %}
                            <div class="content-box">
                                <h3 class="content-title"><i class="fa-solid fa-bullseye"></i> Unit Objectives</h3>
                                <ul class="custom-list igcse-spec-list">
                                    {% for objective in specification.objectives %}
                                        <li>{{ objective }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                        {% if specification.outcomes and specification.outcomes.length %}
                            <div class="content-box">
                                <h3 class="content-title"><i class="fa-solid fa-check-double"></i> Learning Outcomes</h3>
                                <ul class="custom-list igcse-spec-list">
                                    {% for outcome in specification.outcomes %}
                                        <li>{{ outcome }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {% if specification.subtopics and specification.subtopics.length and not specification.hideSubtopicPills %}
                    <div class="content-box igcse-spec-subtopics">
                        <h3 class="content-title"><i class="fa-solid fa-list-check"></i> Subtopic Focus</h3>
                        <div class="igcse-spec-pills">
                            {% for subtopic in specification.subtopics %}
                                <span class="igcse-spec-pill">{{ subtopic }}</span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {{ resourceSection('Textbook', realTextbook, 'textbook') }}
        {{ resourceSection('Slide Decks', realSlideDecks, 'slide-decks') }}
        {{ resourceSection('Student Activities', realActivities, 'student-activities') }}
        {{ resourceSection('Assessments', realAssessments, 'assessments') }}
        {{ resourceSection('Homework', realHomework, 'homework') }}

        {% if realIndependentTasks and realIndependentTasks.length %}
            <div class="resource-section" id="independent-tasks">
                <div class="resource-header">
                    <h2 class="resource-title">Independent Tasks</h2>
                    <div class="resource-line"></div>
                </div>
                {{ ui.independentTaskGrid(realIndependentTasks, basePath) }}
            </div>
        {% endif %}

        {{ resourceSection('Revision', realRevision, 'revision') }}

        {% if realRevision and realRevision.length %}
            <div class="carousel-overlay" id="carousel" role="dialog" aria-modal="true" aria-label="Revision image carousel">
                <div class="carousel-content">
                    <button class="carousel-nav" id="carousel-prev" aria-label="Previous image">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <img src="" alt="Revision visual" class="carousel-img" id="carousel-img">
                    <button class="carousel-nav" id="carousel-next" aria-label="Next image">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                    <button class="carousel-close" id="carousel-close" aria-label="Close carousel">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                    <div class="carousel-caption" id="carousel-caption"></div>
                </div>
            </div>
        {% endif %}

        </div>{# /arcade-sections #}
    </div>{# /app-layout has-sidebar #}
    <script src="/js/section-nav.js"></script>
    {% else %}
        {% if realCards and realCards.length %}{{ ui.cardGrid(realCards, basePath) }}{% endif %}

        {% if realResources and realResources.length %}
            <div class="resource-section">
                <div class="resource-header">
                    <h2 class="resource-title">{{ resourcesTitle | default('Teacher Resources') }}</h2>
                    <div class="resource-line"></div>
                </div>
                {{ ui.resourceGrid(realResources, basePath) }}
            </div>
        {% endif %}

        {% if realResourcesSecondary and realResourcesSecondary.length %}
            <div class="resource-section">
                <div class="resource-header">
                    <h2 class="resource-title">{{ resourcesSecondaryTitle | default('Teacher Resources') }}</h2>
                    <div class="resource-line"></div>
                </div>
                {{ ui.resourceGrid(realResourcesSecondary, basePath) }}
            </div>
        {% endif %}
    {% endif %}

    {{ content | safe }}
{% endblock %}
